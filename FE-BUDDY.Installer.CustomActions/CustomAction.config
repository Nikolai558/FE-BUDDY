<?xml version="1.0" encoding="utf-8" ?>
<!--
  Without this file, WiX's native SFXCA host (which loads the .NET Framework CLR inside
  msiexec.exe to run this managed custom action) defaults to binding CLR v2.0.50727
  (.NET Framework 2.0), which cannot load a net472-targeted assembly - it fails with
  System.BadImageFormatException ("built by a runtime newer than the currently loaded
  runtime"). This file must be named exactly "CustomAction.config" (not tied to the
  assembly name) and be present inside the packaged .CA.dll for SFXCA to find it.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
