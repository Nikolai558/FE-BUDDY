<UserControl x:Class="FeBuddyWPF.View.FaaDatToGeojsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FeBuddyWPF.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height=".25*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="FAA DAT To Geojson"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Medium"
                       FontFamily="Montserrat"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Row="0"/>

            <TextBlock Text="This process will convert your FAA .DAT RADAR Video Map (RVM) into a .geojson file."
                       Foreground="White"
                       FontSize="16"
                       FontFamily="Montserrat"
                       HorizontalAlignment="Center"
                       Margin="20,20,20,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Grid.Row="1"/>
        </Grid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Select Source File"
                       Foreground="White"
                       FontSize="16"
                       FontFamily="Montserrat"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="20,20,20,10"/>
            
            
        </StackPanel>
        
        
        
        
    </Grid>
</UserControl>
