<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Every public member must be documented (CS1591), and unused usings are reported (IDE0005). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled News fallback used offline / when the GitHub fetch fails (remediation plan 6.1). -->
    <EmbeddedResource Include="News.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FeBuddy.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeBuddy.Versioning\FeBuddy.Versioning.csproj" />
  </ItemGroup>

</Project>
