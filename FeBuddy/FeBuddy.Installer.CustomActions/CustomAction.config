<?xml version="1.0" encoding="utf-8" ?>
<!--
  Without this file, WiX's native SFXCA host (which loads the .NET Framework CLR inside
  msiexec.exe to run the managed custom action) binds CLR v2.0.50727 (.NET Framework 2.0), which
  cannot load a net472 assembly - it fails with BadImageFormatException ("built by a runtime
  newer than the currently loaded runtime"). The file must be named exactly
  "CustomAction.config" and be packed inside the .CA.dll for SFXCA to find it.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
