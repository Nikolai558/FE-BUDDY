<?xml version="1.0" encoding="utf-8" ?>
<!--
  Read by DTF's SfxCA stub when it loads the embedded UI. Without it the stub binds CLR 2.0, which
  cannot load a net472 assembly (see FeBuddy.Installer.CustomActions/CustomAction.config). The
  file must be named exactly "EmbeddedUI.config" and be packed inside the .CA.dll.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
