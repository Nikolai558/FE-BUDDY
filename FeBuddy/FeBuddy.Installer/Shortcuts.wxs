<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>

    <!--
      Icon="FE_BUDDY.ico" (Package.wxs's Icon): Windows Installer saves it to
      C:\Windows\Installer\{ProductCode}\ and points the shortcut there. The ProductCode is new
      every release, so Windows can't reuse the icon it cached for an earlier version. Taking the
      icon from FE-BUDDY.exe, whose path never changes, could leave 2.x's icon on the Desktop after
      an upgrade (#375).
    -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent"
           Condition="CREATE_STARTMENU_SHORTCUT">
        <Shortcut Id="StartMenuShortcut"
                  Name="FE-BUDDY"
                  Description="FE-BUDDY"
                  Target="[INSTALLFOLDER]FE-BUDDY.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="FE_BUDDY.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\FE-BUDDY"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />

      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent"
                 Condition="CREATE_DESKTOP_SHORTCUT">

        <Shortcut Id="DesktopShortcut"
                  Name="FE-BUDDY"
                  Description="FE-BUDDY"
                  Target="[INSTALLFOLDER]FE-BUDDY.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="FE_BUDDY.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\FE-BUDDY"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />

      </Component>
    </StandardDirectory>

  </Fragment>
</Wix>