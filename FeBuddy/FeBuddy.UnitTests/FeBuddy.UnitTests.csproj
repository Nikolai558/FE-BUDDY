<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- The map's logic in FeBuddy.Wpf is tested too (see Wpf/). Coverage is still measured on
         FeBuddy.Core and FeBuddy.Versioning only (coverlet.runsettings). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF leaves these two out of the implicit usings (WPF has its own Path); the Core tests use them everywhere. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeBuddy.Core\FeBuddy.Core.csproj" />
    <ProjectReference Include="..\FeBuddy.Wpf\FeBuddy.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A trimmed real NASR cycle (header + first 3 records of every CSV FE-Buddy reads). -->
    <None Include="Fixtures\Nasr\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- A made-up RADAR Video Map in the FAA .dat layout. Real FAA .dat files must never be
         committed: every fixture here is invented. -->
    <None Include="Fixtures\Dat\*.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
