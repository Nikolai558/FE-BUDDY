<!--
    FilterPicker  -  a field that looks like a text box but opens a popup of number
    toggles. Used for CRC "filters", which is a set of values from a fixed range
    rather than one value, so neither a text box (invites invalid input) nor a
    drop-down (single-select) fits it.
-->
<UserControl x:Class="FeBuddy.Wpf.Controls.FilterPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
             mc:Ignorable="d"
             x:Name="Self"
             d:DesignWidth="160" d:DesignHeight="34">

    <Grid>
        <!-- The closed state: reads as a field, behaves as a button. -->
        <ToggleButton x:Name="OpenToggle" MinHeight="34" Cursor="Hand"
                      HorizontalContentAlignment="Stretch"
                      ToolTip="{Binding SelectionSummary, ElementName=Self}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box"
                            Background="{DynamicResource Brush.Bg.Sunken}"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="11,7"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;"
                                       FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding DisplayText, ElementName=Self}"
                                       FontFamily="{DynamicResource Font.Body}" FontSize="13"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Same validation-failure look as the TextBox and ComboBox styles, read
                             from infra:FieldState.Error set on the FilterPicker itself. Declared
                             first so the open / focused accent still wins while it is in use. -->
                        <DataTrigger Binding="{Binding (infra:FieldState.HasError), ElementName=Self}" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                        </DataTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup IsOpen="{Binding IsChecked, ElementName=OpenToggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=OpenToggle}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               HorizontalOffset="0" VerticalOffset="4">
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="14"
                    MaxWidth="340">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                      Opacity="0.5" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding Prompt, ElementName=Self}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Options, ElementName=Self}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Toggle.Number}"
                                              Content="{Binding Number}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" Margin="0,10" />

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                                Content="Done" MinWidth="80" Click="OnDone" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Clear"
                                HorizontalAlignment="Left" Click="OnClear" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
