<UserControl x:Class="FeBuddy.Wpf.Controls.RoiEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignWidth="560" d:DesignHeight="460">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- map with rubber-band ROI -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Stroke.Strong}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True">
            <Grid>
                <ctl:MapCanvas x:Name="Map" RoiEnabled="True"
                               BaseLayer="{Binding BaseLayer, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                        Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Chip}"
                        Padding="8,4"
                        Visibility="{Binding CursorText, ElementName=Map, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding CursorText, ElementName=Map}" Style="{StaticResource Text.Caption}"
                               FontFamily="{StaticResource Font.Mono}" />
                </Border>
            </Grid>
        </Border>

        <!-- coordinates: scrolls if the host doesn't have room, rather than pushing the
             Cancel / Set ROI bar below (P4's "pinned header" pattern, applied to a footer). -->
        <!-- MaxHeight caps this row's own Auto-sizing so the Grid never lets it demand more
             than this - without a cap, an Auto row always sizes to its content's full desired
             height, so the ScrollViewer inside would never be given less room than it wants and
             would have nothing to scroll. -->
        <ScrollViewer Grid.Row="1" MaxHeight="210" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,6"
                           Text="Left-drag to draw a box, right-drag to pan, scroll to zoom. Right-click clears the box. Nothing is applied until you press Set ROI." />
                <!-- One field per row rather than two side-by-side pairs: the wide ROI picker
                     dialog has room for pairs, but this control is also embedded in the Map
                     page's 320px sidebar, where a two-pair-per-row layout ran the boxes off the
                     edge. A single column works at any width the control is hosted at. -->
                <!-- Corner read-out header. The copy button hands the user the four corners as
                     one line of text - the one copy affordance the Map / ROI screens keep
                     (remediation plan Phase 8). It disables itself until all four boxes parse. -->
                <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Corners" Margin="0,0,0,5">
                    <ctl:SectionHeader.Aside>
                        <ctl:CopyButton x:Name="CopyCornersButton"
                                        Style="{StaticResource Copy.Button}"
                                        ToolTip="Copy the four corner coordinates"
                                        IsEnabled="False" />
                    </ctl:SectionHeader.Aside>
                </ctl:SectionHeader>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="NE lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox x:Name="NeLatBox" Grid.Column="1" Margin="0,0,0,4" TextChanged="OnCoordTextChanged" />
                    <TextBlock Grid.Row="1" Text="NE lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox x:Name="NeLonBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" TextChanged="OnCoordTextChanged" />

                    <TextBlock Grid.Row="2" Text="SW lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox x:Name="SwLatBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" TextChanged="OnCoordTextChanged" />
                    <TextBlock Grid.Row="3" Text="SW lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBox x:Name="SwLonBox" Grid.Row="3" Grid.Column="1" TextChanged="OnCoordTextChanged" />
                </Grid>

                <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- pinned footer: always visible regardless of how little room the host gives this
             control, so Cancel / Set ROI can never end up scrolled or clipped out of reach. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Ghost}" Click="OnCancel" MinWidth="90" Margin="0,0,10,0" />
            <Button Content="Set ROI" Style="{StaticResource Button.Primary}" Click="OnSetRoi" MinWidth="120" />
        </StackPanel>
    </Grid>
</UserControl>
