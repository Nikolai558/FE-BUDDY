<!--
    StatTile  -  a single metric in a card: icon chip, big number, caption.
    Used in the dashboard's 2x2 grid (mirrors the reference's TRAFFIC / ATC
    ONLINE / EVENTS / BEST WEATHER tiles).

        <ctl:StatTile Glyph="{StaticResource Icon.Layers}"
                      Value="1,204" Caption="Airways in current cycle" />
-->
<UserControl x:Class="FeBuddy.Wpf.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Border Style="{StaticResource Card}" Padding="16">
        <StackPanel>
            <Border Width="30" Height="30" CornerRadius="9"
                    Background="{StaticResource Brush.Accent.Soft}"
                    HorizontalAlignment="Left">
                <TextBlock Text="{Binding Glyph, ElementName=Self}"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="14"
                           Foreground="{StaticResource Brush.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Style="{StaticResource Text.Metric}"
                       Margin="0,12,0,0"
                       Text="{Binding Value, ElementName=Self}" />

            <TextBlock Style="{StaticResource Text.Caption}"
                       Margin="0,3,0,0"
                       Text="{Binding Caption, ElementName=Self}" />
        </StackPanel>
    </Border>
</UserControl>
