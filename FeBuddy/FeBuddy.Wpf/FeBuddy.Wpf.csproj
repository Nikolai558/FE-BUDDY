<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FeBuddy.Wpf  -  UI shell, now being grown into the real app.
    ===========================================================================
    Started as a pure presentation layer (no FeBuddy.Core, no NuGet packages -
    MVVM helpers and converters are hand-rolled and live under /Infrastructure).
    Most screens are still sample-data-only prototypes.

    The Airways screen is the first real, wired screen: it references
    FeBuddy.Core directly and calls FeBuddy.Core.Services.Airways.AirwayService.Run.
    Everything else stays sample data until it is grown the same way.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FeBuddy.Wpf</RootNamespace>
    <AssemblyName>FeBuddy.Wpf</AssemblyName>
    <!-- 3.0.0 is this branch's target (see docs/Developers/FE-Buddy_3.0_*.md). The -dev suffix
         shows up in the file's Product version (Explorer > Properties > Details) but is stripped
         from AssemblyVersion/FileVersion by the SDK, so VersionCheck's numeric comparison against
         the public FE-BUDDY repo's releases (currently in the 2.9.x range) correctly resolves to
         "ahead of the latest release" rather than "update available" or "outdated". -->
    <Version>3.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Treat XAML/code warnings seriously in a greenfield project. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference geography for the Map screen (plain GeoJSON, not code). -->
    <Resource Include="Assets\us-states.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Airways screen is real and calls into the library; every other
         screen is still sample data and does not need this. -->
    <ProjectReference Include="..\FeBuddy.Core\FeBuddy.Core.csproj" />
  </ItemGroup>

</Project>
