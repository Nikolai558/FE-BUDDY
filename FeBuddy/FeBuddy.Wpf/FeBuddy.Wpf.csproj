<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FeBuddy.Wpf  -  the application's WPF front end.
    ===========================================================================
    No UI NuGet packages: the MVVM helpers, converters, toast store and the
    tabbed-service model are hand-rolled and live under /Infrastructure.

    Every screen is wired to FeBuddy.Core - there is no sample data anywhere in
    the app. The AIRAC Service screen runs through
    FeBuddy.Core.Application.Airac.AiracService, which dispatches to its
    sub-services (Airways, Airports, Departures, Arrivals, NAVAIDs).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FeBuddy.Wpf</RootNamespace>
    <!-- Every public member must be documented (CS1591), and unused usings are reported (IDE0005). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The XML docs (FE-BUDDY.xml, FeBuddy.Core.xml) are for developers' IntelliSense, not for the install folder. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- FE-BUDDY.exe, the same name as 2.x's: the installer's shortcuts, its "Launch FE-BUDDY"
         checkbox and every 2.x shortcut left behind by an in-place upgrade point at it. -->
    <AssemblyName>FE-BUDDY</AssemblyName>
    <ApplicationIcon>Assets\FE-BUDDY.ico</ApplicationIcon>
    <!-- THE version - the one place anyone bumps it (docs/Developers/VERSIONING.md). Strict SemVer:
         3.0.0, 3.0.0-alpha.1, 3.0.0-rc.2. It becomes the exe's Product version, which the app reads
         as its real version (AppVersion) and build.ps1 hands the installer as ProductSemVer. The
         numeric AssemblyVersion/FileVersion the SDK also derives from it drop the pre-release tag,
         so nothing compares with those. -dev marks an unreleased build: it outranks every 2.x
         release, so the version check reports "ahead of the latest release". -->
    <Version>3.0.0-alpha.1</Version>
    <!-- Keep the Product version exactly <Version> - no "+<commit hash>" build metadata. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Treat XAML/code warnings seriously in a greenfield project. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference geography for the Map screen (plain GeoJSON, not code). -->
    <Resource Include="Assets\us-states.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- All of the app's data, services and settings come from here. -->
    <ProjectReference Include="..\FeBuddy.Core\FeBuddy.Core.csproj" />
  </ItemGroup>

</Project>
