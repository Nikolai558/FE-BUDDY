<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FeBuddy.Wpf  -  the application's WPF front end.
    ===========================================================================
    No UI NuGet packages: the MVVM helpers, converters, toast store and the
    tabbed-service model are hand-rolled and live under /Infrastructure.

    Every screen is wired to FeBuddy.Core - there is no sample data anywhere in
    the app. The AIRAC Service screen runs through
    FeBuddy.Core.Services.Airac.AiracService, which dispatches to its
    sub-services (Airways today).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FeBuddy.Wpf</RootNamespace>
    <AssemblyName>FeBuddy.Wpf</AssemblyName>
    <!-- 3.0.0 is this branch's target (see docs/Developers/FE-Buddy_3.0_*.md). The -dev suffix
         shows up in the file's Product version (Explorer > Properties > Details) but is stripped
         from AssemblyVersion/FileVersion by the SDK, so VersionCheck's numeric comparison against
         the public FE-BUDDY repo's releases (currently in the 2.9.x range) correctly resolves to
         "ahead of the latest release" rather than "update available" or "outdated". -->
    <Version>3.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Treat XAML/code warnings seriously in a greenfield project. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference geography for the Map screen (plain GeoJSON, not code). -->
    <Resource Include="Assets\us-states.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- All of the app's data, services and settings come from here. -->
    <ProjectReference Include="..\FeBuddy.Core\FeBuddy.Core.csproj" />
  </ItemGroup>

</Project>
