<!--
    Controls.Inputs.xaml
    ===========================================================================
        Field        TextBox with rounded sunken fill + amber focus + placeholder
                     (set the placeholder via the control's Tag)
        Progress     thin rounded determinate ProgressBar (amber fill)
        ctl:Option   (implicit) a control with its explanation indented underneath

    Implicit styles (no x:Key) so a bare control never falls back to the OS look:
        TextBox      -> Field
        CheckBox     -> 16px sunken box, amber when checked
        RadioButton  -> 16px sunken disc, amber dot when checked
    A control that sets its own Style="{StaticResource ...}" (Nav.Item,
    LogChip) opts out of these automatically.

        ComboBox     -> Themed.ComboBox (dark sunken box + dark popup, kills the
                        system blue bar, and carries the drop-down wheel-scroll
                        behaviour). The keyed name still works for an explicit
                        reference; a bare ComboBox now picks it up on its own.
        DatePicker   -> Themed.DatePicker (Field look + calendar glyph; its drop-down
                        is Themed.Calendar.DropDown)
        Calendar     -> Themed.Calendar (dark panel, amber today ring, amber-soft
                        selected day; month and year views re-skinned too)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
                    xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors">

    <!-- ============================ OPTION ============================ -->
    <!-- One option row: the control, then its Description indented to sit under the control's
         label text. The one place that indent and the description's text style are set. -->
    <Style TargetType="ctl:Option">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:Option">
                    <StackPanel>
                        <ContentPresenter />
                        <TextBlock x:Name="Description" Margin="20,4,0,0"
                                   Style="{DynamicResource Text.Prose}"
                                   Text="{TemplateBinding Description}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= FIELD ============================ -->
    <!-- Placeholder text: set the TextBox's Tag, e.g. Tag="e.g. 44.512". -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Grid>
                            <TextBlock x:Name="Hint"
                                       Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       FontFamily="{DynamicResource Font.Body}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TEXTBOX (implicit) ====================== -->
    <!-- Every bare TextBox is Field; explicit Style="{StaticResource Field}"
         still works for the few call sites that want to be obvious about it. -->
    <!-- The implicit TextBox style. It also carries the validation-failure look: a box whose
         bhv:FieldState.Error is bound to its tab's FieldErrors[<key>] gets a red edge, a faint
         red wash and the validator's own message as its tool-tip, so the box that needs fixing is
         obvious without reading the error list above the form. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Style.Triggers>
            <Trigger Property="bhv:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                <Setter Property="ToolTip" Value="{Binding (bhv:FieldState.Error), RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== CHECKBOX (implicit) ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.Bg.Sunken}"
                                BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph" Text="{DynamicResource Icon.Check}"
                                       FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Text" Value="{DynamicResource Icon.Dash}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.31" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================== RADIOBUTTON (implicit) =================== -->
    <!-- Classic disc. Nav.Item / LogChip set Style explicitly and
         are unaffected. -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Disc"
                                     Fill="{DynamicResource Brush.Bg.Sunken}"
                                     Stroke="{DynamicResource Brush.Stroke.Strong}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="6" Height="6"
                                     Fill="{DynamicResource Brush.Accent}" Opacity="0" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.31" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== COMBOBOX (implicit) ==================== -->
    <!-- Non-editable, read-only template that mirrors Field: sunken box, amber
         focus, dark popup, amber-soft selected row. No system blue anywhere. -->
    <Style x:Key="Themed.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Small}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Themed.ComboBoxItem}" />

    <!-- Keyed AND implicit (see the BasedOn style right after it): every ComboBox in the app
         gets this template, its dark popup and the drop-down wheel-scroll behaviour without
         having to remember the Style= reference. A new drop-down added later therefore cannot
         silently fall back to the OS look, and cannot miss the drop-down scrolling fix.
         ScrollViewer.CanContentScroll is set here rather than inherited from the OS theme style
         because ComboBoxDropDownFocus reads it to decide whether the list's VerticalOffset is
         measured in items or in pixels - leaving it implicit is what made a single wheel notch
         jump the whole list. -->
    <Style x:Key="Themed.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Themed.ComboBoxItem}" />
        <Setter Property="bhv:ComboBoxDropDownFocus.Enable" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource Radius.Control}"
                                            SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Brush.Text.Primary}" />

                        <TextBlock x:Name="Chevron" Text="{DynamicResource Icon.Chevron.Down}" IsHitTestVisible="False"
                                   FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,11,0" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="DropDown" Margin="0,4,0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                                      Opacity="0.5" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer x:Name="PART_DropDownScroll" Margin="4" SnapsToDevicePixels="True" Focusable="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="34" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Same validation-failure look as a TextBox: the facility picker is a required
                 field, so it has to be able to say so the same way every other box does. -->
            <Trigger Property="bhv:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                <Setter Property="ToolTip" Value="{Binding (bhv:FieldState.Error), RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
        <Style.Resources>
            <!-- last-resort: any stray system-drawn part stays on-theme -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#24FDC518" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE7A0" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0F1A26" />
        </Style.Resources>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource Themed.ComboBox}" />

    <!-- ==================== CALENDAR (implicit) ===================== -->
    <!-- Re-skin of the stock WPF Calendar: dark panel like the ComboBox drop-down, amber
         today ring, amber-soft selected day. The templates keep the part names the control's
         code looks for (PART_Root, PART_CalendarItem, PART_HeaderButton, PART_PreviousButton,
         PART_NextButton, PART_MonthView, PART_YearView, PART_DisabledVisual). Day and month
         buttons drive their look from the controls' own IsToday / IsSelected / IsInactive /
         IsBlackedOut / HasSelectedDays properties; the only visual state kept is the keyboard
         focus ring, which the control has no property for. -->
    <Style x:Key="Themed.CalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                <VisualState x:Name="CalendarButtonFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarButtonUnfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.34" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A month (year view) or a year (decade view). -->
    <Style x:Key="Themed.CalendarButton" TargetType="CalendarButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                <VisualState x:Name="CalendarButtonFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarButtonUnfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header: previous / month-year / next, then the month or year grid. The grids are
         filled in by CalendarItem's code, so they only declare their rows and columns. -->
    <Style x:Key="Themed.CalendarItem" TargetType="CalendarItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- day-of-week titles (Su Mo Tu ...) -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" Margin="0,4,0,6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Body}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_DisabledVisual" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="8" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.Resources>
                                    <!-- prev / next arrow -->
                                    <ControlTemplate x:Key="Calendar.NavButton" TargetType="Button">
                                        <Border x:Name="Box" Background="Transparent" CornerRadius="{DynamicResource Radius.Small}"
                                                Width="30" Height="28" Cursor="Hand">
                                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.FontFamily="{DynamicResource Font.Icon}"
                                                              TextElement.FontSize="11"
                                                              TextElement.Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                                                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Box" Property="Opacity" Value="0.34" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                    <!-- "January 2026": click to step out to the year / decade view -->
                                    <ControlTemplate x:Key="Calendar.HeaderButton" TargetType="Button">
                                        <Border x:Name="Box" Background="Transparent" CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10,4" Cursor="Hand">
                                            <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.FontFamily="{DynamicResource Font.Body}"
                                                              TextElement.FontSize="13"
                                                              TextElement.FontWeight="SemiBold"
                                                              TextElement.Foreground="{DynamicResource Brush.Text.Primary}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Box" Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Row="0" Grid.Column="0" Focusable="False"
                                        HorizontalAlignment="Left" Content="{DynamicResource Icon.Chevron.Left}"
                                        Template="{StaticResource Calendar.NavButton}" />
                                <Button x:Name="PART_HeaderButton" Grid.Row="0" Grid.Column="1" Focusable="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Template="{StaticResource Calendar.HeaderButton}" />
                                <Button x:Name="PART_NextButton" Grid.Row="0" Grid.Column="2" Focusable="False"
                                        HorizontalAlignment="Right" Content="{DynamicResource Icon.Chevron.Right}"
                                        Template="{StaticResource Calendar.NavButton}" />
                                <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>
                                <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" Visibility="Hidden">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Border>
                        <Rectangle x:Name="PART_DisabledVisual" Fill="{DynamicResource Brush.Bg.Sunken}" Opacity="0"
                                   RadiusX="10" RadiusY="10" Stretch="Fill" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyed AND implicit, like Themed.ComboBox: a bare Calendar anywhere gets this look. -->
    <Style x:Key="Themed.Calendar" TargetType="Calendar">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource Themed.CalendarItem}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Themed.CalendarDayButton}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Themed.CalendarButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Style="{TemplateBinding CalendarItemStyle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar" BasedOn="{StaticResource Themed.Calendar}" />

    <!-- The DatePicker's drop-down calendar: the same, plus the ComboBox drop-down's gap and shadow. -->
    <Style x:Key="Themed.Calendar.DropDown" TargetType="Calendar" BasedOn="{StaticResource Themed.Calendar}">
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================== DATEPICKER (implicit) ==================== -->
    <!-- Mirrors Field: sunken box, amber focus, same padding and disabled fade, the same
         validation-failure look as TextBox / ComboBox, and a calendar glyph on the right that
         opens Themed.Calendar.DropDown. PART_Root / PART_TextBox / PART_Button / PART_Popup are
         the parts DatePicker's code looks for; it puts the calendar into PART_Popup itself. -->
    <Style x:Key="Themed.DatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <!-- DatePickerTextBox binds its watermark ("Select a date") into this part. -->
                        <ContentControl x:Name="PART_Watermark" Focusable="False" IsHitTestVisible="False"
                                        Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        FontFamily="{DynamicResource Font.Body}" FontSize="13"
                                        Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Themed.DatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="CalendarStyle" Value="{StaticResource Themed.Calendar.DropDown}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Style="{StaticResource Themed.DatePickerTextBox}"
                                               Padding="{TemplateBinding Padding}"
                                               Focusable="{TemplateBinding Focusable}"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Cursor="Hand"
                                    ToolTip="Pick a date">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Box" Background="Transparent" Padding="0,0,11,0">
                                            <TextBlock x:Name="Glyph" Text="{DynamicResource Icon.Calendar}"
                                                       FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=Root}" StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Same validation-failure look as a TextBox / ComboBox. -->
            <Trigger Property="bhv:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                <Setter Property="ToolTip" Value="{Binding (bhv:FieldState.Error), RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource Themed.DatePicker}" />

    <!-- ========================= NUMBER TOGGLE ======================== -->
    <!-- A small square toggle for picking numbers out of a fixed range (the CRC
         filters picker). Deliberately small: forty-one of these (0 to 40) have to
         sit in a popup without it becoming a wall. -->
    <Style x:Key="Toggle.Number" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Bg.Sunken}"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ PROGRESS =========================== -->
    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
