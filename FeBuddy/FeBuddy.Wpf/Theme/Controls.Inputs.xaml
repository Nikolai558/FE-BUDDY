<!--
    Controls.Inputs.xaml
    ===========================================================================
        Pill.Radio   RadioButton styled as a segmented pill (output-mode pickers)
        Switch       ToggleButton styled as an iOS-style switch (on/off options)
        Field        TextBox with rounded sunken fill + amber focus + placeholder
                     (set the placeholder via the control's Tag)
        Progress     thin rounded determinate ProgressBar (amber fill)

    Implicit styles (no x:Key) so a bare control never falls back to the OS look:
        TextBox      -> Field
        CheckBox     -> 16px sunken box, amber when checked
        RadioButton  -> 16px sunken disc, amber dot when checked
    A control that sets its own Style="{StaticResource ...}" (Pill.Radio,
    Nav.Item, LogChip, Segmented) opts out of these automatically.

        ComboBox     -> Themed.ComboBox (dark sunken box + dark popup, kills the
                        system blue bar, and carries the drop-down wheel-scroll
                        behaviour). The keyed name still works for an explicit
                        reference; a bare ComboBox now picks it up on its own.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure">

    <!-- =========================== PILL RADIO ========================== -->
    <Style x:Key="Pill.Radio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.31" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ PILL TOGGLE ======================= -->
    <!-- Same pill look as Pill.Radio but multi-select (ToggleButton). Used for
         the airway designation include / exclude chips. -->
    <Style x:Key="Pill.Toggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Pill}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SEGMENTED ======================== -->
    <!-- ListBox whose items are pills; SelectedItem two-way binds to a value.
         Used for the Settings profile switcher. -->
    <Style x:Key="Segmented.Item" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Pill}" Padding="14,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segmented" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Segmented.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= SWITCH ============================ -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11"
                                Background="{DynamicResource Brush.Bg.Sunken}"
                                BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                                BorderThickness="1" />
                        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                HorizontalAlignment="Left" Margin="3,0,0,0"
                                Background="{DynamicResource Brush.Text.Tertiary}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.31" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= FIELD ============================ -->
    <!-- Placeholder text: set the TextBox's Tag, e.g. Tag="e.g. 44.512". -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Grid>
                            <TextBlock x:Name="Hint"
                                       Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       FontFamily="{DynamicResource Font.Body}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TEXTBOX (implicit) ====================== -->
    <!-- Every bare TextBox is Field; explicit Style="{StaticResource Field}"
         still works for the few call sites that want to be obvious about it. -->
    <!-- The implicit TextBox style. It also carries the validation-failure look: a box whose
         infra:FieldState.Error is bound to its tab's FieldErrors[<key>] gets a red edge, a faint
         red wash and the validator's own message as its tool-tip, so the box that needs fixing is
         obvious without reading the error list above the form. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Style.Triggers>
            <Trigger Property="infra:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                <Setter Property="ToolTip" Value="{Binding (infra:FieldState.Error), RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== CHECKBOX (implicit) ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.Bg.Sunken}"
                                BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph" Text="&#xE73E;"
                                       FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE738;" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.31" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================== RADIOBUTTON (implicit) =================== -->
    <!-- Classic disc. Pill.Radio / Nav.Item / LogChip set Style explicitly and
         are unaffected. -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Disc"
                                     Fill="{DynamicResource Brush.Bg.Sunken}"
                                     Stroke="{DynamicResource Brush.Stroke.Strong}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="6" Height="6"
                                     Fill="{DynamicResource Brush.Accent}" Opacity="0" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.31" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== COMBOBOX (implicit) ==================== -->
    <!-- Non-editable, read-only template that mirrors Field: sunken box, amber
         focus, dark popup, amber-soft selected row. No system blue anywhere. -->
    <Style x:Key="Themed.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Small}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Themed.ComboBoxItem}" />

    <!-- Keyed AND implicit (see the BasedOn style right after it): every ComboBox in the app
         gets this template, its dark popup and the drop-down wheel-scroll behaviour without
         having to remember the Style= reference. A new drop-down added later therefore cannot
         silently fall back to the OS look, and cannot miss the drop-down scrolling fix.
         ScrollViewer.CanContentScroll is set here rather than inherited from the OS theme style
         because ComboBoxDropDownFocus reads it to decide whether the list's VerticalOffset is
         measured in items or in pixels - leaving it implicit is what made a single wheel notch
         jump the whole list. -->
    <Style x:Key="Themed.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Themed.ComboBoxItem}" />
        <Setter Property="infra:ComboBoxDropDownFocus.Enable" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource Radius.Control}"
                                            SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Brush.Text.Primary}" />

                        <TextBlock x:Name="Chevron" Text="&#xE70D;" IsHitTestVisible="False"
                                   FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,11,0" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="DropDown" Margin="0,4,0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                                      Opacity="0.5" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer x:Name="PART_DropDownScroll" Margin="4" SnapsToDevicePixels="True" Focusable="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="34" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Same validation-failure look as a TextBox: the facility picker is a required
                 field, so it has to be able to say so the same way every other box does. -->
            <Trigger Property="infra:FieldState.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                <Setter Property="ToolTip" Value="{Binding (infra:FieldState.Error), RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
        <Style.Resources>
            <!-- last-resort: any stray system-drawn part stays on-theme -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#24FDC518" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE7A0" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0F1A26" />
        </Style.Resources>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource Themed.ComboBox}" />

    <!-- ========================= NUMBER TOGGLE ======================== -->
    <!-- A small square toggle for picking numbers out of a fixed range (the CRC
         filters picker). Deliberately tighter than Pill.Toggle: forty-one of these
         have to sit in a popup without it becoming a wall. -->
    <Style x:Key="Toggle.Number" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Bg.Sunken}"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ PROGRESS =========================== -->
    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
