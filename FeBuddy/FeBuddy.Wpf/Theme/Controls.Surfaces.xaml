<!--
    Controls.Surfaces.xaml
    ===========================================================================
        ctl:Card        (implicit) the standard rounded panel, with an optional title
        Card.Warn       ctl:Card - amber: something the user should know before going on
        Card.Danger     ctl:Card - red: something failed or blocks the run
        Card.Accent     ctl:Card - soft amber with an amber edge: a light, friendly heads-up
        Card.Popup      ctl:Card - a floating panel (flyout) with a drop shadow
        ctl:SectionHeader       (implicit) a card or section title
        SectionHeader.Group     ctl:SectionHeader - a heading for a group of controls in a card
        Panel.Inset     Border  - a darker, hairline-bordered panel inside a card (a CRC defaults panel)
        Panel.Block     Border  - a lighter, bordered block inside a Panel.Inset (one NAVAID type's defaults)
        Divider         Border  - 1px hairline rule
        Chip / Chip.*   Border  - small status badge (pair with Chip.Text)
        Chip.Text       TextBlock - the label inside a chip
        ctl:OutputTag   (implicit DataTemplate) an output tag: Alias, GeoJSON, Changes, JSON
        ctl:OutputLine  (implicit) one output's tag and what a card does to it
        OutputSummary.Line (DataTemplate) one What You'll Get line: its chip ("for", "and only", ...), then its text
        ctl:OutputSummary (implicit) a tab's What You'll Get summary: blocks headed by their outputs' tags
        Nav.List        ListBox - the side navigation
        Nav.Item        ListBoxItem - one nav row (icon + label + active bar)
        Tab.Rail        ListBox - the vertical tab rail inside a tabbed service
        Tab.Rail.Item   ListBoxItem - one tab (status dot + title + active bar)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
                    xmlns:tabm="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs.Models"
                    xmlns:conv="clr-namespace:FeBuddy.Wpf.Converters"
                    xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors">

    <!-- ========================= SECTION HEADER ====================== -->
    <!-- Every title in the app is a ctl:SectionHeader, so these two styles are the one place
         titles are cased and sized. The label is upper-cased here (so call sites write normal
         case); its font is the TextStyle - Text.SectionHeader for a card title, Text.Label one
         step smaller for a heading inside a card, so a card's title always sits above them.
         Text.* live in Typography.xaml, a sibling dictionary, hence DynamicResource. -->
    <conv:UpperCaseConverter x:Key="SectionHeader.ToUpper" />

    <Style TargetType="ctl:SectionHeader">
        <Setter Property="TextStyle" Value="{DynamicResource Text.SectionHeader}" />
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:SectionHeader">
                    <DockPanel LastChildFill="False" Margin="{TemplateBinding Padding}">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Style="{TemplateBinding TextStyle}"
                                   Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent},
                                                  Converter={StaticResource SectionHeader.ToUpper}}" />
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Content="{TemplateBinding Aside}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A heading for a group of controls inside a card ("AMENDMENT DATE", a CRC panel's
         "RUNWAYS — LINES"). No space of its own below it: the group's first control sets that. -->
    <Style x:Key="SectionHeader.Group" TargetType="ctl:SectionHeader"
           BasedOn="{StaticResource {x:Type ctl:SectionHeader}}">
        <Setter Property="TextStyle" Value="{DynamicResource Text.Label}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ============================== CARD =========================== -->
    <!-- Every card in the app is a ctl:Card, so this style is the one place its look is set.
         Cards stack with Margin's 16px gap below each one; a card placed by a Grid or WrapPanel
         sets its own Margin, which is layout and not look. The title is a SectionHeader, which
         owns the title's font and casing; a card with no Header shows no title row.
         A card holding a validation problem (NeedsAttention) gets a red outline, drawn over its
         edge so the layout doesn't move, and NEEDS ATTENTION beside its title. -->
    <Style TargetType="ctl:Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <!-- Brush.Stroke.Strong, not Brush.Stroke: the lighter hairline is almost invisible
             on Brush.Bg.Base, and every screen would read as one flat field. -->
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:Card">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <ctl:SectionHeader x:Name="Title" DockPanel.Dock="Top"
                                                   Label="{TemplateBinding Header}">
                                    <ctl:SectionHeader.Aside>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- the title's own font, so showing it can't change the row's height -->
                                            <TextBlock x:Name="AttentionLabel" Text="NEEDS ATTENTION"
                                                       Style="{DynamicResource Text.SectionHeader}"
                                                       Foreground="{DynamicResource Brush.Danger}"
                                                       VerticalAlignment="Center" Visibility="Collapsed" />
                                            <!-- the outputs the card's settings affect -->
                                            <ItemsControl ItemsSource="{TemplateBinding OutputTags}" Focusable="False"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Margin" Value="6,0,0,0" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ctl:SectionHeader.Aside>
                                </ctl:SectionHeader>
                                <!-- why the card is greyed out: every output it affects is off -->
                                <DockPanel x:Name="OutputsOffNote" DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Icon.Info}" FontFamily="{DynamicResource Font.Icon}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Top"
                                               Margin="0,2,8,0" />
                                    <TextBlock Text="{TemplateBinding OutputsOffNote}" Style="{DynamicResource Text.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                                </DockPanel>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <Border x:Name="AttentionOutline" BorderBrush="{DynamicResource Brush.Danger}"
                                BorderThickness="2" CornerRadius="{DynamicResource Radius.Card}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="NeedsAttention" Value="True">
                            <Setter TargetName="AttentionOutline" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AttentionLabel" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="OutputsOffNote" Value="{x:Null}">
                            <Setter TargetName="OutputsOffNote" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- A card whose options don't apply right now sinks into the background, so it
             reads as unavailable at a glance; its text and controls dim with it. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Card.Warn" TargetType="ctl:Card" BasedOn="{StaticResource {x:Type ctl:Card}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warn.Soft}" />
    </Style>

    <Style x:Key="Card.Danger" TargetType="ctl:Card" BasedOn="{StaticResource {x:Type ctl:Card}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
    </Style>

    <Style x:Key="Card.Accent" TargetType="ctl:Card" BasedOn="{StaticResource {x:Type ctl:Card}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
    </Style>

    <!-- Floats above the page (the Systems flyout). The margin leaves the shadow room to
         draw inside its Popup. -->
    <Style x:Key="Card.Popup" TargetType="ctl:Card" BasedOn="{StaticResource {x:Type ctl:Card}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="90"
                                  Opacity="0.5" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== INSET PANEL ======================== -->
    <!-- A panel set into a card, a step darker than it, for a self-contained group that sits
         beside others (the CRC ERAM defaults panels, a custom alias file). The margin spaces
         panels in a WrapPanel. -->
    <Style x:Key="Panel.Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Inset}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A block raised inside a Panel.Inset, a step lighter than the card, with a firmer edge:
         one of several side-by-side groups in the panel (a CRC defaults panel's NAVAID types),
         so each reads as its own box. -->
    <Style x:Key="Panel.Block" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Inset.Block}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========================= MAP OVERLAYS ======================== -->
    <!-- Floating panels drawn over a map: the toolbar, the cursor read-out, hints. Opaque
         enough to read over any line work, with a soft shadow to lift them off it. -->
    <Style x:Key="Map.Overlay" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A read-out or hint over the map: one line of small text. -->
    <Style x:Key="Map.Overlay.Chip" TargetType="Border" BasedOn="{StaticResource Map.Overlay}">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="9,5" />
    </Style>

    <!-- The editing-mode banner: amber, so the mode is impossible to miss. -->
    <Style x:Key="Map.Overlay.Accent" TargetType="Border" BasedOn="{StaticResource Map.Overlay.Chip}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
    </Style>

    <!-- A thin upright rule between groups in a map toolbar. -->
    <Style x:Key="Map.Overlay.Divider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="4,6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Stroke.Strong}" />
    </Style>

    <!-- One file or layer in a map sidebar list. -->
    <Style x:Key="Map.ListRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="8,5,4,5" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A list of files in the map sidebar: capped at a few rows with its own scroll bar, so a
         long list (up to 150 picked output files) never pushes the rest of the sidebar out of
         reach. At either end the wheel hands over to the sidebar. -->
    <Style x:Key="Map.ScrollList" TargetType="ScrollViewer">
        <Setter Property="MaxHeight" Value="264" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="bhv:WheelScroll.BubbleUp" Value="True" />
    </Style>

    <!-- A layer's colour key in a map list. -->
    <Style x:Key="Map.Swatch" TargetType="Rectangle">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ DIVIDER ========================== -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Stroke}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================= CHIP =========================== -->
    <!-- Soft-cornered rectangle, not an oval. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Chip.Warn" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warn.Soft}" />
    </Style>

    <!-- A status chip coloured by its Tag: Positive, Warn or Accent (anything else is neutral).
         Pair it with Chip.State.Text, which takes the matching text colour from the same Tag. -->
    <Style x:Key="Chip.State" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="Positive">
                <Setter Property="Background" Value="{DynamicResource Brush.Positive.Soft}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource Brush.Warn.Soft}" />
            </Trigger>
            <Trigger Property="Tag" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Label inside a chip. Set Foreground at the call site to match the chip
         variant (Brush.Positive / Brush.Warn / Brush.Accent.Text / ...). -->
    <Style x:Key="Chip.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- The label inside a Chip.State: coloured by the chip's Tag. -->
    <Style x:Key="Chip.State.Text" TargetType="TextBlock" BasedOn="{StaticResource Chip.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="Positive">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="Accent">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ========================= OUTPUT TAGS ========================= -->
    <!-- An output tag (ctl:OutputTag): a chip in its output's hue (Brush.Output.*), struck through
         and greyed while the output is off. Implicit, so a card's title row, an OutputLine, an
         Outputs card row and the General tab's headings all draw it the same way. -->
    <DataTemplate DataType="{x:Type ctl:OutputTag}">
        <Border x:Name="Chip" CornerRadius="{DynamicResource Radius.Chip}" BorderThickness="1" Padding="6,1"
                SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Left"
                ToolTip="{Binding ToolTip}"
                Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Stroke.Strong}">
            <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource Chip.Text}" FontSize="11" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Alias">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Output.Alias.Soft}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Output.Alias.Line}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Output.Alias}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Geojson">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Output.Geojson.Soft}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Output.Geojson.Line}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Output.Geojson}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ProcedureChanges">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Output.Changes.Soft}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Output.Changes.Line}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Output.Changes}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ProceduresJson">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Output.Json.Soft}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Output.Json.Line}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Output.Json}" />
            </DataTrigger>
            <!-- last, so it wins over the hue -->
            <DataTrigger Binding="{Binding IsOn}" Value="False">
                <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ctl:OutputLine: one output's tag, then what the card does to it. The tag column is a fixed
         width, so the lines' text lines up whichever outputs they name. -->
    <Style TargetType="ctl:OutputLine">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:OutputLine">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding Output}" Width="72"
                                          VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Text="{TemplateBinding Text}" Style="{DynamicResource Text.Prose}" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One line of a What You'll Get summary (tabm:SummaryLine): its chip ("for", "but only",
         "along with", ...) when it has one, then its text, file names between backticks shown as
         code. A line that wraps stays clear of its chip. -->
    <DataTemplate x:Key="OutputSummary.Line" DataType="{x:Type tabm:SummaryLine}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Chip" CornerRadius="{DynamicResource Radius.Chip}" BorderThickness="1" Padding="6,0,6,1"
                    Margin="0,2,7,0" VerticalAlignment="Top" SnapsToDevicePixels="True"
                    Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Stroke.Strong}">
                <TextBlock Text="{Binding JoinWord}" Style="{StaticResource Chip.Text}" FontSize="11"
                           Foreground="{DynamicResource Brush.Accent.Text}" />
            </Border>
            <TextBlock Grid.Column="1" bhv:InlineCode.Text="{Binding Text}" Style="{DynamicResource Text.Prose}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasJoin}" Value="False">
                <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ctl:OutputSummary: a tab's What You'll Get summary. Each block: its outputs' tags, then its
         lines indented under them, then any "Outputs include" lines indented once more. Hidden
         while there is nothing to sum up. -->
    <Style TargetType="ctl:OutputSummary">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:OutputSummary">
                    <ItemsControl ItemsSource="{TemplateBinding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ctl:OutputSummaryItem}">
                                <StackPanel Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,6,0" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource OutputSummary.Line}"
                                                  Focusable="False" Margin="16,0,0,0" />
                                    <StackPanel x:Name="Includes" Margin="16,8,0,0">
                                        <TextBlock Text="Outputs include:" Style="{DynamicResource Text.Prose}" />
                                        <ItemsControl ItemsSource="{Binding Includes}" ItemTemplate="{StaticResource OutputSummary.Line}"
                                                      Focusable="False" Margin="16,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasIncludes}" Value="False">
                                        <Setter TargetName="Includes" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ========================= NAVIGATION ========================= -->
    <!-- Nav rows are grouped RadioButtons (GroupName in the DataTemplate) so a
         single highlight is shared across the two separate nav groups without
         any ListBox selection coordination.
         A row whose page has unsaved edits (NavItem.HasUnsavedChanges) carries the
         same amber dot as a tab-rail row. -->
    <Style x:Key="Nav.Item" TargetType="RadioButton">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Grid>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                    Margin="0,8" CornerRadius="2"
                                    Background="{DynamicResource Brush.Accent}" Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="15,0,10,0" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Warn}" ToolTip="Unsaved changes"
                                     Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== TAB RAIL ========================== -->
    <!-- The vertical tab strip inside a first-tier service screen (AIRAC Service
         today; perhaps Data Viewers / Health Services later). It runs
         down the left of the page rather than across the top because a service is
         expected to reach roughly twenty sub-service tabs: a column keeps every
         tab visible and readable at full width, where a horizontal strip would
         start hiding them behind an overflow menu exactly when there are enough
         to need scanning.
         Each row carries a status dot: amber for unsaved edits, red for a missing
         or invalid value, nothing at all when the tab is settled.
         A tab that is set apart (IsSetApart: the Review tab) gets a divider above it, so
         the settings tabs read as one group and the run's outcome as another.
         A tab that doesn't take part (IsAvailable false: a sub-service left out on the General
         tab) stays in its place, greyed out and unclickable, with no status dot; hovering it
         says what it is and how to bring it in. -->
    <Style x:Key="Tab.Rail.Item" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
        <Setter Property="ToolTip" Value="{Binding UnavailableToolTip}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <DockPanel>
                        <Border x:Name="Separator" DockPanel.Dock="Top" Style="{StaticResource Divider}"
                                Margin="4,8,4,9" Visibility="Collapsed" />
                        <Border x:Name="Root" Background="Transparent" MinHeight="36"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                        Margin="0,8" CornerRadius="2"
                                        Background="{DynamicResource Brush.Accent}" Opacity="0" />
                                <DockPanel Margin="15,0,12,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot" DockPanel.Dock="Right" Width="8" Height="8"
                                             VerticalAlignment="Center" Margin="8,0,0,0"
                                             Visibility="Collapsed" />
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="{DynamicResource Font.Body}" FontSize="14.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSetApart}" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Status}" Value="Unsaved">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Warn}" />
                            <Setter TargetName="Dot" Property="ToolTip" Value="Unsaved changes" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Invalid">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Dot" Property="ToolTip" Value="Something here needs fixing" />
                        </DataTrigger>
                        <!-- after the status triggers, so a greyed-out tab never shows a dot -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tab.Rail" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Tab.Rail.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>

</ResourceDictionary>
