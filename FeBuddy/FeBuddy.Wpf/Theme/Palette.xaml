<!--
    Palette.xaml  -  the single source of truth for colour.
    ===========================================================================
    Nothing else in the app hard-codes a colour. Views and control styles only
    ever reference these keys, so re-skinning (or adding a light theme later) is
    a one-file change.

    Naming:
      Color.*   -> raw Color values (use when you need a Color, e.g. gradients)
      Brush.*   -> ready-to-use SolidColorBrush

    The palette is a dark, "operational scope" look: near-black blue-greys with a
    single amber accent and a green "good" signal. Inspired by clevelandcenter.org.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ SURFACES ============================ -->
    <Color x:Key="Color.Bg.Base">#0B0F14</Color>      <!-- app background            -->
    <Color x:Key="Color.Bg.Sunken">#070B10</Color>    <!-- inputs, status bar        -->
    <Color x:Key="Color.Panel">#0F1A26</Color>        <!-- nav rail                  -->
    <Color x:Key="Color.Card">#0E1621</Color>         <!-- cards on the base surface -->
    <Color x:Key="Color.Card.Hover">#132131</Color>
    <Color x:Key="Color.Overlay">#12FFFFFF</Color>    <!-- ~7% white hover wash      -->

    <SolidColorBrush x:Key="Brush.Bg.Base"   Color="{StaticResource Color.Bg.Base}" />
    <SolidColorBrush x:Key="Brush.Bg.Sunken" Color="{StaticResource Color.Bg.Sunken}" />
    <SolidColorBrush x:Key="Brush.Panel"     Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Card"      Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Card.Hover" Color="{StaticResource Color.Card.Hover}" />
    <SolidColorBrush x:Key="Brush.Overlay"   Color="{StaticResource Color.Overlay}" />

    <!-- ============================= LINES ============================= -->
    <Color x:Key="Color.Stroke">#1E2C3B</Color>
    <Color x:Key="Color.Stroke.Strong">#2A3D52</Color>

    <SolidColorBrush x:Key="Brush.Stroke"        Color="{StaticResource Color.Stroke}" />
    <SolidColorBrush x:Key="Brush.Stroke.Strong" Color="{StaticResource Color.Stroke.Strong}" />

    <!-- ============================= TEXT ============================= -->
    <Color x:Key="Color.Text.Primary">#F2F5F7</Color>
    <Color x:Key="Color.Text.Secondary">#9FB1C0</Color>
    <Color x:Key="Color.Text.Tertiary">#68798A</Color>
    <Color x:Key="Color.Text.OnAccent">#10161C</Color>   <!-- dark text on the amber button -->

    <SolidColorBrush x:Key="Brush.Text.Primary"   Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary"  Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent"  Color="{StaticResource Color.Text.OnAccent}" />

    <!-- ============================ ACCENT ============================ -->
    <Color x:Key="Color.Accent">#F4B740</Color>
    <Color x:Key="Color.Accent.Bright">#FDC518</Color>
    <Color x:Key="Color.Accent.Text">#FFE7A0</Color>       <!-- amber text on a soft amber fill -->

    <SolidColorBrush x:Key="Brush.Accent"        Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="{StaticResource Color.Accent.Bright}" />
    <SolidColorBrush x:Key="Brush.Accent.Text"   Color="{StaticResource Color.Accent.Text}" />
    <!-- Translucent amber fills for pills / selected nav / focus ring. -->
    <SolidColorBrush x:Key="Brush.Accent.Soft"   Color="#24FDC518" />
    <SolidColorBrush x:Key="Brush.Accent.Line"   Color="#66FDC518" />
    <SolidColorBrush x:Key="Brush.FocusRing"     Color="#8CFDC518" />

    <!-- ========================= STATUS SIGNALS ======================= -->
    <Color x:Key="Color.Positive">#34D399</Color>
    <Color x:Key="Color.Warn">#FBBF5C</Color>
    <Color x:Key="Color.Danger">#F26D6D</Color>
    <Color x:Key="Color.Info">#7CC7F2</Color>

    <SolidColorBrush x:Key="Brush.Positive" Color="{StaticResource Color.Positive}" />
    <SolidColorBrush x:Key="Brush.Warn"     Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Danger"   Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info"     Color="{StaticResource Color.Info}" />

    <SolidColorBrush x:Key="Brush.Positive.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Warn.Soft"     Color="#1FFBBF5C" />
    <SolidColorBrush x:Key="Brush.Danger.Soft"   Color="#1FF26D6D" />

    <!-- ======================== SHAPE / RADIUS ======================== -->
    <!-- Kept as CornerRadius resources so every rounded element agrees. -->
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Small">7</CornerRadius>
    <!-- Chips / badges / status highlights: a soft-cornered rectangle, never an oval
         (remediation plan 4.4). Radius.Pill stays only for genuine pill controls
         (segmented selectors, toggle pills). -->
    <CornerRadius x:Key="Radius.Chip">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

</ResourceDictionary>
