<!--
    AiracGeneralTabView  -  the General tab of the AIRAC Service screen: which cycle, and the table of
    sub-services - which are in the run, and which of their outputs each makes. Include always
    matches "at least one output ticked" (SubServiceRow), so an output's box is greyed out only when
    the sub-service doesn't make that kind of file. A sub-service left out is greyed out in the rail
    rather than taken away. Every box has a tooltip: the sub-service or
    the file, where its settings are, or that the sub-service doesn't make that kind of file. Save /
    navigation come from the tab host's action bar.

    Each cycle shows its state in colour. A cycle whose NASR data is ready but whose d-TPP
    Metafile isn't reads "partial", with a red note and a tooltip saying what that holds back.

    The table's columns line up through SharedSizeGroup on a stock Grid per row, so nothing is
    measured or rebuilt by hand.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AiracGeneralTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiracGeneralTabViewModel}"
             d:DesignWidth="820" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- a column heading, centred over its boxes -->
        <Style x:Key="ColumnHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- an output's box: centred in its column (the 8 makes up for the label gap a box keeps on
             its right), with its tooltip shown even while greyed out -->
        <Style x:Key="OutputBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller. -->
    <StackPanel>

        <!-- waiting / unavailable banner -->
        <ctl:Card Style="{StaticResource Card.Warn}"
                  Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding WaitingMessage}" Style="{StaticResource Text.Prose}" />
        </ctl:Card>

        <!-- ============ cycle ============ -->
        <ctl:Card Header="AIRAC Cycle">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding CycleOptions}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- A partial cycle (no d-TPP Metafile yet) explains itself when hovered
                                 anywhere on its row; the transparent background makes the gaps count. -->
                            <DockPanel Margin="0,3" Background="Transparent">
                                <DockPanel.ToolTip>
                                    <ToolTip MaxWidth="460" Content="{Binding ToolTip}" />
                                </DockPanel.ToolTip>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
                                        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                <Setter Property="ToolTipService.IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <!-- ready green, partial amber, failed red; anything else the caption grey -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Positive}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <RadioButton DockPanel.Dock="Left" GroupName="AiracCycle" Content="{Binding Label}"
                                             Foreground="{StaticResource Brush.Text.Primary}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <TextBlock Text="{Binding DtppNote}" Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center"
                                           Margin="12,0"
                                           Visibility="{Binding DtppNote, Converter={StaticResource StringToVis}}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding SelectedCycleLabel}" Style="{StaticResource Text.Caption}"
                           FontFamily="{StaticResource Font.Mono}" Margin="0,8,0,0" />
            </StackPanel>
        </ctl:Card>

        <!-- ============ sub-services ============ -->
        <ctl:Card Header="Sub-Services">
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,12"
                           Text="Tick the sub-services to run and the files each one makes. Each sub-service's settings are on its own tab, in the list to the left. Hover a box to see what it makes." />

                <!-- the headings -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="SubService" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Include" Style="{StaticResource ColumnHeading}" HorizontalAlignment="Left" TextAlignment="Left" />
                    <!-- the output tags, in the colours the tabs' cards use for the same outputs -->
                    <ContentPresenter Grid.Column="1" Content="{x:Static ctl:OutputTag.AliasHeading}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <ContentPresenter Grid.Column="2" Content="{x:Static ctl:OutputTag.GeojsonHeading}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <ContentPresenter Grid.Column="3" Content="{x:Static ctl:OutputTag.ChangesHeading}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <ContentPresenter Grid.Column="4" Content="{x:Static ctl:OutputTag.JsonHeading}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
                <Border Style="{StaticResource Divider}" Margin="0,0,0,4" />

                <ItemsControl ItemsSource="{Binding SubServices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tabs:SubServiceRow}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="SubService" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"
                                          Margin="0,0,6,0" ToolTip="{Binding IncludeToolTip}"
                                          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" />
                                <CheckBox Grid.Column="1" Style="{StaticResource OutputBox}"
                                          IsChecked="{Binding Alias}" IsEnabled="{Binding OffersAlias}" ToolTip="{Binding AliasToolTip}" />
                                <CheckBox Grid.Column="2" Style="{StaticResource OutputBox}"
                                          IsChecked="{Binding Geojson}" IsEnabled="{Binding OffersGeojson}" ToolTip="{Binding GeojsonToolTip}" />
                                <CheckBox Grid.Column="3" Style="{StaticResource OutputBox}"
                                          IsChecked="{Binding ProcedureChanges}" IsEnabled="{Binding OffersProcedureChanges}" ToolTip="{Binding ProcedureChangesToolTip}" />
                                <CheckBox Grid.Column="4" Style="{StaticResource OutputBox}"
                                          IsChecked="{Binding ProceduresJson}" IsEnabled="{Binding OffersProceduresJson}" ToolTip="{Binding ProceduresJsonToolTip}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                           MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                           Text="Untick all of a sub-service's files and it's left out. Tick one and it's back in. A sub-service that's left out is greyed out on the left and keeps its settings. Concatenate Aliases, which joins the alias files into one for vNAS, is included whenever an alias file is ticked." />
            </StackPanel>
        </ctl:Card>
    </StackPanel>
</UserControl>
