<!--
    AiracServiceView  -  the AIRAC Services screen.

    Built as tabs: a permanent General tab (cycle, facility, which sub-services to
    produce), one tab per selected sub-service, a Preview Settings tab that
    summarises everything and runs the service, and - once a run has started - a
    Review tab showing how it went. The rail runs down the left because this service
    is expected to reach roughly twenty sub-services.

    The screen owns the single page-level scroller and the shared action bar
    (Save / Undo / Previous / Next / Preview), which is why the tab views themselves
    contain neither.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AiracServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:local="clr-namespace:FeBuddy.Wpf.Views"
             xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiracServiceViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">

    <UserControl.Resources>
        <!-- one tab view-model -> its page -->
        <DataTemplate DataType="{x:Type vm:AiracGeneralTabViewModel}">
            <local:AiracGeneralTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AirportsViewModel}">
            <local:AirportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AirwaysViewModel}">
            <local:AirwaysView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type infra:PlaceholderSubServiceViewModel}">
            <local:PlaceholderSubServiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type infra:ServiceReviewTabViewModel}">
            <local:ServiceReviewTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type infra:ServiceRunReviewTabViewModel}">
            <local:ServiceRunReviewTabView />
        </DataTemplate>

        <!-- The action bar, rendered twice: pinned above the tab's content and again at
             the end of it, so neither the top nor the bottom of a long settings page is
             ever far from Save / Next. -->
        <DataTemplate x:Key="TabActionBar" DataType="{x:Type vm:AiracServiceViewModel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}" Content="Previous"
                            Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Next"
                            Command="{Binding NextCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Preview settings"
                            Command="{Binding GoToPreviewCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Undo all changes"
                            Command="{Binding RevertChangesCommand}" Margin="0,0,8,0"
                            ToolTip="Discard the unsaved edits on this tab and go back to its last saved settings." />
                    <Button Style="{StaticResource Button.Ghost}" Content="Undo last save"
                            Command="{Binding UndoLastSaveCommand}" Margin="0,0,8,0"
                            ToolTip="Step this tab's saved settings back to the previous save." />
                    <Button Style="{StaticResource Button.Primary}" Content="Save" MinWidth="90"
                            Command="{Binding SaveCommand}" />
                </StackPanel>

                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Warn}" Text="Unsaved changes"
                           Visibility="{Binding SelectedTab.IsDirty, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- pinned page header (theme fixes P4): title stays put while the body scrolls -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
            <TextBlock Text="AIRAC Services" Style="{StaticResource Text.Display}" Margin="28,24,28,14" />
            <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ tab rail ============ -->
            <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
                <ListBox Style="{StaticResource Tab.Rail}" Margin="12,16,12,16"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}" />
                <Border Width="1" HorizontalAlignment="Right"
                        Background="{StaticResource Brush.Stroke}" />
            </Grid>

            <!-- ============ tab content ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- pinned action bar -->
                <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TabActionBar}"
                                      Margin="28,16,28,14" />
                    <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              infra:WheelScroll.Amplify="3">
                    <StackPanel Margin="28,18,28,0">
                        <TextBlock Text="{Binding SelectedTabTitle}" Style="{StaticResource Text.H2}"
                                   Margin="0,0,0,14" />

                        <ContentControl Content="{Binding SelectedTab}" />

                        <!-- the same bar again at the end of the page -->
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TabActionBar}"
                                          Margin="0,0,0,28" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
