<!--
    AiracView  -  option form for the Airways -> GeoJSON generator.
    Radio pills bind to one enum via EnumToBool; switches bind to bool props.
    "Generate" is a no-op that just sets a status chip.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AiracView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiracViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="760">

    <UserControl.Resources>
        <!-- label + switch + caption, used for each on/off option -->
        <Style x:Key="OptionCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="780" HorizontalAlignment="Left">

                <!-- page header -->
                <TextBlock Style="{StaticResource Text.H1}" Text="AIRAC Data" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="Pull the current FAA NASR cycle and build ERAM-ready GeoJSON from airway data." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Style="{StaticResource Chip}">
                        <TextBlock Style="{StaticResource Chip.Text}" Text="AIRWAYS" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource Chip.Text}" Text="GEOJSON" />
                    </Border>
                </StackPanel>

                <!-- output mode -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="OUTPUT MODE" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="OutputMode" Content="None"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBool}, ConverterParameter=None}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="OutputMode" Content="High &amp; Low"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBool}, ConverterParameter=HighLow}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="OutputMode" Content="By designation"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBool}, ConverterParameter=Designation}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                                   Text="{Binding OutputModeHint}" />
                    </StackPanel>
                </Border>

                <!-- options -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="OPTIONS" />

                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top"
                                          IsChecked="{Binding BufferWaypoints}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Buffer airway waypoints" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="2.5 nm radius around 5-character fixes, 5 nm around NAVAIDs and others." />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top"
                                          IsChecked="{Binding IncludeFebProperties}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Include feb.* custom properties" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="Adds &quot;feb.AwyId&quot; (and friends) to every feature; namespaced to avoid collisions." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- region of interest -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="REGION OF INTEREST" />

                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top"
                                          IsChecked="{Binding OverrideRoi}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Override the default ROI for this run" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="Leave off to use the box from Settings &#8250; Default ROI." />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding OverrideRoi, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="NE LATITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. 44.512"
                                             Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="NE LONGITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. -80.104"
                                             Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="SW LATITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. 38.940"
                                             Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="SW LONGITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. -87.900"
                                             Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       Text="Decimal degrees. The southwest corner must sit south and west of the northeast corner." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- footer -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="Generate GeoJSON"
                            Command="{Binding GenerateCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Reset" Margin="10,0,0,0"
                            Command="{Binding ResetCommand}" />
                    <Border Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Chip.Accent}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Chip.Text}"
                                   Foreground="{StaticResource Brush.Accent.Text}"
                                   Text="{Binding StatusMessage}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
