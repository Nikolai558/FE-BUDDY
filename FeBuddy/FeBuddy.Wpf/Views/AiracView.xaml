<!--
    AiracView  -  the AIRAC cycle build screen.
    Pick a cycle, toggle output families (each = one v2.x generator, now ROI-clipped),
    tune the airway sub-options, run. "Generate" runs a scripted step panel built
    from the enabled families and raises a toast. Nothing is written.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AiracView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiracViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="900">

    <UserControl.Resources>
        <Style x:Key="OptionCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Text.H1}" Text="AIRAC" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="Pull the current FAA NASR cycle and build the CRC facility package, clipped to your region of interest." />

                <!-- cycle -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="CYCLE" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Cycle" Content="Current"
                                         IsChecked="{Binding CurrentCycle}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Cycle" Content="Next" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Body.Strong}" Margin="0,12,0,0"
                                   Text="{Binding CycleId, StringFormat='Cycle {0}'}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0" Text="{Binding EffectiveLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Style="{StaticResource Chip.Positive}">
                                <TextBlock Style="{StaticResource Chip.Text}" Foreground="{StaticResource Brush.Positive}"
                                           Text="APRA VERIFIED" />
                            </Border>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="9,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding ApraNote}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- output families -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="OUTPUT FAMILIES" />
                        <ItemsControl ItemsSource="{Binding Families}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" IsChecked="{Binding Enabled}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" Width="20" />
                                        <StackPanel Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body.Strong}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Chip.Text}" Text="{Binding FilesLabel}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- airway options (only when the Airways family is on) -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding ShowAirwayOptions, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ctl:SectionHeader Label="AIRWAY OPTIONS" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="OutputMode" Content="None"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBool}, ConverterParameter=None}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="OutputMode" Content="High &amp; Low"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBool}, ConverterParameter=HighLow}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="OutputMode" Content="By designation"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBool}, ConverterParameter=Designation}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" Text="{Binding OutputModeHint}" />

                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding BufferWaypoints}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Buffer airway waypoints" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="2.5 nm radius around 5-character fixes, 5 nm around NAVAIDs and others." />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding IncludeFebProperties}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Include feb.* custom properties" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="Adds &quot;feb.AwyId&quot; to every feature; namespaced to avoid collisions." />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding DmeCutoff}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="DME-cutoff line variant" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="Extra Airways_High/Low files trimmed 5 nm from NAVAIDs and 2 nm from fixes (v2.x behaviour)." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- region of interest -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="REGION OF INTEREST" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding OverrideRoi}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Override the default ROI for this run" />
                                <TextBlock Style="{StaticResource OptionCaption}"
                                           Text="Leave off to use the box from Settings &#8250; Default ROI." />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding OverrideRoi, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="NE LATITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. 44.512"
                                             Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="NE LONGITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. -80.104"
                                             Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="SW LATITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. 38.940"
                                             Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="SW LONGITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. -87.900"
                                             Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       Text="Decimal degrees. The southwest corner must sit south and west of the northeast corner." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- footer: buttons, or the scripted run panel -->
                <Grid Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowRunPanel, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Button Style="{StaticResource Button.Primary}" Content="Build cycle"
                                Command="{Binding GenerateCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Reset" Margin="10,0,0,0"
                                Command="{Binding ResetCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding ShowRunPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ctl:SectionHeader Label="{Binding RunTitle}">
                                <ctl:SectionHeader.Aside>
                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Text.Mono}"
                                               Foreground="{StaticResource Brush.Text.Tertiary}" />
                                </ctl:SectionHeader.Aside>
                            </ctl:SectionHeader>

                            <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress, Mode=OneWay}"
                                         Margin="0,2,0,14" />

                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                                <Ellipse x:Name="Dot" Width="7" Height="7"
                                                         Fill="{StaticResource Brush.Text.Tertiary}" />
                                                <TextBlock x:Name="Check" Text="&#xE73E;"
                                                           FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                           Foreground="{StaticResource Brush.Positive}"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Label}"
                                                       Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Ok">
                                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Divider}" Margin="0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Ghost}" Content="Cancel"
                                        Command="{Binding CancelRunCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource Button.Primary}" Content="Done"
                                        Command="{Binding DismissRunCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Open output folder"
                                        Margin="10,0,0,0" Command="{Binding OpenOutputCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
