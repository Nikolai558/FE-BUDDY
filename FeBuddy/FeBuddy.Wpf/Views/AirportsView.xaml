<!--
    AirportsView  -  the Airports sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AirportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AirportsViewModel}"
             d:DesignWidth="900" d:DesignHeight="1400">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ outputs ============ -->
            <cards:OutputsCard GeojsonDescription="Writes the airport and runway GeoJSON files selected below."
                               AliasDescription="Writes one alias command per airport FAA ID, and one more for an airport whose ICAO ID is different." />

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard LinesLabel="Runways — Lines"
                                    LinesDescription="One MultiLineString Feature per airport holding that airport's runway centrelines. (1 file)"
                                    SymbolsLabel="Airports — Symbols"
                                    SymbolsDescription="One symbol per airport, placed at its reference point. (1 file)"
                                    TextLabel="Airports — Text"
                                    TextDescription="A label per airport showing the FAA ID and the airport name. (1 file)" />

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ region of interest ============ -->
            <cards:RoiOverrideCard Outputs="Geojson">
                <cards:RoiOverrideCard.AdditionalContent>
                    <StackPanel Margin="0,10,0,0">
                        <ctl:OutputLine Kind="Geojson" Text="Only the airports whose reference point is inside the region." />
                        <ctl:OutputLine Kind="Alias" Text="Every airport, whatever the region." />
                    </StackPanel>
                </cards:RoiOverrideCard.AdditionalContent>
            </cards:RoiOverrideCard>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard LinesTitle="Runways — Lines" SymbolsTitle="Airports — Symbols" TextTitle="Airports — Text">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
