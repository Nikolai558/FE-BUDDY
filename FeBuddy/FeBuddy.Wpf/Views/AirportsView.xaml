<!--
    AirportsView  -  the Airports sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AirportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AirportsViewModel}"
             d:DesignWidth="900" d:DesignHeight="1400">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ area: an ROI, or everything ============ -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which airports the GeoJSON includes."
                            RoiDescription="only airports inside an ROI"
                            EverythingDescription="every operational airport">
                <cards:AreaCard.Footer>
                    <ctl:OutputLine Kind="Alias" Text="Every operational airport, whichever you pick above." Margin="0,14,0,0" />
                </cards:AreaCard.Footer>
            </cards:AreaCard>

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard LinesDescription="`Runways_Lines.geojson`&#xA;Each airport's runways, drawn as lines."
                                    SymbolsDescription="`Airports_Symbols.geojson`&#xA;An airport symbol, drawn at each airport's reference point."
                                    TextDescription="`Airports_Text.geojson`&#xA;A label with the airport's FAA ID and name, drawn at each airport's reference point." />

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard LinesTitle="Runways — Lines" SymbolsTitle="Airports — Symbols" TextTitle="Airports — Text">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
