<!--
    AirportsView  -  the Airports sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Review come from the tab host's shared action
    bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AirportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AirportsViewModel}"
             d:DesignWidth="900" d:DesignHeight="1400">

    <UserControl.Resources>
        <!-- one CRC ERAM class row. The column widths are fixed rather than starred:
             the page now fills the window, and star columns in a left-aligned block
             size to their own content, which left every box a different width. Any
             change here must be echoed by the three header Grids below, which repeat
             the same widths so the labels line up with the fields they describe.
             The per-field ToolTips are worded from the settings validator - keep them verbatim. -->
        <DataTemplate x:Key="EramRow" DataType="{x:Type m:EramClassDefault}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ClassName}" Style="{StaticResource Text.Body.Strong}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Margin="4,0" ItemsSource="{Binding BcgOptions}" SelectedItem="{Binding Bcg}"
                          infra:FieldState.Error="{Binding BcgError}"
                          ToolTip="BCG group: an integer 1–40." />
                <ctl:FilterPicker Grid.Column="2" Margin="4,0" Value="{Binding Filters, Mode=TwoWay}"
                                  infra:FieldState.Error="{Binding FiltersError}" />
                <ComboBox Grid.Column="3" Margin="4,0" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding Style}"
                          infra:FieldState.Error="{Binding StyleError}"
                          Visibility="{Binding ShowStyle, Converter={StaticResource BoolToVis}}"
                          ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                <ComboBox Grid.Column="4" Margin="4,0" ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding Thickness}"
                          infra:FieldState.Error="{Binding ThicknessError}"
                          Visibility="{Binding ShowThickness, Converter={StaticResource BoolToVis}}"
                          ToolTip="Thickness: an integer 1–3." />
                <ComboBox Grid.Column="4" Margin="4,0" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding Size}"
                          infra:FieldState.Error="{Binding SizeError}"
                          Visibility="{Binding ShowSize, Converter={StaticResource BoolToVis}}"
                          ToolTip="Size: an integer 1–4." />
            </Grid>
        </DataTemplate>

        <!-- column-header style for the row above each EramRow ItemsControl -->
        <Style x:Key="EramHeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- one output file row -->
        <DataTemplate x:Key="FileRow" DataType="{x:Type m:SubServiceOutputFileRow}">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Text="{Binding FeatureCount, StringFormat={}{0} feat.}"
                           Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- one message group. Heading already carries the count ("Warning (3)"), so unlike
             the Airways template there is no separate count on the right. -->
        <DataTemplate x:Key="MessageGroup" DataType="{x:Type m:SubServiceMessageGroup}">
            <Border Margin="0,4" Padding="10" CornerRadius="{StaticResource Radius.Chip}"
                    Background="{StaticResource Brush.Bg.Sunken}">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Body.Strong}" />
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside (theme fixes P3a).
         A second scroller stole the wheel and hid the lower sections. -->
    <StackPanel>

            <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"
                       MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />

            <!-- ============ outputs ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SectionHeader Label="OUTPUTS" />
                    <CheckBox Content="GeoJSON files" IsChecked="{Binding GenerateGeojson}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="Writes the airport and runway GeoJSON files selected below." />
                    <CheckBox Content="Alias file (Airports.txt)" IsChecked="{Binding GenerateAliasFile}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="Writes one alias command per airport FAA ID, and one for airports with an ICAO ID." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="At least one output must stay on. To produce nothing for Airports, deselect Airports on the General tab." />
                </StackPanel>
            </Border>

            <!-- ============ which GeoJSON files ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding GenerateGeojson}">
                <StackPanel>
                    <ctl:SectionHeader Label="GEOJSON FILES" />
                    <CheckBox Content="Airports — Symbols" IsChecked="{Binding EmitAirportSymbols}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="One symbol per airport, placed at its reference point." />
                    <CheckBox Content="Airports — Text" IsChecked="{Binding EmitAirportText}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="A label per airport showing the FAA ID and the airport name." />
                    <CheckBox Content="Runways — Lines" IsChecked="{Binding EmitRunwayLines}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="One MultiLineString per airport holding that airport's runway centrelines." />
                </StackPanel>
            </Border>

            <!-- ============ FE-Buddy properties ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="FE-BUDDY PROPERTIES" />
                    <CheckBox Content="Include FE-Buddy Properties, when available."
                              IsChecked="{Binding IncludeFebCustomProperties}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding FebPropertiesDescription}" Style="{StaticResource Text.Prose}"
                               Margin="20,4,0,0" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding IncludeFebCustomProperties}">
                        <ItemsControl ItemsSource="{Binding FebProperties}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:FebPropertyToggle}">
                                    <CheckBox Content="{Binding JsonKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding Description}" Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ CRC ERAM defaults ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcEramPropertyDefaults}" />
                        <ctl:SectionHeader Label="CRC ERAM DEFAULTS" />
                    </DockPanel>
                    <StackPanel IsEnabled="{Binding IncludeCrcEramPropertyDefaults}" Margin="0,6,0,0">

                        <!-- each block is written only when its file is emitted, so it hides with it -->
                        <StackPanel Visibility="{Binding EmitAirportSymbols, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AIRPORTS — SYMBOL" Style="{StaticResource Text.Label}" />
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" /><ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="BCG" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="2" Text="Filters" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="3" Text="Style" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource EramHeaderCell}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AirportSymbolDefaults}" ItemTemplate="{StaticResource EramRow}" Margin="0,0,0,14" />
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding EmitAirportText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AIRPORTS — TEXT" Style="{StaticResource Text.Label}" />
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" /><ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="BCG" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="2" Text="Filters" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource EramHeaderCell}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AirportTextDefaults}" ItemTemplate="{StaticResource EramRow}" Margin="0,0,0,14" />
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding EmitRunwayLines, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="RUNWAYS — LINE" Style="{StaticResource Text.Label}" />
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" /><ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="BCG" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="2" Text="Filters" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="3" Text="Style" Style="{StaticResource EramHeaderCell}" />
                                <TextBlock Grid.Column="4" Text="Thickness" Style="{StaticResource EramHeaderCell}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RunwayLineDefaults}" ItemTemplate="{StaticResource EramRow}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ region of interest ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="REGION OF INTEREST" />
                    <CheckBox Content="Override the default ROI for Airports" IsChecked="{Binding OverrideRoi}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding RoiFallbackHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Margin="20,4,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Visibility="{Binding OverrideRoi, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding OverrideRoi}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="NE lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="1" Margin="0,0,12,4" Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[NeLat]}" />
                            <TextBlock Grid.Column="2" Text="NE lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="3" Margin="0,0,0,4" Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[NeLon]}" />
                            <TextBlock Grid.Row="1" Text="SW lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[SwLat]}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="SW lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[SwLon]}" />
                        </Grid>
                        <Button Content="Pick on map…" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Command="{Binding PickRoiOnMapCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ run result panel ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding ShowPanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ctl:SectionHeader Label="LAST RUN" />

                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding RunFailed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Run failed" Style="{StaticResource Text.Body.Strong}" Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding RunError}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding RunSucceeded, Converter={StaticResource BoolToVis}}">
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,18,0"
                                       Text="{Binding AirportCount, StringFormat={}{0} airports}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,18,0"
                                       Text="{Binding AirportsInRoiCount, StringFormat={}{0} in ROI}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ElapsedText}" />
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRow}" Margin="0,8,0,0"
                                      Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding HasAliasFile, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding AliasCommandCount, StringFormat=Airports.txt · {0} alias command(s)}" />

                        <!-- warnings/errors expanded; info collapsed behind a count (3.8) -->
                        <ItemsControl ItemsSource="{Binding MessageGroups}" ItemTemplate="{StaticResource MessageGroup}" Margin="0,8,0,0"
                                      Visibility="{Binding HasAttentionMessages, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding HasInfoOnly, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Content="{Binding InfoToggleLabel}" Command="{Binding ToggleInfoCommand}" />
                            <ItemsControl ItemsSource="{Binding MessageGroups}" ItemTemplate="{StaticResource MessageGroup}"
                                          Visibility="{Binding IsInfoExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Content="Open output folder" Command="{Binding OpenOutputCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        <Rectangle Height="8" Fill="Transparent" />
    </StackPanel>
</UserControl>
