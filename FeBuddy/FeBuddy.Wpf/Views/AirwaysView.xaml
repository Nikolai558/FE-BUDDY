<!--
    AirwaysView  -  the Airways sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AirwaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AirwaysViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="1200">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel x:Name="Root">

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ area: an ROI, or everything ============
                 Under ROI, while the alias file is on: whether it gets every airway or only those that
                 cross the ROI. With any other area it gets every airway, so the choice is hidden. -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which airways to include. The airway types below still apply."
                            RoiDescription="only the airway segments and points inside an ROI"
                            EverythingDescription="every airway">
                <cards:AreaCard.RoiContent>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}">
                        <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Which Airways the Alias File Gets" />
                        <RadioButton GroupName="AliasScope" Content="Every airway" Margin="0,6,0,0"
                                     IsChecked="{Binding AliasRoiAirwaysOnly, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                        <RadioButton GroupName="AliasScope" Content="Only airways that cross the ROI" Margin="0,3,0,0"
                                     IsChecked="{Binding AliasRoiAirwaysOnly, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,0"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Text="Each command still has all of its airway's waypoints." />
                    </StackPanel>
                </cards:AreaCard.RoiContent>
            </cards:AreaCard>

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard LinesDescription="`*_Lines.geojson`&#xA;Airway lines drawn from waypoint to waypoint."
                                    SymbolsDescription="`*_Symbols.geojson`&#xA;Airway waypoint symbols."
                                    TextDescription="`*_Text.geojson`&#xA;Airway waypoint ID text." />

            <!-- ============ file layout ============ -->
            <ctl:Card Header="File Layout" Outputs="Geojson">
                <StackPanel>
                    <ctl:Option Margin="0,4,0,0"
                                Description="`Airways_High_Lines.geojson`&#xA;`Airways_Low_Lines.geojson`&#xA;And their `_Symbols` and `_Text` files, as ticked above. Choose which file each airway type goes in under High and Low Airway Classification, below.">
                        <RadioButton GroupName="AirwayOutputBy" Content="High and Low"
                                     IsChecked="{Binding OutputHighLow, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="One set of files for each airway type.&#xA;Examples: `Airways_J_Lines.geojson`, `Airways_Q_Lines.geojson`, `Airways_V_Lines.geojson`">
                        <RadioButton GroupName="AirwayOutputBy" Content="Airway Types"
                                     IsChecked="{Binding OutputByDesignation, Mode=TwoWay}" />
                    </ctl:Option>
                </StackPanel>
            </ctl:Card>

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ designations ============ -->
            <ctl:Card Header="Airway Types to Include" Outputs="Alias, Geojson">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Toggle the airway types you wish to include in your output files." />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="Waiting for AIRAC data…"
                               Visibility="{Binding IsCycleReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Designations}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:DesignationToggle}">
                                <CheckBox Content="{Binding Designation}" IsChecked="{Binding Included}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:Card>

            <!-- ============ High / Low classification: the file each included designation goes in ============ -->
            <!-- Shown for High and Low output once a designation is included. The same toggles as
                 the card above; an excluded one's row collapses. A row with no file chosen is marked
                 until the user picks one. Every row's label column is as wide as the longest
                 designation (a shared size group), so the drop-downs line up and sit close to
                 their labels. -->
            <ctl:Card Header="High and Low Airway Classification" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[HighAndLowFiles]}"
                      Visibility="{Binding ShowsStrata, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               bhv:InlineCode.Text="Choose which altitude stratum an airway belongs to: High goes in the `Airways_High` files, Low in the `Airways_Low` files, and Both in both.&#xA;J and Q start as High, and V and T as Low. Any other type needs a choice before you can run." />
                    <ItemsControl ItemsSource="{Binding Designations}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:DesignationToggle}">
                                <Grid Margin="0,0,20,8"
                                      Visibility="{Binding Included, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Designation" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Designation}" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Style="{StaticResource Text.Body.Strong}" FontFamily="{StaticResource Font.Mono}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource Themed.ComboBox}" Width="110"
                                              ItemsSource="{x:Static vm:AirwaysViewModel.StratumValues}"
                                              SelectedItem="{Binding Stratum}"
                                              bhv:FieldState.Error="{Binding StratumError}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:Card>

            <!-- ============ buffer airway waypoints ============ -->
            <ctl:Card Header="Buffer Airway Waypoints" Outputs="Geojson">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Stops each line short of its fixes, so the lines don't run through the fix symbols." />
                    <CheckBox Content="Buffer airway waypoints" IsChecked="{Binding BufferAirwayWaypoints}" />
                    <!-- How far the lines stop short: only while buffering is on. The label column is
                         as wide as the longer label, so both boxes line up. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding BufferAirwayWaypoints, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Around fixes" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource Field.Number}"
                                     Text="{Binding FixBufferNm, UpdateSourceTrigger=PropertyChanged}"
                                     bhv:FieldState.Error="{Binding FieldErrors[FixBufferNm]}" />
                            <TextBlock Grid.Column="2" Text="NM" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Around NAVAIDs" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field.Number}" Margin="8,6,8,0"
                                     Text="{Binding NavaidBufferNm, UpdateSourceTrigger=PropertyChanged}"
                                     bhv:FieldState.Error="{Binding FieldErrors[NavaidBufferNm]}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="NM" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0" Text="Notes:" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="16,2,0,0"
                               Text="1. Allowed range: 0 to 10 NM.&#xA;2. A leg too short to fit the gaps at both of its ends isn't drawn at all.&#xA;3. Choosing this option creates a larger file but looks much nicer on CRC." />
                </StackPanel>
            </ctl:Card>

            <!-- ============ antimeridian ============ -->
            <ctl:Card Header="Split GeoJSON at the Antimeridian" Outputs="Geojson">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Splits a line that crosses 180° longitude in two, so it doesn't stretch across the whole map.&#xA;&#xA;Most GeoJSON viewers, including CRC, need you to leave this option ticked ON, unless specifically told otherwise." />
                    <CheckBox Content="Split airway geometry at the antimeridian" IsChecked="{Binding SplitAtAntimeridian}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard>
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
