<!--
    AirwaysView  -  the Airways sub-service page, hosted inside the AIRAC Service
    screen (remediation plan Phase 7). Its own settings menu (Save / Undo) plus
    the run result panel. The run is launched by the parent's Run AIRAC Service.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AirwaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:awy="clr-namespace:FEBuddyLibrary.Models.Services.Airac.Airways;assembly=FEBuddyLibrary"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AirwaysViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="1200">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="OutputByValues" MethodName="GetValues" ObjectType="{x:Type awy:AirwayGeojsonOutputBy}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="awy:AirwayGeojsonOutputBy" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- one CRC ERAM class row -->
        <DataTemplate x:Key="EramRow" DataType="{x:Type m:EramClassDefault}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ClassName}" Style="{StaticResource Text.Body.Strong}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="4,0" Text="{Binding Bcg, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="BCG group: an integer 1–40." />
                <TextBox Grid.Column="2" Margin="4,0" Text="{Binding Filters, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filters: comma-separated integers, each 0–40, at least one entry." />
                <TextBox Grid.Column="3" Margin="4,0" Text="{Binding Style, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowStyle, Converter={StaticResource BoolToVis}}"
                         ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                <TextBox Grid.Column="4" Margin="4,0" Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowThickness, Converter={StaticResource BoolToVis}}"
                         ToolTip="Thickness: an integer 1–3." />
                <TextBox Grid.Column="4" Margin="4,0" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowSize, Converter={StaticResource BoolToVis}}"
                         ToolTip="Size: an integer 1–4." />
            </Grid>
        </DataTemplate>

        <!-- one output file row -->
        <DataTemplate x:Key="FileRow" DataType="{x:Type m:AirwaysOutputFileRow}">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Text="{Binding FeatureCount, StringFormat={}{0} feat.}"
                           Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- one message group -->
        <DataTemplate x:Key="MessageGroup" DataType="{x:Type m:AirwaysMessageGroup}">
            <Border Margin="0,4" Padding="10" CornerRadius="{StaticResource Radius.Chip}"
                    Background="{StaticResource Brush.Bg.Sunken}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0} msg}"
                                   Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding AirwayId}" Style="{StaticResource Text.Body.Strong}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <!-- ============ save / undo bar ============ -->
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Undo last save"
                        Command="{Binding UndoLastSaveCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Save"
                        Command="{Binding SaveCommand}" MinWidth="90" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                           Text="Unsaved changes" Foreground="{StaticResource Brush.Warn}"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
            <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />

            <!-- ============ GeoJSON output ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SectionHeader Label="GEOJSON OUTPUT" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource OutputByValues}}"
                              SelectedItem="{Binding OutputBy}" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding OutputModeHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <Border Style="{StaticResource Divider}" Margin="0,12" />
                    <TextBlock Text="Emit which files" Style="{StaticResource Text.Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="_Lines"   IsChecked="{Binding EmitLines}"   Margin="0,0,16,0" />
                        <CheckBox Content="_Symbols" IsChecked="{Binding EmitSymbols}" Margin="0,0,16,0" />
                        <CheckBox Content="_Text"    IsChecked="{Binding EmitText}" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,12" />
                    <CheckBox Content="Buffer airway waypoints (lines stop short of the waypoint symbols)"
                              IsChecked="{Binding BufferAirwayWaypoints}" />
                    <CheckBox Content="Include FE-Buddy custom properties" IsChecked="{Binding IncludeFebCustomProperties}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding FebPropertiesDescription}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="20,4,0,0" />
                    <CheckBox Content="Also include the airway waypoint ID list (feb.AwyWaypoints)"
                              IsChecked="{Binding IncludeAirwayWaypointIds}" IsEnabled="{Binding IncludeFebCustomProperties}"
                              Margin="20,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ designations (7.4) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="DESIGNATIONS TO INCLUDE" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,8"
                               Text="Derived from the selected cycle's AWY_IDs. All on by default; the deselected set is saved as ExcludedDesignations." />
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}"
                               Text="Waiting for AIRAC data…"
                               Visibility="{Binding IsCycleReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Designations}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:DesignationToggle}">
                                <CheckBox Content="{Binding Designation}" IsChecked="{Binding Included}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ CRC ERAM defaults (7.4) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcEramPropertyDefaults}" />
                        <ctl:SectionHeader Label="CRC ERAM DEFAULTS" />
                    </DockPanel>
                    <StackPanel IsEnabled="{Binding IncludeCrcEramPropertyDefaults}" Margin="0,6,0,0">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Emit" IsChecked="{Binding EmitLines}" />
                            <TextBlock Text="Lines" Style="{StaticResource Text.Label}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding LineDefaults}" ItemTemplate="{StaticResource EramRow}" Margin="0,2,0,10" />

                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Emit" IsChecked="{Binding EmitSymbols}" />
                            <TextBlock Text="Symbols" Style="{StaticResource Text.Label}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SymbolDefaults}" ItemTemplate="{StaticResource EramRow}" Margin="0,2,0,10" />

                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Emit" IsChecked="{Binding EmitText}" />
                            <TextBlock Text="Text" Style="{StaticResource Text.Label}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TextDefaults}" ItemTemplate="{StaticResource EramRow}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ aliases (7.5) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="ALIASES" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="Provides a command to draw all airway waypoints on an ERAM or STARS window. Syntax: .&lt;awyId&gt;F  —  e.g. .J3F .FF OAK RBL LKV IMB GEG" />
                    <CheckBox Content="Include the Airways.txt alias file" IsChecked="{Binding GenerateAliasFile}" />
                    <StackPanel Margin="20,6,0,0" IsEnabled="{Binding GenerateAliasFile}">
                        <RadioButton GroupName="AliasScope" Content="All FAA airways"
                                     IsChecked="{Binding AliasRoiAirwaysOnly, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, Mode=OneWay}" />
                        <RadioButton GroupName="AliasScope" Content="ROI airways only" Margin="0,3,0,0"
                                     IsChecked="{Binding AliasRoiAirwaysOnly, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ region of interest (7.7) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="REGION OF INTEREST" />
                    <CheckBox Content="Override the default ROI for Airways" IsChecked="{Binding OverrideRoi}" Margin="0,4,0,0" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding OverrideRoi}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="NE lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="1" Margin="0,0,12,4" Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="NE lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="3" Margin="0,0,0,4" Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="SW lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="SW lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Button Content="Pick on map…" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Command="{Binding PickRoiOnMapCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ antimeridian (7.8) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="SPLIT GEOJSON AT THE ANTIMERIDIAN" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="A line that crosses ±180° longitude is split into two LineStrings so it does not visually wrap across the whole map. Leave this on unless a downstream tool needs the un-split geometry." />
                    <CheckBox Content="Split airway geometry at the antimeridian" IsChecked="{Binding SplitAtAntimeridian}" />
                </StackPanel>
            </Border>

            <!-- ============ run result panel (7.9) ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding ShowPanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ctl:SectionHeader Label="LAST RUN" />

                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding RunFailed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Run failed" Style="{StaticResource Text.Body.Strong}" Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding RunError}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding RunSucceeded, Converter={StaticResource BoolToVis}}">
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,18,0"
                                       Text="{Binding AirwayCount, StringFormat={}{0} airways}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,18,0"
                                       Foreground="{StaticResource Brush.Warn}"
                                       Text="{Binding ExcludedCount, StringFormat={}{0} excluded}"
                                       Visibility="{Binding HasExcluded, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ElapsedText}" />
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRow}" Margin="0,8,0,0"
                                      Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding HasAliasFile, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding AliasLineCount, StringFormat=Airways.txt · {0} alias line(s)}" />

                        <!-- warnings/errors expanded; info collapsed behind a count (3.8) -->
                        <ItemsControl ItemsSource="{Binding MessageGroups}" ItemTemplate="{StaticResource MessageGroup}" Margin="0,8,0,0"
                                      Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding HasInfoOnly, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left"
                                    Content="{Binding InfoToggleLabel}" Command="{Binding ToggleInfoCommand}" />
                            <ItemsControl ItemsSource="{Binding MessageGroups}" ItemTemplate="{StaticResource MessageGroup}"
                                          Visibility="{Binding IsInfoExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Content="Open output folder" Command="{Binding OpenOutputCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Rectangle Height="8" Fill="Transparent" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
