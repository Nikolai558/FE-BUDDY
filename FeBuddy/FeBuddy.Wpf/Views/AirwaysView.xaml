<!--
    AirwaysView  -  the Airways sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Review come from the tab host's shared action
    bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AirwaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:awy="clr-namespace:FeBuddy.Core.Models.Services.Airac.Airways;assembly=FeBuddy.Core"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AirwaysViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="1200">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="OutputByValues" MethodName="GetValues" ObjectType="{x:Type awy:AirwayGeojsonOutputBy}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="awy:AirwayGeojsonOutputBy" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- CRC ERAM DEFAULTS panels. Each kind (Lines / Symbols / Text) is its own bordered
             panel: property labels down the left, one column per altitude class (High / Low /
             Other) under a header row. The class columns are a fixed width rather than Auto or
             star so the header, and every control in a column, line up exactly whatever each
             box currently shows. The per-field ToolTips are worded from the settings validator -
             keep them verbatim. -->
        <Style x:Key="EramPanel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- property name on the left of a CRC panel row -->
        <Style x:Key="EramFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>

        <!-- xOffset / yOffset box. The hint is a Style setter, not a local ToolTip, so the
             implicit TextBox style's error trigger can still swap in the validation message
             ("Must be a whole number, ...") - a local value would always win over it. -->
        <Style x:Key="EramOffsetBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ToolTip" Value="Any whole number of pixels. 0 for none." />
        </Style>

        <!-- class name above each column of a CRC panel -->
        <Style x:Key="EramClassHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="4,0,4,4" />
        </Style>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside (theme fixes P3a).
         A second scroller stole the wheel and hid the lower sections. -->
    <StackPanel>

            <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"
                       MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />

            <!-- ============ GeoJSON output ============ -->
            <ctl:Card Header="GeoJSON Output">
                <StackPanel>
                    <ComboBox Style="{StaticResource Themed.ComboBox}"
                              ItemsSource="{Binding Source={StaticResource OutputByValues}}"
                              SelectedItem="{Binding OutputBy}" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding OutputModeHint}" Style="{StaticResource Text.Prose}"
                               Margin="0,8,0,0" />

                </StackPanel>
            </ctl:Card>

            <!-- ============ which GeoJSON files ============ -->
            <ctl:Card Header="What Files Do You Want?" IsEnabled="{Binding IsGeojsonOutputOn}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="_Lines"   IsChecked="{Binding EmitLines}"   Margin="0,0,16,0" />
                        <CheckBox Content="_Symbols" IsChecked="{Binding EmitSymbols}" Margin="0,0,16,0" />
                        <CheckBox Content="_Text"    IsChecked="{Binding EmitText}" />
                    </StackPanel>
                </StackPanel>
            </ctl:Card>

            <!-- ============ designations (7.4) ============ -->
            <ctl:Card Header="Designations to Include">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Derived from the selected cycle's AWY_IDs. All on by default; the deselected set is saved as ExcludedDesignations." />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="Waiting for AIRAC data…"
                               Visibility="{Binding IsCycleReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Designations}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:DesignationToggle}">
                                <CheckBox Content="{Binding Designation}" IsChecked="{Binding Included}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:Card>

            <!-- ============ FE-Buddy properties ============ -->
            <ctl:Card Header="FE-Buddy Properties" IsEnabled="{Binding IsGeojsonOutputOn}">
                <StackPanel>
                    <CheckBox Content="Include FE-Buddy Properties, when available."
                              IsChecked="{Binding IncludeFebCustomProperties}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding FebPropertiesDescription}" Style="{StaticResource Text.Prose}"
                               Margin="20,4,0,0" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding IncludeFebCustomProperties}">
                        <ItemsControl ItemsSource="{Binding FebProperties}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:AirwayFebPropertyToggle}">
                                    <CheckBox Content="{Binding JsonKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding Description}" Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ctl:Card>

            <!-- ============ buffer airway waypoints ============ -->
            <ctl:Card Header="Buffer Airway Waypoints" IsEnabled="{Binding IsGeojsonOutputOn}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Lines stop short of each waypoint so they don't run through the waypoint symbols." />
                    <CheckBox Content="Buffer airway waypoints" IsChecked="{Binding BufferAirwayWaypoints}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ CRC ERAM defaults (7.4) ============ -->
            <ctl:Card Header="CRC ERAM Defaults" IsEnabled="{Binding IsGeojsonOutputOn}">
                <StackPanel>
                    <!-- Lines | Symbols | Text side by side; the WrapPanel stacks them when the
                         window is too narrow for all three, so no panel is ever clipped. A panel
                         shows only while its file is being produced (picked above). Its Include box
                         decides whether that file gets the CRC ERAM defaults; unticked, the fields
                         grey out but keep their values. -->
                    <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource EramPanel}" Visibility="{Binding EmitLines, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcLineDefaults}" Margin="16,0,0,0" />
                                    <TextBlock Text="LINES" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid IsEnabled="{Binding IncludeCrcLineDefaults}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding LineDefaults[0].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LineDefaults[1].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Column="3" Text="{Binding LineDefaults[2].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Row="1" Text="Filters" Style="{StaticResource EramFieldLabel}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="1" Margin="4,3" Value="{Binding LineDefaults[0].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding LineDefaults[0].FiltersError}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="2" Margin="4,3" Value="{Binding LineDefaults[1].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding LineDefaults[1].FiltersError}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="3" Margin="4,3" Value="{Binding LineDefaults[2].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding LineDefaults[2].FiltersError}" />
                                    <TextBlock Grid.Row="2" Text="BCG" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="4,3" ItemsSource="{Binding LineDefaults[0].BcgOptions}" SelectedItem="{Binding LineDefaults[0].Bcg}"
                                              infra:FieldState.Error="{Binding LineDefaults[0].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="4,3" ItemsSource="{Binding LineDefaults[1].BcgOptions}" SelectedItem="{Binding LineDefaults[1].Bcg}"
                                              infra:FieldState.Error="{Binding LineDefaults[1].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,3" ItemsSource="{Binding LineDefaults[2].BcgOptions}" SelectedItem="{Binding LineDefaults[2].Bcg}"
                                              infra:FieldState.Error="{Binding LineDefaults[2].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <TextBlock Grid.Row="3" Text="Style" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="4,3" ItemsSource="{Binding LineDefaults[0].StyleOptions}" SelectedItem="{Binding LineDefaults[0].Style}"
                                              infra:FieldState.Error="{Binding LineDefaults[0].StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <ComboBox Grid.Row="3" Grid.Column="2" Margin="4,3" ItemsSource="{Binding LineDefaults[1].StyleOptions}" SelectedItem="{Binding LineDefaults[1].Style}"
                                              infra:FieldState.Error="{Binding LineDefaults[1].StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="4,3" ItemsSource="{Binding LineDefaults[2].StyleOptions}" SelectedItem="{Binding LineDefaults[2].Style}"
                                              infra:FieldState.Error="{Binding LineDefaults[2].StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <TextBlock Grid.Row="4" Text="Thickness" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="4,3" ItemsSource="{Binding LineDefaults[0].ThicknessOptions}" SelectedItem="{Binding LineDefaults[0].Thickness}"
                                              infra:FieldState.Error="{Binding LineDefaults[0].ThicknessError}"
                                              ToolTip="Thickness: an integer 1–3." />
                                    <ComboBox Grid.Row="4" Grid.Column="2" Margin="4,3" ItemsSource="{Binding LineDefaults[1].ThicknessOptions}" SelectedItem="{Binding LineDefaults[1].Thickness}"
                                              infra:FieldState.Error="{Binding LineDefaults[1].ThicknessError}"
                                              ToolTip="Thickness: an integer 1–3." />
                                    <ComboBox Grid.Row="4" Grid.Column="3" Margin="4,3" ItemsSource="{Binding LineDefaults[2].ThicknessOptions}" SelectedItem="{Binding LineDefaults[2].Thickness}"
                                              infra:FieldState.Error="{Binding LineDefaults[2].ThicknessError}"
                                              ToolTip="Thickness: an integer 1–3." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EramPanel}" Visibility="{Binding EmitSymbols, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcSymbolDefaults}" Margin="16,0,0,0" />
                                    <TextBlock Text="SYMBOLS" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid IsEnabled="{Binding IncludeCrcSymbolDefaults}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding SymbolDefaults[0].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SymbolDefaults[1].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SymbolDefaults[2].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Row="1" Text="Filters" Style="{StaticResource EramFieldLabel}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="1" Margin="4,3" Value="{Binding SymbolDefaults[0].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding SymbolDefaults[0].FiltersError}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="2" Margin="4,3" Value="{Binding SymbolDefaults[1].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding SymbolDefaults[1].FiltersError}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="3" Margin="4,3" Value="{Binding SymbolDefaults[2].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding SymbolDefaults[2].FiltersError}" />
                                    <TextBlock Grid.Row="2" Text="BCG" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="4,3" ItemsSource="{Binding SymbolDefaults[0].BcgOptions}" SelectedItem="{Binding SymbolDefaults[0].Bcg}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[0].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="4,3" ItemsSource="{Binding SymbolDefaults[1].BcgOptions}" SelectedItem="{Binding SymbolDefaults[1].Bcg}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[1].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,3" ItemsSource="{Binding SymbolDefaults[2].BcgOptions}" SelectedItem="{Binding SymbolDefaults[2].Bcg}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[2].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <TextBlock Grid.Row="3" Text="Style" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="4,3" ItemsSource="{Binding SymbolDefaults[0].StyleOptions}" SelectedItem="{Binding SymbolDefaults[0].Style}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[0].StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <ComboBox Grid.Row="3" Grid.Column="2" Margin="4,3" ItemsSource="{Binding SymbolDefaults[1].StyleOptions}" SelectedItem="{Binding SymbolDefaults[1].Style}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[1].StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="4,3" ItemsSource="{Binding SymbolDefaults[2].StyleOptions}" SelectedItem="{Binding SymbolDefaults[2].Style}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[2].StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <TextBlock Grid.Row="4" Text="Size" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="4,3" ItemsSource="{Binding SymbolDefaults[0].SizeOptions}" SelectedItem="{Binding SymbolDefaults[0].Size}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[0].SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                    <ComboBox Grid.Row="4" Grid.Column="2" Margin="4,3" ItemsSource="{Binding SymbolDefaults[1].SizeOptions}" SelectedItem="{Binding SymbolDefaults[1].Size}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[1].SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                    <ComboBox Grid.Row="4" Grid.Column="3" Margin="4,3" ItemsSource="{Binding SymbolDefaults[2].SizeOptions}" SelectedItem="{Binding SymbolDefaults[2].Size}"
                                              infra:FieldState.Error="{Binding SymbolDefaults[2].SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EramPanel}" Visibility="{Binding EmitText, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcTextDefaults}" Margin="16,0,0,0" />
                                    <TextBlock Text="TEXT" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid IsEnabled="{Binding IncludeCrcTextDefaults}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding TextDefaults[0].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TextDefaults[1].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Column="3" Text="{Binding TextDefaults[2].ClassName}" Style="{StaticResource EramClassHeader}" />
                                    <TextBlock Grid.Row="1" Text="Filters" Style="{StaticResource EramFieldLabel}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="1" Margin="4,3" Value="{Binding TextDefaults[0].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding TextDefaults[0].FiltersError}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="2" Margin="4,3" Value="{Binding TextDefaults[1].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding TextDefaults[1].FiltersError}" />
                                    <ctl:FilterPicker Grid.Row="1" Grid.Column="3" Margin="4,3" Value="{Binding TextDefaults[2].Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding TextDefaults[2].FiltersError}" />
                                    <TextBlock Grid.Row="2" Text="BCG" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="4,3" ItemsSource="{Binding TextDefaults[0].BcgOptions}" SelectedItem="{Binding TextDefaults[0].Bcg}"
                                              infra:FieldState.Error="{Binding TextDefaults[0].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="4,3" ItemsSource="{Binding TextDefaults[1].BcgOptions}" SelectedItem="{Binding TextDefaults[1].Bcg}"
                                              infra:FieldState.Error="{Binding TextDefaults[1].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <ComboBox Grid.Row="2" Grid.Column="3" Margin="4,3" ItemsSource="{Binding TextDefaults[2].BcgOptions}" SelectedItem="{Binding TextDefaults[2].Bcg}"
                                              infra:FieldState.Error="{Binding TextDefaults[2].BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <TextBlock Grid.Row="3" Text="Size" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="4,3" ItemsSource="{Binding TextDefaults[0].SizeOptions}" SelectedItem="{Binding TextDefaults[0].Size}"
                                              infra:FieldState.Error="{Binding TextDefaults[0].SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                    <ComboBox Grid.Row="3" Grid.Column="2" Margin="4,3" ItemsSource="{Binding TextDefaults[1].SizeOptions}" SelectedItem="{Binding TextDefaults[1].Size}"
                                              infra:FieldState.Error="{Binding TextDefaults[1].SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                    <ComboBox Grid.Row="3" Grid.Column="3" Margin="4,3" ItemsSource="{Binding TextDefaults[2].SizeOptions}" SelectedItem="{Binding TextDefaults[2].Size}"
                                              infra:FieldState.Error="{Binding TextDefaults[2].SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                    <TextBlock Grid.Row="4" Text="Opaque" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="4,3" ItemsSource="{Binding TextDefaults[0].YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding TextDefaults[0].Opaque}"
                                              infra:FieldState.Error="{Binding TextDefaults[0].OpaqueError}"
                                              ToolTip="Opaque: Yes or No." />
                                    <ComboBox Grid.Row="4" Grid.Column="2" Margin="4,3" ItemsSource="{Binding TextDefaults[1].YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding TextDefaults[1].Opaque}"
                                              infra:FieldState.Error="{Binding TextDefaults[1].OpaqueError}"
                                              ToolTip="Opaque: Yes or No." />
                                    <ComboBox Grid.Row="4" Grid.Column="3" Margin="4,3" ItemsSource="{Binding TextDefaults[2].YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding TextDefaults[2].Opaque}"
                                              infra:FieldState.Error="{Binding TextDefaults[2].OpaqueError}"
                                              ToolTip="Opaque: Yes or No." />
                                    <TextBlock Grid.Row="5" Text="Underline" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="4,3" ItemsSource="{Binding TextDefaults[0].YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding TextDefaults[0].Underline}"
                                              infra:FieldState.Error="{Binding TextDefaults[0].UnderlineError}"
                                              ToolTip="Underline: Yes or No." />
                                    <ComboBox Grid.Row="5" Grid.Column="2" Margin="4,3" ItemsSource="{Binding TextDefaults[1].YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding TextDefaults[1].Underline}"
                                              infra:FieldState.Error="{Binding TextDefaults[1].UnderlineError}"
                                              ToolTip="Underline: Yes or No." />
                                    <ComboBox Grid.Row="5" Grid.Column="3" Margin="4,3" ItemsSource="{Binding TextDefaults[2].YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding TextDefaults[2].Underline}"
                                              infra:FieldState.Error="{Binding TextDefaults[2].UnderlineError}"
                                              ToolTip="Underline: Yes or No." />
                                    <TextBlock Grid.Row="6" Text="X offset" Style="{StaticResource EramFieldLabel}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Margin="4,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding TextDefaults[0].XOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding TextDefaults[0].XOffsetError}" />
                                    <TextBox Grid.Row="6" Grid.Column="2" Margin="4,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding TextDefaults[1].XOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding TextDefaults[1].XOffsetError}" />
                                    <TextBox Grid.Row="6" Grid.Column="3" Margin="4,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding TextDefaults[2].XOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding TextDefaults[2].XOffsetError}" />
                                    <TextBlock Grid.Row="7" Text="Y offset" Style="{StaticResource EramFieldLabel}" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Margin="4,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding TextDefaults[0].YOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding TextDefaults[0].YOffsetError}" />
                                    <TextBox Grid.Row="7" Grid.Column="2" Margin="4,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding TextDefaults[1].YOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding TextDefaults[1].YOffsetError}" />
                                    <TextBox Grid.Row="7" Grid.Column="3" Margin="4,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding TextDefaults[2].YOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding TextDefaults[2].YOffsetError}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ctl:Card>

            <!-- ============ aliases (7.5) ============ -->
            <ctl:Card Header="Aliases">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Provides a command to draw all airway waypoints on an ERAM or STARS window. Syntax: .&lt;awyId&gt;F  —  e.g. .J3F .FF OAK RBL LKV IMB GEG" />
                    <CheckBox Content="Include the Airways.txt alias file" IsChecked="{Binding GenerateAliasFile}" />
                    <StackPanel Margin="20,6,0,0" IsEnabled="{Binding GenerateAliasFile}">
                        <RadioButton GroupName="AliasScope" Content="All FAA airways"
                                     IsChecked="{Binding AliasRoiAirwaysOnly, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                        <RadioButton GroupName="AliasScope" Content="ROI airways only" Margin="0,3,0,0"
                                     IsChecked="{Binding AliasRoiAirwaysOnly, Mode=TwoWay}"
                                     ToolTip="Every airway whose line crosses the region - the same airways the GeoJSON draws - each with all of its waypoints." />
                    </StackPanel>
                </StackPanel>
            </ctl:Card>

            <!-- ============ region of interest (7.7) ============ -->
            <ctl:Card Header="Region of Interest">
                <StackPanel>
                    <CheckBox Content="Override the default ROI for Airways" IsChecked="{Binding OverrideRoi}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding RoiFallbackHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Margin="20,4,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Visibility="{Binding OverrideRoi, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding OverrideRoi}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="NE lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="1" Margin="0,0,12,4" Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[NeLat]}" />
                            <TextBlock Grid.Column="2" Text="NE lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="3" Margin="0,0,0,4" Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[NeLon]}" />
                            <TextBlock Grid.Row="1" Text="SW lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[SwLat]}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="SW lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}"
                                     infra:FieldState.Error="{Binding FieldErrors[SwLon]}" />
                        </Grid>
                        <Button Content="Pick on map…" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Command="{Binding PickRoiOnMapCommand}" />
                    </StackPanel>
                </StackPanel>
            </ctl:Card>

            <!-- ============ antimeridian (7.8) ============ -->
            <ctl:Card Header="Split GeoJSON at the Antimeridian" IsEnabled="{Binding IsGeojsonOutputOn}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="A line that crosses ±180° longitude is split into two LineStrings so it does not visually wrap across the whole map. Leave this on unless a downstream tool needs the un-split geometry." />
                    <CheckBox Content="Split airway geometry at the antimeridian" IsChecked="{Binding SplitAtAntimeridian}" />
                </StackPanel>
            </ctl:Card>

        <Rectangle Height="8" Fill="Transparent" />
    </StackPanel>
</UserControl>
