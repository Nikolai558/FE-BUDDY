<!--
    AliasReferenceView  -  the alias / reference text files the AIRAC build
    produces (v2.x ALIAS/ folder), plus a cross-file duplicate check.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.AliasReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AliasReferenceViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="760">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Text.H1}" Text="Alias &amp; Reference" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="Alias commands and in-scope reference files generated alongside the cycle." />

                <!-- artifacts -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="GENERATED FILES" />
                        <ItemsControl ItemsSource="{Binding Artifacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,7">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Chip.Text}" Text="{Binding CountLabel}" />
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                        <Border Background="{StaticResource Brush.Bg.Sunken}" CornerRadius="7"
                                                Padding="10,7" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Sample}" Style="{StaticResource Text.Mono}"
                                                       FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- duplicate check -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="DUPLICATE COMMAND CHECK">
                            <ctl:SectionHeader.Aside>
                                <Button Style="{StaticResource Button.Subtle}" Content="Run check"
                                        Command="{Binding CheckDuplicatesCommand}" />
                            </ctl:SectionHeader.Aside>
                        </ctl:SectionHeader>
                        <TextBlock Text="{Binding DupSummary}" Style="{StaticResource Text.Caption}" />

                        <ItemsControl ItemsSource="{Binding Duplicates}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Command}" Style="{StaticResource Text.Mono}"
                                                   Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Files}" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
