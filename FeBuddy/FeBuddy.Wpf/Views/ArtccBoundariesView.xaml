<!--
    ArtccBoundariesView  -  the ARTCC Boundaries sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.ArtccBoundariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ArtccBoundariesViewModel}"
             d:DesignWidth="900" d:DesignHeight="1400">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ area: the ARTCCs, an ROI, or everything ============ -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which boundaries to draw."
                            ArtccsDescription="the boundaries of the ARTCCs you tick, in full"
                            RoiDescription="every boundary inside an ROI, cut off at its edge"
                            EverythingDescription="every ARTCC boundary, in full">
                <cards:AreaCard.ArtccsContent>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Text="ARTCCs appear once the selected cycle's data is loaded."
                                   Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding Locations}" IsEnabled="{Binding IsCycleReady}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ArtccToggle}">
                                    <CheckBox Content="{Binding Artcc}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Clear" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Command="{Binding ClearLocationsCommand}"
                                Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </cards:AreaCard.ArtccsContent>
            </cards:AreaCard>

            <!-- ============ file layout ============ -->
            <ctl:Card Header="File Layout" Outputs="Geojson">
                <StackPanel>
                    <ctl:Option Margin="0,4,0,0"
                                Description="`ARTCC-Boundary_High_Lines.geojson`&#xA;`ARTCC-Boundary_Low_Lines.geojson`&#xA;Boundaries labeled &quot;UNLIMITED&quot; go in both files.">
                        <RadioButton GroupName="ArtccBoundaryOutputBy" Content="High and Low"
                                     IsChecked="{Binding OutputHighLow, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="`ARTCC-Boundary_High_Lines.geojson`&#xA;`ARTCC-Boundary_Low_Lines.geojson`&#xA;`ARTCC-Boundary_Unlimited_Lines.geojson`">
                        <RadioButton GroupName="ArtccBoundaryOutputBy" Content="High, Low, and Unlimited"
                                     IsChecked="{Binding OutputHighLowUnlimited, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="Example: `ARTCC-Boundary_ZOB-HIGH_Lines.geojson`">
                        <RadioButton GroupName="ArtccBoundaryOutputBy" Content="One file per ARTCC and altitude"
                                     IsChecked="{Binding OutputByArtccAltitude, Mode=TwoWay}" />
                    </ctl:Option>
                </StackPanel>
            </ctl:Card>

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ antimeridian ============ -->
            <ctl:Card Header="Split GeoJSON at the Antimeridian" Outputs="Geojson">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Splits a line that crosses 180° longitude in two, so it doesn't stretch across the whole map. ZAK, ZAN, ZAP, and ZOA cross it.&#xA;&#xA;Most GeoJSON viewers, including CRC, need you to leave this option ticked ON, unless specifically told otherwise." />
                    <CheckBox Content="Split boundary lines at the antimeridian" IsChecked="{Binding SplitAtAntimeridian}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard LinesTitle="ARTCC Boundaries — Lines">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
