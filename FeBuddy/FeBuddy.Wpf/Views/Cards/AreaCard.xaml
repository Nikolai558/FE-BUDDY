<!--
    AreaCard  -  the Area card near the top of every AIRAC sub-service tab but Telephony and
    Concatenate Aliases: one choice of which area the run uses - the tab's ARTCCs (Procedures: its
    facilities), an ROI, everything, or (Procedures) none - with the chosen one's settings under it.
    Binds to the tab's view model through IAreaSettings; the tab names each choice and supplies its
    ARTCC list (ArtccsContent), anything more the ROI needs (RoiContent) and notes for the outputs
    the area doesn't change (Footer).

    Usage:
        <cards:AreaCard Outputs="Alias, Geojson"
                        Intro="Choose which arrivals to include."
                        ArtccsDescription="only arrivals for airports in the ARTCCs you tick"
                        RoiDescription="only arrivals inside an ROI"
                        EverythingDescription="every arrival in the cycle">
            <cards:AreaCard.ArtccsContent> ... </cards:AreaCard.ArtccsContent>
        </cards:AreaCard>
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.AreaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:IAreaSettings}"
             d:DesignWidth="820"
             x:Name="Self">
    <ctl:Card Header="Area" bhv:FieldState.Error="{Binding FieldErrors[Area]}"
              Outputs="{Binding Outputs, ElementName=Self}">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8" Text="{Binding Intro, ElementName=Self}" />

            <!-- The choices share this panel, so they're one group; each one's settings sit under it
                 while it's picked. -->
            <StackPanel>
                <RadioButton IsChecked="{Binding AreaArtccs, Mode=TwoWay}" Margin="0,2,0,0"
                             Visibility="{Binding OffersArtccs, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"><Run Text="{Binding ArtccsLabel, ElementName=Self, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding ArtccsDescription, ElementName=Self, Mode=OneWay}" /></TextBlock>
                </RadioButton>
                <ContentPresenter Content="{Binding ArtccsContent, ElementName=Self}" Margin="26,8,0,6"
                                  Visibility="{Binding AreaArtccs, Converter={StaticResource BoolToVis}}" />

                <RadioButton IsChecked="{Binding AreaRoi, Mode=TwoWay}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"><Run Text="ROI" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding RoiDescription, ElementName=Self, Mode=OneWay}" /></TextBlock>
                </RadioButton>
                <StackPanel Margin="26,10,0,6" Visibility="{Binding AreaRoi, Converter={StaticResource BoolToVis}}">
                    <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Which ROI" />
                    <StackPanel>
                        <RadioButton Content="The default ROI" IsChecked="{Binding UseDefaultRoi, Mode=TwoWay}" Margin="0,6,0,0" />
                        <!-- its corners, or (in amber) that none is set and what to do -->
                        <TextBlock Text="{Binding DefaultRoiSummary}" TextWrapping="Wrap" Margin="26,2,0,0"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDefaultRoi}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <RadioButton Content="{Binding Title}" ContentStringFormat="An ROI specific to {0}"
                                     IsChecked="{Binding OverrideRoi, Mode=TwoWay}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Margin="26,8,0,0" Visibility="{Binding OverrideRoi, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="NE lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="1" Margin="0,0,12,4" Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}"
                                     bhv:FieldState.Error="{Binding FieldErrors[NeLat]}" />
                            <TextBlock Grid.Column="2" Text="NE lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="3" Margin="0,0,0,4" Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}"
                                     bhv:FieldState.Error="{Binding FieldErrors[NeLon]}" />
                            <TextBlock Grid.Row="1" Text="SW lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}"
                                     bhv:FieldState.Error="{Binding FieldErrors[SwLat]}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="SW lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}"
                                     bhv:FieldState.Error="{Binding FieldErrors[SwLon]}" />
                        </Grid>
                        <Button Content="Pick on map…" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Command="{Binding PickRoiOnMapCommand}" />
                    </StackPanel>
                    <ContentPresenter Content="{Binding RoiContent, ElementName=Self}" />
                </StackPanel>

                <RadioButton IsChecked="{Binding AreaEverything, Mode=TwoWay}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"><Run Text="Everything" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding EverythingDescription, ElementName=Self, Mode=OneWay}" /></TextBlock>
                </RadioButton>

                <RadioButton IsChecked="{Binding AreaNone, Mode=TwoWay}" Margin="0,8,0,0"
                             Visibility="{Binding OffersNone, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"><Run Text="None" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding NoneDescription, ElementName=Self, Mode=OneWay}" /></TextBlock>
                </RadioButton>
            </StackPanel>

            <ContentPresenter Content="{Binding Footer, ElementName=Self}" />
        </StackPanel>
    </ctl:Card>
</UserControl>
