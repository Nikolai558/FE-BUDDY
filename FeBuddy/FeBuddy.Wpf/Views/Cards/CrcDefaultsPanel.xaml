<!--
    CrcDefaultsPanel  -  one kind's CRC ERAM defaults (Lines, Symbols or Text) inside the CRC ERAM
    Defaults card: its title, then one block per class - the class name (when there is more than
    one), then a row per property, its name on the left and its control on the right. Airports,
    Departures and Arrivals have one class, so one block; Airways can have High / Low / Other, and
    NAVAIDs split by type one per NAVAID type. The card hands it only the classes in use, and with
    none the panel hides itself.

    The blocks sit in a WrapPanel, so blocks that do not fit across the width carry on in the next
    line - thirteen NAVAID types, or a narrow window - and every box stays on screen. Nothing about
    the layout is worked out in code: a panel that rebuilt its own items while being measured
    would be measured again, and could go round without end.

    Which rows show comes from each class itself (EramClassDefault.AsksForStyle / ShowThickness /
    ShowSize / ShowTextOptions), so the same panel draws every kind; a NAVAIDs Symbols file styled
    by NAVAID type asks for no style.

    The File Conversions choose each kind's defaults on the panel itself: they turn on ShowInclude,
    which adds an Include box to the title; unticked, the rows grey out but keep their values. The
    AIRAC sub-services choose on the Upload to vNAS card instead and leave it off.

    The controls are a fixed width rather than Auto or star: the page fills the window, and an Auto
    column sizes to whatever is selected, so the boxes would all end up different widths. The label
    column is shared by every block (SharedSizeGroup), so the blocks are all one width and line up
    in columns when they wrap. The conditional rows start Collapsed (FallbackValue) until their
    binding resolves: a row measured even once while visible keeps widening that shared column.
    The per-field ToolTips are worded from the settings validator - keep them verbatim.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.CrcDefaultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             x:Name="Self"
             Visibility="Collapsed">
    <UserControl.Resources>
        <!-- xOffset / yOffset box. The hint is a Style setter, not a local ToolTip, so the
             implicit TextBox style's error trigger can still swap in the validation message
             ("Must be a whole number, ...") - a local value would always win over it. -->
        <Style x:Key="OffsetBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ToolTip" Value="Any whole number of pixels. 0 for none." />
        </Style>

        <!-- One property row of one class: its name (Header), then its control at a fixed width. -->
        <Style x:Key="Field" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CrcFieldLabel" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.FieldLabel}"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Grid.Column="1" Margin="0,3"
                                              Width="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=cards:CrcDefaultsPanel}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One class: its name, then a row per property its kind has. -->
        <DataTemplate x:Key="ClassBlock" DataType="{x:Type m:EramClassDefault}">
            <StackPanel Margin="{Binding BlockMargin, RelativeSource={RelativeSource AncestorType=cards:CrcDefaultsPanel}}">
                <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="{Binding ClassName}" Margin="0,0,0,4"
                                   Visibility="{Binding ShowClassNames, RelativeSource={RelativeSource AncestorType=cards:CrcDefaultsPanel}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                <HeaderedContentControl Style="{StaticResource Field}" Header="Filters">
                    <ctl:FilterPicker Value="{Binding Filters, Mode=TwoWay}" bhv:FieldState.Error="{Binding FiltersError}" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="BCG">
                    <ComboBox ItemsSource="{Binding BcgOptions}" SelectedItem="{Binding Bcg}"
                              bhv:FieldState.Error="{Binding BcgError}"
                              ToolTip="BCG group: an integer 1–40." />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="Style"
                                        Visibility="{Binding AsksForStyle, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ComboBox ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding Style}"
                              bhv:FieldState.Error="{Binding StyleError}"
                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="Thickness"
                                        Visibility="{Binding ShowThickness, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding Thickness}"
                              bhv:FieldState.Error="{Binding ThicknessError}"
                              ToolTip="Thickness: an integer 1–3." />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="Size"
                                        Visibility="{Binding ShowSize, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding Size}"
                              bhv:FieldState.Error="{Binding SizeError}"
                              ToolTip="Size: an integer 1–4." />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="Opaque"
                                        Visibility="{Binding ShowTextOptions, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ComboBox ItemsSource="{Binding YesNoOptions}" SelectedValuePath="Value" SelectedValue="{Binding Opaque}"
                              bhv:FieldState.Error="{Binding OpaqueError}"
                              ToolTip="Opaque: Yes or No." />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="Underline"
                                        Visibility="{Binding ShowTextOptions, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ComboBox ItemsSource="{Binding YesNoOptions}" SelectedValuePath="Value" SelectedValue="{Binding Underline}"
                              bhv:FieldState.Error="{Binding UnderlineError}"
                              ToolTip="Underline: Yes or No." />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="X offset"
                                        Visibility="{Binding ShowTextOptions, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBox Style="{StaticResource OffsetBox}"
                             Text="{Binding XOffset, UpdateSourceTrigger=PropertyChanged}"
                             bhv:FieldState.Error="{Binding XOffsetError}" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Field}" Header="Y offset"
                                        Visibility="{Binding ShowTextOptions, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBox Style="{StaticResource OffsetBox}"
                             Text="{Binding YOffset, UpdateSourceTrigger=PropertyChanged}"
                             bhv:FieldState.Error="{Binding YOffsetError}" />
                </HeaderedContentControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource Panel.Inset}">
        <StackPanel Grid.IsSharedSizeScope="True">
            <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="{Binding Title, ElementName=Self}" Margin="0,0,0,8">
                <ctl:SectionHeader.Aside>
                    <CheckBox Content="Include" IsChecked="{Binding IsIncluded, ElementName=Self}" Margin="16,0,0,0"
                              Visibility="{Binding ShowInclude, ElementName=Self, Converter={StaticResource BoolToVis}}" />
                </ctl:SectionHeader.Aside>
            </ctl:SectionHeader>

            <ItemsControl ItemsSource="{Binding Classes, ElementName=Self}" ItemTemplate="{StaticResource ClassBlock}"
                          IsEnabled="{Binding IsIncluded, ElementName=Self}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
