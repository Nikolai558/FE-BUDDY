<!--
    FebPropertiesCard  -  the FE-Buddy Helper Properties card on the GeoJSON sub-service tabs (all but Wx
    Stations, which has no feb.* properties) and ERAM to GeoJSON: the master switch, then one box
    per feb.* property it can write. Binds to the tab's or page's view model through
    IFebPropertySettings; the property list is the only thing that differs.

    Usage:
        <cards:FebPropertiesCard IsEnabled="{Binding GenerateGeojson}" />
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.FebPropertiesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:IFebPropertySettings}"
             d:DesignWidth="820">
    <ctl:Card Header="FE-Buddy Helper Properties" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[FebProperties]}">
        <StackPanel>
            <ctl:Option Margin="0,4,0,0"
                        Description="Extra fields on each map object, such as its name or ID, to make identifying and manipulating it easier in a GeoJSON viewer.&#xA;Each item is prefixed with `feb.` to prevent conflict with external properties.&#xA;These properties are ignored by CRC and may increase file size.">
                <CheckBox Content="Include FE-Buddy helper properties" IsChecked="{Binding IncludeFebCustomProperties}" />
            </ctl:Option>
            <!-- Under the option's description, one step past its label (as ctl:Option indents it). -->
            <ItemsControl Margin="42,8,0,0" ItemsSource="{Binding FebProperties}"
                          IsEnabled="{Binding IncludeFebCustomProperties}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:FebPropertyToggle}">
                        <CheckBox Content="{Binding JsonKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  ToolTip="{Binding Description}" Margin="0,0,14,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ctl:Card>
</UserControl>
