<!--
    GeojsonFilesCard  -  the "What files do you want?" card the GeoJSON sub-service tabs show (all
    but ARTCC Boundaries, which writes Lines only): one option per file, always in the order
    Lines, Symbols, Text. Binds to the tab's view model through IGeojsonFileChoices; the tab
    supplies only the wording, and ShowLines="False" for a sub-service with no Lines file.
    Under each option: the file's name (code look, bhv:InlineCode) indented one step past the
    label, then what goes in it indented once more - the way What You'll Get lists files.
    Footer takes anything more under the options (Departures and Arrivals: where their files are
    saved and how they're named).

    Usage:
        <cards:GeojsonFilesCard LinesFile="*_Lines.geojson"
                                LinesDescription="Airway lines drawn from waypoint to waypoint." />
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.GeojsonFilesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:IGeojsonFileChoices}"
             d:DesignWidth="820"
             x:Name="Self">
    <UserControl.Resources>
        <!-- The file's name, one step past the option's label (as an Option's description sits). -->
        <Style x:Key="FileName" TargetType="TextBlock" BasedOn="{StaticResource Text.Prose}">
            <Setter Property="Margin" Value="42,4,0,0" />
        </Style>
        <!-- What goes in the file, one step past its name. -->
        <Style x:Key="FileDescription" TargetType="TextBlock" BasedOn="{StaticResource Text.Prose}">
            <Setter Property="Margin" Value="58,2,0,0" />
        </Style>
    </UserControl.Resources>
    <ctl:Card Header="What Files Do You Want?" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[GeojsonFiles]}">
        <StackPanel>
            <StackPanel Margin="0,4,0,0" Visibility="{Binding ShowLines, ElementName=Self, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="Lines" IsChecked="{Binding EmitLines}" />
                <TextBlock Style="{StaticResource FileName}" bhv:InlineCode.Text="{Binding LinesFile, ElementName=Self, StringFormat='`{0}`'}" />
                <TextBlock Style="{StaticResource FileDescription}" bhv:InlineCode.Text="{Binding LinesDescription, ElementName=Self}" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0">
                <CheckBox Content="Symbols" IsChecked="{Binding EmitSymbols}" />
                <TextBlock Style="{StaticResource FileName}" bhv:InlineCode.Text="{Binding SymbolsFile, ElementName=Self, StringFormat='`{0}`'}" />
                <TextBlock Style="{StaticResource FileDescription}" bhv:InlineCode.Text="{Binding SymbolsDescription, ElementName=Self}" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0">
                <CheckBox Content="Text" IsChecked="{Binding EmitText}" />
                <TextBlock Style="{StaticResource FileName}" bhv:InlineCode.Text="{Binding TextFile, ElementName=Self, StringFormat='`{0}`'}" />
                <TextBlock Style="{StaticResource FileDescription}" bhv:InlineCode.Text="{Binding TextDescription, ElementName=Self}" />
            </StackPanel>
            <ContentPresenter Margin="0,14,0,0" Content="{Binding Footer, ElementName=Self}">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
        </StackPanel>
    </ctl:Card>
</UserControl>
