<!--
    OutputsCard  -  the first card (under the AttentionCard) on the tabs that write GeoJSON and an
    alias file: whether each is on, and what it writes. They are turned on and off on the General
    tab, so the card only shows the state and says where to change it. Binds to the tab's view
    model through IOutputSettings; the tab supplies the wording.

    GeojsonOptions and AliasOptions, when set, show under their output and grey out while it is off
    (Airways: how the GeoJSON is split into files, and which airways the alias file covers).

    Usage:
        <cards:OutputsCard GeojsonDescription="Writes the airport and runway GeoJSON files selected below."
                           AliasDescription="Writes one alias command per airport FAA ID ..." />
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.OutputsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:IOutputSettings}"
             d:DesignWidth="820"
             x:Name="Self">
    <UserControl.Resources>
        <!-- an output's own options: indented under it, hidden when the tab has none -->
        <Style x:Key="OutputOptions" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="50,8,0,0" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ctl:Card Header="Outputs">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Turn these on or off on the General tab." />

            <cards:OutputStatusRow Label="GeoJSON files" IsOn="{Binding GenerateGeojson}"
                                   Description="{Binding GeojsonDescription, ElementName=Self}" />
            <ContentPresenter Style="{StaticResource OutputOptions}" IsEnabled="{Binding GenerateGeojson}"
                              Content="{Binding GeojsonOptions, ElementName=Self}" />

            <cards:OutputStatusRow Margin="0,12,0,0" Label="Alias file" IsOn="{Binding GenerateAliasFile}"
                                   Description="{Binding AliasDescription, ElementName=Self}" />
            <ContentPresenter Style="{StaticResource OutputOptions}" IsEnabled="{Binding GenerateAliasFile}"
                              Content="{Binding AliasOptions, ElementName=Self}" />
        </StackPanel>
    </ctl:Card>
</UserControl>
