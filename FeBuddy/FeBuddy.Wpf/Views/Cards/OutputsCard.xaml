<!--
    OutputsCard  -  the first card on every sub-service tab: what the sub-service produces.
    A GeoJSON row, then the alias file, then the reminder that one output has to stay on.
    Binds to the tab's view model through IOutputSettings; the tab supplies the wording.

    The GeoJSON row is a "GeoJSON files" checkbox bound to GenerateGeojson unless the tab
    supplies its own GeojsonTemplate (Airways: a drop-down of how the files are split).
    AliasOptions, when set, shows indented under the alias file and greys out with it
    (Airways: which airways the alias file covers).

    Usage:
        <cards:OutputsCard GeojsonDescription="Writes the airport and runway GeoJSON files selected below."
                           AliasFileName="Airports.txt"
                           AliasDescription="Writes one alias command per airport FAA ID ..." />
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.OutputsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance infra:IOutputSettings}"
             d:DesignWidth="820"
             x:Name="Self">
    <UserControl.Resources>
        <!-- the GeoJSON row when the tab doesn't supply its own: a plain on / off -->
        <DataTemplate x:Key="GeojsonCheckBox">
            <ctl:Option Description="{Binding GeojsonDescription, RelativeSource={RelativeSource AncestorType=cards:OutputsCard}}">
                <CheckBox Content="GeoJSON files" IsChecked="{Binding GenerateGeojson}" />
            </ctl:Option>
        </DataTemplate>
    </UserControl.Resources>

    <ctl:Card Header="Outputs">
        <StackPanel>
            <ContentControl Margin="0,4,0,0" Focusable="False" Content="{Binding}"
                            ContentTemplate="{Binding GeojsonTemplate, ElementName=Self,
                                                      TargetNullValue={StaticResource GeojsonCheckBox}}" />

            <ctl:Option Margin="0,10,0,0" Description="{Binding AliasDescription, ElementName=Self}">
                <CheckBox Content="{Binding AliasFileName, ElementName=Self}" ContentStringFormat="Alias file ({0})"
                          IsChecked="{Binding GenerateAliasFile}" />
            </ctl:Option>
            <ContentPresenter Margin="20,6,0,0" IsEnabled="{Binding GenerateAliasFile}"
                              Content="{Binding AliasOptions, ElementName=Self}">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AliasOptions, ElementName=Self}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>

            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                       MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                       Text="{Binding Title, StringFormat='At least one output must stay on. To produce nothing for {0}, deselect {0} on the General tab.'}" />
        </StackPanel>
    </ctl:Card>
</UserControl>
