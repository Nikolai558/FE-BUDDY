<!--
    RunCard  -  the card at the foot of a tab that starts a run: a note on the left, the one
    primary button on the right. Used by the Preview Settings tab (Run AIRAC Service) and by
    every conversion tab (Convert ...). Binds to the tab's view model through IRunAction; the
    tab supplies the wording.

    Blocker, when set, is shown above the note in the warning colour: why the button is off
    right now (e.g. no files picked). The button's own CanExecute is what turns it off.

    Usage:
        <cards:RunCard Note="Unsaved settings are saved before the run starts." />
        <cards:RunCard Blocker="{Binding RunBlocker}" Note="..." />
-->
<UserControl x:Class="FeBuddy.Wpf.Views.Cards.RunCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:IRunAction}"
             d:DesignWidth="820"
             x:Name="Self">
    <ctl:Card>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" VerticalAlignment="Center"
                    Margin="16,0,0,0" Content="{Binding RunLabel}" Command="{Binding RunCommand}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warn}"
                           Text="{Binding Blocker, ElementName=Self}"
                           Visibility="{Binding Blocker, ElementName=Self, Converter={StaticResource StringToVis}}" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           Text="{Binding Note, ElementName=Self}" />
            </StackPanel>
        </DockPanel>
    </ctl:Card>
</UserControl>
