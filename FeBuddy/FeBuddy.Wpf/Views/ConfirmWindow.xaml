<infra:ChromeWindow x:Class="FeBuddy.Wpf.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Body}"
        Background="{StaticResource Brush.Bg.Base}">

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontFamily="{StaticResource Font.Display}" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text.Primary}" />

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Style="{StaticResource Text.Body}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{Binding CancelText}" Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" />
                <Button Content="{Binding ConfirmText}" Style="{StaticResource Button.Primary}"
                        Command="{Binding ConfirmCommand}" MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </Border>
</infra:ChromeWindow>
