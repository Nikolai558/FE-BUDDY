<!--
    ConversionsView  -  import external vector data to CRC GeoJSON.
    .DAT / .KML / .SCT2 only; vSTARS/vERAM and DXF were retired in 3.0.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.ConversionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ConversionsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="760">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="780" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Text.H1}" Text="Conversions" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="Turn FAA / third-party vector data into CRC-ready GeoJSON." />
                <Border Style="{StaticResource Chip.Warn}" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Chip.Text}" Foreground="{StaticResource Brush.Warn}"
                               Text="vSTARS / vERAM AND DXF CONVERSIONS RETIRED IN 3.0" />
                </Border>

                <!-- source format -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="SOURCE FORMAT" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Kind" Content="FAA .DAT"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumToBool}, ConverterParameter=Dat}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Kind" Content="Google Earth .KML / .KMZ"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumToBool}, ConverterParameter=Kml}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Kind" Content=".SCT2 sector file"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumToBool}, ConverterParameter=Sct2}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" Text="{Binding KindHint}" />
                    </StackPanel>
                </Border>

                <!-- files -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="FILES">
                            <ctl:SectionHeader.Aside>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Subtle}" Content="Add files…"
                                            Command="{Binding AddFilesCommand}" />
                                    <Button Style="{StaticResource Button.Subtle}" Content="Clear"
                                            Command="{Binding ClearFilesCommand}" />
                                </StackPanel>
                            </ctl:SectionHeader.Aside>
                        </ctl:SectionHeader>
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}"
                                                Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                                Padding="7,4"
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Remove" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Mono}"
                                                   Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- DAT options -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding IsDat, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ctl:SectionHeader Label="POINT OF TANGENCY" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Pot" Content="From file"
                                         IsChecked="{Binding PotFromFile}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Pot" Content="Custom" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0"
                              Visibility="{Binding PotFromFile, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="POT LATITUDE" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource Field}" Tag="e.g. 41.410"
                                         Text="{Binding PotLat, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Label}" Text="POT LONGITUDE" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource Field}" Tag="e.g. -81.850"
                                         Text="{Binding PotLon, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="CLIP DISTANCE FROM CENTRE (NM)" Margin="0,0,0,5" />
                        <TextBox Style="{StaticResource Field}" Tag="blank = no clip" MaxWidth="200" HorizontalAlignment="Left"
                                 Text="{Binding ClipDistanceNm, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- output + convert -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="OUTPUT" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding SingleLine}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Single-line GeoJSON" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Condense output to one line to keep CRC uploads small." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="Convert"
                            Command="{Binding ConvertCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Reset" Margin="10,0,0,0"
                            Command="{Binding ResetCommand}" />
                    <Border Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Chip.Text}" Text="{Binding ResultMessage}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
