<!--
    CredentialEditorWindow  -  add or edit one credential. The secret goes in a PasswordBox that is
    never filled from a saved value: a saved password or token is never shown again.
-->
<ctl:ChromeWindow x:Class="FeBuddy.Wpf.Views.CredentialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
        xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Body}"
        Background="{StaticResource Brush.Bg.Base}">

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontFamily="{StaticResource Font.Display}" FontSize="17.5" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text.Primary}" />

            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Name" Margin="0,16,0,6" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. ZOB GitHub"
                     MaxLength="{x:Static vm:CredentialEditorViewModel.MaxNameLength}" />

            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Type" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Name" />

            <StackPanel Visibility="{Binding IsUsernamePassword, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="User name" Margin="0,14,0,6" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{Binding SecretLabel}" Margin="0,14,0,6" />
            <PasswordBox x:Name="SecretBox" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SecretHint}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding IsGitHubToken, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                           Text="{Binding Source={x:Static vm:CredentialEditorViewModel.GitHubTokenAdvice}}" />
                <Button Style="{StaticResource Button.Subtle}" Content="Create a token on GitHub"
                        HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding CreateGitHubTokenCommand}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                    <Hyperlink Command="{Binding OpenGitHubTokenGuideCommand}" Foreground="{StaticResource Brush.Accent}"
                               ToolTip="Opens FE-Buddy's guide on GitHub, in your browser.">
                        Step-by-step guide: which settings to choose on GitHub
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Use only with these websites" Margin="0,14,0,6" />
            <TextBox Text="{Binding HostsText, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. github.com, example.com" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{Binding Source={x:Static vm:CredentialEditorViewModel.HostsDescription}}" />

            <TextBlock Style="{StaticResource Text.Prose}" Margin="0,14,0,0"
                       Foreground="{StaticResource Brush.Danger}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="Save" Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</ctl:ChromeWindow>
