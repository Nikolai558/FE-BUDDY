<!--
    DashboardView  -  "at a glance" landing screen.
    Left: hero card + KPI tiles.  Right: status / recent output / news cards.
    All bound values are sample data from DashboardViewModel.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="640">

    <UserControl.Resources>
        <!-- one readiness row -->
        <DataTemplate x:Key="StatusRowTemplate" DataType="{x:Type m:StatusRow}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{StaticResource Brush.Text.Tertiary}" />
                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body.Strong}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Ok">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Positive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pending">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one output file row -->
        <DataTemplate x:Key="OutputRowTemplate" DataType="{x:Type m:OutputFile}">
            <DockPanel Margin="0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Text.Caption}"
                           Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Mono}"
                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28" MaxWidth="1180" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- ======================= LEFT COLUMN ======================= -->
                <StackPanel Grid.Column="0">

                    <!-- hero -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <Border Style="{StaticResource Chip.Accent}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Chip.Text}"
                                           Foreground="{StaticResource Brush.Accent.Text}"
                                           Text="{Binding HeroKicker}" />
                            </Border>

                            <TextBlock Style="{StaticResource Text.Display}" Margin="0,14,0,0"
                                       Text="{Binding HeroTitle}" />

                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0" MaxWidth="540"
                                       HorizontalAlignment="Left" Text="{Binding HeroBody}" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="Run AIRAC update" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Conversions" Margin="10,0,0,0" />
                                <Button Style="{StaticResource Button.Subtle}" Content="Open output folder" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KPI tiles -->
                    <ctl:SectionHeader Label="OVERVIEW" Margin="2,22,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ctl:StatTile Grid.Row="0" Grid.Column="0" Glyph="&#xE81E;"
                                      Value="1,204" Caption="Airways in current cycle" />
                        <ctl:StatTile Grid.Row="0" Grid.Column="2" Glyph="&#xE896;"
                                      Value="3 files" Caption="Written on the last run" />
                        <ctl:StatTile Grid.Row="2" Grid.Column="0" Glyph="&#xE707;"
                                      Value="ROI on" Caption="ZOB boundary + 150 nm" />
                        <ctl:StatTile Grid.Row="2" Grid.Column="2" Glyph="&#xE945;"
                                      Value="v3.0-dev" Caption="Up to date" />
                    </Grid>
                </StackPanel>

                <!-- ======================= RIGHT COLUMN ====================== -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ctl:SectionHeader Label="GENERATOR STATUS" />
                            <ItemsControl ItemsSource="{Binding GeneratorStatus}"
                                          ItemTemplate="{StaticResource StatusRowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <ctl:SectionHeader Label="RECENT OUTPUT">
                                <ctl:SectionHeader.Aside>
                                    <Button Style="{StaticResource Button.Subtle}" Content="Open folder" />
                                </ctl:SectionHeader.Aside>
                            </ctl:SectionHeader>
                            <ItemsControl ItemsSource="{Binding RecentOutput}"
                                          ItemTemplate="{StaticResource OutputRowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <ctl:SectionHeader Label="NEWS" />
                            <TextBlock Style="{StaticResource Text.H2}" Text="{Binding NewsTitle}" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{Binding NewsBody}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Open news"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
