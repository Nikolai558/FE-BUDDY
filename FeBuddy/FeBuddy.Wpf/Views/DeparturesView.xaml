<!--
    DeparturesView  -  the Departures sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.DeparturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DeparturesViewModel}"
             d:DesignWidth="900" d:DesignHeight="1600">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ outputs ============ -->
            <cards:OutputsCard GeojsonDescription="Map files for each departure, in a folder per airport. Pick which files below."
                               AliasDescription="Writes a command for each departure at each airport that shows all of its fixes on the scope.&#xA;Type . then the airport, the departure and f, Ex: .laxDOTSSf" />

            <!-- ============ area: the ARTCCs, an ROI, or everything ============ -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which departures to include. Obstacle departures and the amendment date below still apply."
                            ArtccsDescription="only departures in the ARTCCs you tick"
                            RoiDescription="only departures inside an ROI"
                            EverythingDescription="every departure in the cycle">
                <cards:AreaCard.ArtccsContent>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Text="ARTCCs appear once the selected cycle's data is loaded."
                                   Visibility="{Binding HasArtccs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding Artccs}" IsEnabled="{Binding IsCycleReady}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ArtccToggle}">
                                    <CheckBox Content="{Binding Artcc}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Clear" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Command="{Binding ClearArtccsCommand}"
                                Visibility="{Binding HasArtccs, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </cards:AreaCard.ArtccsContent>
                <cards:AreaCard.RoiContent>
                    <StackPanel Margin="0,16,0,0">
                        <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Which Departures the ROI Keeps" />
                        <RadioButton GroupName="DepartureRoiMode" Content="Every departure from an airport inside the ROI" Margin="0,6,0,0"
                                     IsChecked="{Binding RoiModeAirport, Mode=TwoWay}" />
                        <RadioButton GroupName="DepartureRoiMode" Content="Any departure with a fix inside the ROI" Margin="0,3,0,0"
                                     IsChecked="{Binding RoiModeWaypoint, Mode=TwoWay}" />
                    </StackPanel>
                </cards:AreaCard.RoiContent>
            </cards:AreaCard>

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard LinesDescription="`*_Lines.geojson`&#xA;Departure routes drawn as lines."
                                    SymbolsDescription="`*_Symbols.geojson`&#xA;Departure waypoint symbols."
                                    TextDescription="`*_Text.geojson`&#xA;Departure waypoint ID text."
                                    Footnote="Files go in `Geojson\&lt;ARTCC&gt;\&lt;airport&gt;\` in the cycle's folder, named &lt;airport&gt;_&lt;departure&gt;_Lines, _Symbols and _Text." />

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ procedures ============ -->
            <ctl:Card Header="Procedures" Outputs="Alias, Geojson">
                <StackPanel>
                    <CheckBox Content="Include obstacle departures (ODPs)" IsChecked="{Binding IncludeObstacleDepartures}" Margin="0,4,0,0" />

                    <!-- Amendment-date filter. One radio per mode; each mode's input is live only
                         while its radio is checked, and keeps its value when another is picked. -->
                    <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Amendment Date" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,2"
                               Text="Keep only the departures amended recently. A departure's amendment date is the day its current version took effect." />
                    <RadioButton GroupName="DepartureAmendment" Content="Any amendment date" Margin="0,6,0,0"
                                 ToolTip="Every departure, however long ago it was last amended."
                                 IsChecked="{Binding AmendmentAny, Mode=TwoWay}" />
                    <WrapPanel Margin="0,6,0,0">
                        <RadioButton GroupName="DepartureAmendment" Content="Amended within the last" VerticalAlignment="Center"
                                     ToolTip="Only departures amended in the selected cycle or the ones just before it. 1 is the selected cycle only, 2 adds the cycle before it, and so on."
                                     IsChecked="{Binding AmendmentByCycles, Mode=TwoWay}" />
                        <TextBox Style="{StaticResource Field.Number}"
                                 IsEnabled="{Binding AmendmentByCycles}"
                                 Text="{Binding AmendedWithinCycles, UpdateSourceTrigger=PropertyChanged}"
                                 bhv:FieldState.Error="{Binding FieldErrors[AmendedWithinCycles]}" />
                        <TextBlock Text="cycles" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <TextBlock Text="(1 = the selected cycle)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <RadioButton GroupName="DepartureAmendment" Content="Amended within the last" VerticalAlignment="Center"
                                     ToolTip="Only departures amended in this many days, counting back from today."
                                     IsChecked="{Binding AmendmentByDays, Mode=TwoWay}" />
                        <TextBox Style="{StaticResource Field.Number}"
                                 IsEnabled="{Binding AmendmentByDays}"
                                 Text="{Binding AmendedWithinDays, UpdateSourceTrigger=PropertyChanged}"
                                 bhv:FieldState.Error="{Binding FieldErrors[AmendedWithinDays]}" />
                        <TextBlock Text="days" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <RadioButton GroupName="DepartureAmendment" Content="Amended on or after" VerticalAlignment="Center"
                                     ToolTip="Only departures amended on this date or later."
                                     IsChecked="{Binding AmendmentByDate, Mode=TwoWay}" />
                        <DatePicker Width="160" Margin="8,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding AmendmentByDate}"
                                    SelectedDate="{Binding AmendedOnOrAfter, Mode=TwoWay}" SelectedDateFormat="Short"
                                    bhv:FieldState.Error="{Binding FieldErrors[AmendedOnOrAfter]}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,8,0,0"
                               Text="Cycles count back from the cycle on the General tab. Ex: with 2610 selected, the last 4 cycles are 2607 to 2610, so a departure last amended in 2606 is left out. Days count back from today." />
                </StackPanel>
            </ctl:Card>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard LinesTitle="Departures — Lines" SymbolsTitle="Departures — Symbols" TextTitle="Departures — Text">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
