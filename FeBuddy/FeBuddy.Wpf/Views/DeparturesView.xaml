<!--
    DeparturesView  -  the Departures sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Review come from the tab host's shared action
    bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.DeparturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DeparturesViewModel}"
             d:DesignWidth="900" d:DesignHeight="1600">

    <UserControl.Resources>
        <!-- CRC ERAM DEFAULTS panels. Each kind (Lines / Symbols / Text) is its own bordered
             panel listing its properties top to bottom, label on the left and control on the
             right. The control column is a fixed width rather than Auto or star: the page fills
             the window, and an Auto column sizes to whatever is selected, so the boxes of the
             three panels would all end up different widths. The per-field ToolTips are worded
             from the settings validator - keep them verbatim. -->
        <Style x:Key="EramPanel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- property name on the left of a CRC panel row -->
        <Style x:Key="EramFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>

        <!-- xOffset / yOffset box. The hint is a Style setter, not a local ToolTip, so the
             implicit TextBox style's error trigger can still swap in the validation message
             ("Must be a whole number, ...") - a local value would always win over it. -->
        <Style x:Key="EramOffsetBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ToolTip" Value="Any whole number of pixels. 0 for none." />
        </Style>

        <!-- one message group. Heading already carries the count ("Warning (3)"), so there
             is no separate count on the right. -->
        <DataTemplate x:Key="MessageGroup" DataType="{x:Type m:SubServiceMessageGroup}">
            <Border Margin="0,4" Padding="10" CornerRadius="{StaticResource Radius.Chip}"
                    Background="{StaticResource Brush.Bg.Sunken}">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Body.Strong}" />
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside (theme fixes P3a).
         A second scroller stole the wheel and hid the lower sections. -->
    <StackPanel>

            <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"
                       MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />

            <!-- ============ outputs ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SectionHeader Label="OUTPUTS" />
                    <CheckBox Content="GeoJSON files" IsChecked="{Binding GenerateGeojson}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="Writes the departure procedure GeoJSON files selected below." />
                    <CheckBox Content="Alias file (Departures.txt)" IsChecked="{Binding GenerateAliasFile}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="Writes one alias command per airport and procedure that draws the procedure's points." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="At least one output must stay on. To produce nothing for Departures, deselect Departures on the General tab." />
                </StackPanel>
            </Border>

            <!-- ============ which GeoJSON files ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding GenerateGeojson}">
                <StackPanel>
                    <ctl:SectionHeader Label="WHAT FILES DO YOU WANT?" />
                    <CheckBox Content="Lines" IsChecked="{Binding EmitLines}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="One line feature per airport and procedure, shared segments drawn once." />
                    <CheckBox Content="Symbols" IsChecked="{Binding EmitSymbols}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="One symbol per point on the procedure." />
                    <CheckBox Content="Text" IsChecked="{Binding EmitText}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="A label per point showing its identifier." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Files are written to Departure Procedures\&lt;ARTCC&gt;\&lt;airport&gt;\ as &lt;airport&gt;_&lt;procedure&gt;_Lines/Symbols/Text.geojson." />
                </StackPanel>
            </Border>

            <!-- ============ procedures ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="PROCEDURES" />
                    <CheckBox Content="Include obstacle departures (ODPs)" IsChecked="{Binding IncludeObstacleDepartures}" Margin="0,4,0,0" />

                    <TextBlock Text="ARTCCs" Style="{StaticResource Text.Label}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Pick the ARTCCs whose departures you want. Leave all unticked to include every ARTCC." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="ARTCCs appear once the selected cycle's data is loaded."
                               Visibility="{Binding HasArtccs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Artccs}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ArtccToggle}">
                                <CheckBox Content="{Binding Artcc}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Clear" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding ClearArtccsCommand}"
                            Visibility="{Binding HasArtccs, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ============ FE-Buddy properties ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="FE-BUDDY PROPERTIES" />
                    <CheckBox Content="Include FE-Buddy Properties, when available."
                              IsChecked="{Binding IncludeFebCustomProperties}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding FebPropertiesDescription}" Style="{StaticResource Text.Prose}"
                               Margin="20,4,0,0" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding IncludeFebCustomProperties}">
                        <ItemsControl ItemsSource="{Binding FebProperties}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:DepartureFebPropertyToggle}">
                                    <CheckBox Content="{Binding JsonKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding Description}" Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ CRC ERAM defaults ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="CRC ERAM DEFAULTS" />
                    <!-- Lines | Symbols | Text side by side; the WrapPanel stacks them when the
                         window is too narrow for all three, so no panel is ever clipped. A panel
                         shows only while its file is being produced (picked above). Its Include box
                         decides whether that file gets the CRC ERAM defaults; unticked, the fields
                         grey out but keep their values. Each Grid's DataContext is its defaults
                         row, so its IsEnabled reaches back to the view model through the UserControl. -->
                    <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource EramPanel}" Visibility="{Binding EmitLines, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcLineDefaults}" Margin="16,0,0,0" />
                                    <TextBlock Text="DEPARTURES — LINES" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid DataContext="{Binding LineDefaults[0]}"
                                      IsEnabled="{Binding DataContext.IncludeCrcLineDefaults, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Filters" Style="{StaticResource EramFieldLabel}" />
                                    <ctl:FilterPicker Grid.Row="0" Grid.Column="1" Margin="0,3" Value="{Binding Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding FiltersError}" />
                                    <TextBlock Grid.Row="1" Text="BCG" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding BcgOptions}" SelectedItem="{Binding Bcg}"
                                              infra:FieldState.Error="{Binding BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <TextBlock Grid.Row="2" Text="Style" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding Style}"
                                              infra:FieldState.Error="{Binding StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <TextBlock Grid.Row="3" Text="Thickness" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding Thickness}"
                                              infra:FieldState.Error="{Binding ThicknessError}"
                                              ToolTip="Thickness: an integer 1–3." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EramPanel}" Visibility="{Binding EmitSymbols, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcSymbolDefaults}" Margin="16,0,0,0" />
                                    <TextBlock Text="DEPARTURES — SYMBOLS" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid DataContext="{Binding SymbolDefaults[0]}"
                                      IsEnabled="{Binding DataContext.IncludeCrcSymbolDefaults, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Filters" Style="{StaticResource EramFieldLabel}" />
                                    <ctl:FilterPicker Grid.Row="0" Grid.Column="1" Margin="0,3" Value="{Binding Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding FiltersError}" />
                                    <TextBlock Grid.Row="1" Text="BCG" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding BcgOptions}" SelectedItem="{Binding Bcg}"
                                              infra:FieldState.Error="{Binding BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <TextBlock Grid.Row="2" Text="Style" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding Style}"
                                              infra:FieldState.Error="{Binding StyleError}"
                                              ToolTip="Style: see the CRC GeoJSON concepts for the allowed values per kind." />
                                    <TextBlock Grid.Row="3" Text="Size" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding Size}"
                                              infra:FieldState.Error="{Binding SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EramPanel}" Visibility="{Binding EmitText, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="Include" IsChecked="{Binding IncludeCrcTextDefaults}" Margin="16,0,0,0" />
                                    <TextBlock Text="DEPARTURES — TEXT" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid DataContext="{Binding TextDefaults[0]}"
                                      IsEnabled="{Binding DataContext.IncludeCrcTextDefaults, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Filters" Style="{StaticResource EramFieldLabel}" />
                                    <ctl:FilterPicker Grid.Row="0" Grid.Column="1" Margin="0,3" Value="{Binding Filters, Mode=TwoWay}"
                                                      infra:FieldState.Error="{Binding FiltersError}" />
                                    <TextBlock Grid.Row="1" Text="BCG" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding BcgOptions}" SelectedItem="{Binding Bcg}"
                                              infra:FieldState.Error="{Binding BcgError}"
                                              ToolTip="BCG group: an integer 1–40." />
                                    <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding Size}"
                                              infra:FieldState.Error="{Binding SizeError}"
                                              ToolTip="Size: an integer 1–4." />
                                    <TextBlock Grid.Row="3" Text="Opaque" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" ItemsSource="{Binding YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding Opaque}"
                                              infra:FieldState.Error="{Binding OpaqueError}"
                                              ToolTip="Opaque: Yes or No." />
                                    <TextBlock Grid.Row="4" Text="Underline" Style="{StaticResource EramFieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,3" ItemsSource="{Binding YesNoOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding Underline}"
                                              infra:FieldState.Error="{Binding UnderlineError}"
                                              ToolTip="Underline: Yes or No." />
                                    <TextBlock Grid.Row="5" Text="X offset" Style="{StaticResource EramFieldLabel}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding XOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding XOffsetError}" />
                                    <TextBlock Grid.Row="6" Text="Y offset" Style="{StaticResource EramFieldLabel}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,3" Style="{StaticResource EramOffsetBox}"
                                             Text="{Binding YOffset, UpdateSourceTrigger=PropertyChanged}"
                                             infra:FieldState.Error="{Binding YOffsetError}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============ region of interest ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <ctl:SectionHeader Label="REGION OF INTEREST" />
                    <CheckBox Content="Use a region of interest" IsChecked="{Binding UseRoi}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="20,4,0,0"
                               Text="Off: every departure procedure in NASR. On: only the departures the region selects, for both the GeoJSON and the alias file." />
                    <StackPanel Margin="20,10,0,0" IsEnabled="{Binding UseRoi}">
                        <RadioButton GroupName="DepartureRoiMode" Content="Every departure for an airport inside the region"
                                     IsChecked="{Binding RoiModeAirport, Mode=TwoWay}" />
                        <RadioButton GroupName="DepartureRoiMode" Content="Any departure with a point inside the region" Margin="0,3,0,0"
                                     IsChecked="{Binding RoiModeWaypoint, Mode=TwoWay}" />

                        <CheckBox Content="Override the default ROI for Departures" IsChecked="{Binding OverrideRoi}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding RoiFallbackHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="20,4,0,0"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Visibility="{Binding OverrideRoi, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <StackPanel Margin="20,8,0,0" IsEnabled="{Binding OverrideRoi}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="NE lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox Grid.Column="1" Margin="0,0,12,4" Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}"
                                         infra:FieldState.Error="{Binding FieldErrors[NeLat]}" />
                                <TextBlock Grid.Column="2" Text="NE lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox Grid.Column="3" Margin="0,0,0,4" Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}"
                                         infra:FieldState.Error="{Binding FieldErrors[NeLon]}" />
                                <TextBlock Grid.Row="1" Text="SW lat" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}"
                                         infra:FieldState.Error="{Binding FieldErrors[SwLat]}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="SW lon" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}"
                                         infra:FieldState.Error="{Binding FieldErrors[SwLon]}" />
                            </Grid>
                            <Button Content="Pick on map…" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Command="{Binding PickRoiOnMapCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ run result panel ============ -->
            <!-- A full run writes thousands of GeoJSON files, so only their count is shown;
                 "Open output folder" opens the Departure Procedures folder. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding ShowPanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ctl:SectionHeader Label="LAST RUN" />

                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding RunFailed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Run failed" Style="{StaticResource Text.Body.Strong}" Foreground="{StaticResource Brush.Danger}" />
                        <TextBlock Text="{Binding RunError}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding RunSucceeded, Converter={StaticResource BoolToVis}}">
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,18,0"
                                       Text="{Binding AirportProcedureCount, StringFormat={}{0} airport procedure(s)}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,18,0"
                                       Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding SkippedForMissingPointsCount, StringFormat={}{0} skipped for missing points}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ElapsedText}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding GeojsonFileCount, StringFormat={}{0} GeoJSON file(s) written}" />

                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding HasAliasFile, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding AliasCommandCount, StringFormat=Departures.txt · {0} alias command(s)}" />

                        <!-- warnings/errors expanded; info collapsed behind a count (3.8) -->
                        <ItemsControl ItemsSource="{Binding MessageGroups}" ItemTemplate="{StaticResource MessageGroup}" Margin="0,8,0,0"
                                      Visibility="{Binding HasAttentionMessages, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding HasInfoOnly, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Content="{Binding InfoToggleLabel}" Command="{Binding ToggleInfoCommand}" />
                            <ItemsControl ItemsSource="{Binding MessageGroups}" ItemTemplate="{StaticResource MessageGroup}"
                                          Visibility="{Binding IsInfoExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Content="Open output folder" Command="{Binding OpenOutputCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        <Rectangle Height="8" Fill="Transparent" />
    </StackPanel>
</UserControl>
