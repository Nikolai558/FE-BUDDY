<!--
    EramToGeojsonView  -  the ERAM to GeoJSON page on the File Conversions screen.
    Save / Undo come from the screen's (FileConversionsView) action bar, and the screen
    owns the page's single scroller. The Convert card at the foot of the page starts the
    run, and the outcome appears under that card.

    The first three layouts are the original ERAM_2_GEOJSON tool's, named as it named them, and Raw
    Plus is Raw with matching lines joined and symbols grouped; each one's
    tooltip shows the folders and files it writes, in the code font, with the
    ConsoleCommandControl.txt rundown written beside the maps in every layout. Each defaults
    source has a one-line description and a tooltip saying what it does, with an example.

    The radios sit inside ctl:Option wrappers, so each group is tied together by GroupName
    rather than by a shared parent.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.EramToGeojsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EramToGeojsonViewModel}"
             d:DesignWidth="900" d:DesignHeight="1300">

    <UserControl.Resources>
        <!-- A layout's example tree, in the code font. -->
        <Style x:Key="LayoutTree" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- A defaults-source tooltip's paragraphs, and its bullet points (the text hangs off the bullet). -->
        <Style x:Key="TipLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="TipBullet" TargetType="DockPanel">
            <Setter Property="Margin" Value="4,4,0,0" />
        </Style>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the File Conversions screen owns the one page-level scroller. -->
    <StackPanel>

        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,0,0,14" TextWrapping="Wrap"
                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                   bhv:InlineCode.Text="Converts the Geomaps.xml of an ERAM adaptation export into CRC-ready GeoJSON, in an `ERAM_TO_GEOJSON` folder in your output directory. Pick Geomaps.xml, or the unzipped export's folder - only its Geomaps file is converted. When the export's ConsoleCommandControl.xml is beside it, ConsoleCommandControl.txt lists its brightness (BCG) and filter menus: each button's label, position and groups, and which maps use each menu. One Geomaps file per run: everything already in `ERAM_TO_GEOJSON` is deleted first, after you confirm." />

        <cards:AttentionCard />

        <!-- ============ source ============ -->
        <cards:SourceFilesCard />

        <!-- ============ output layout ============ -->
        <ctl:Card Header="Output Layout">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                           MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                           bhv:InlineCode.Text="Each map is named after its GeomapId and button label, e.g. `CENTER_CENTER-MAP`. Hover a layout to see what it writes. ConsoleCommandControl.txt sits beside the maps in every layout." />

                <ctl:Option Margin="0,4,0,0"
                            Description="A folder per set of filters, holding one file each for its lines, symbols and text. The fewest files, with short names.">
                    <RadioButton GroupName="EramLayout" Content="By Filters" IsChecked="{Binding LayoutByFilters, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="1000">
                                <StackPanel>
                                    <TextBlock Text="By Filters" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource LayoutTree}"
                                               Text="ERAM_TO_GEOJSON\&#xA;    CENTER_CENTER-MAP\&#xA;        Filter_01\&#xA;            Filter_01_Lines.geojson&#xA;            Filter_01_Symbols.geojson&#xA;            Filter_01_Text.geojson&#xA;        Filter_04\&#xA;            Filter_04_Lines.geojson&#xA;        Multi-Filter_02_03_08\&#xA;            Multi-Filter_02_03_08_Lines.geojson&#xA;    ConsoleCommandControl.txt" />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
                <ctl:Option Margin="0,10,0,0"
                            Description="A file for everything that looks the same, named after its BCG, filters, object type, map group, line object, style and so on. The most files, and the easiest to pick apart and rename.">
                    <RadioButton GroupName="EramLayout" Content="By Attributes" IsChecked="{Binding LayoutByAttributes, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="1000">
                                <StackPanel>
                                    <TextBlock Text="By Attributes" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource LayoutTree}"
                                               Text="ERAM_TO_GEOJSON\&#xA;    CENTER_CENTER-MAP\&#xA;        BCG 01_Filters 01_Type AAV_Group 64_Object ZOB3NM_Style Solid_Thick 1_Lines.geojson&#xA;        BCG 01_Filters 01_Type SupplementalLine_Group 48_Object AP_EAST_TOOTH_BOX_Style Solid_Thick 1_Lines.geojson&#xA;        BCG 02_Filters 02 03 08_Type SupplementalLine_Group 44_Object AP_PCT_BINNSLUCKE_Style ShortDashed_Thick 1_Lines.geojson&#xA;    ConsoleCommandControl.txt" />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
                <ctl:Option Margin="0,10,0,0"
                            Description="One file per map, one feature per element, each carrying its own properties, and no isDefaults features. The least to set up, and a reference to check the other layouts against.">
                    <RadioButton GroupName="EramLayout" Content="Raw" IsChecked="{Binding LayoutRaw, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="1000">
                                <StackPanel>
                                    <TextBlock Text="Raw" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource LayoutTree}"
                                               Text="ERAM_TO_GEOJSON\&#xA;    CENTER_CENTER-MAP.geojson&#xA;    OCP_OCP-MAPS.geojson&#xA;    ConsoleCommandControl.txt" />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
                <ctl:Option Margin="0,10,0,0"
                            Description="Raw's one file per map, every feature carrying its own properties, but lines that share every property are joined and symbols that share every property are grouped into one feature. Far fewer features than Raw, still nothing to set up.">
                    <RadioButton GroupName="EramLayout" Content="Raw Plus" IsChecked="{Binding LayoutRawPlus, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="1000">
                                <StackPanel>
                                    <TextBlock Text="Raw Plus" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource LayoutTree}"
                                               Text="ERAM_TO_GEOJSON\&#xA;    CENTER_CENTER-MAP.geojson&#xA;    OCP_OCP-MAPS.geojson&#xA;    ConsoleCommandControl.txt" />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
            </StackPanel>
        </ctl:Card>

        <!-- ============ CRC defaults source ============ -->
        <!-- One line under each option; its tooltip says in plain words what it does, with an example. -->
        <ctl:Card Header="CRC ERAM Defaults Source">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                           MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                           Text="Where each line, symbol and label gets its BCG, filters and look. Hover an option to see what it does, with an example." />

                <ctl:Option Margin="0,4,0,0"
                            Description="Use the XML's styling; CRC fills in what's missing or can't be drawn.">
                    <RadioButton GroupName="EramDefaults" Content="From the XML" IsChecked="{Binding DefaultsFromXml, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="460">
                                <StackPanel>
                                    <TextBlock Text="From the XML" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource TipLine}" Text="Use the styling in Geomaps.xml, the way ERAM has it." />
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="Each group's defaults are used, plus any value a single item sets for itself." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap"
                                                   bhv:InlineCode.Text="If the XML leaves a value out, or has one CRC can't draw, FE-Buddy leaves it blank and CRC uses its own fallback: BCG 1, `solid` lines, `vor` symbols, size 1." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="Anything with no filters at all shows at every filter setting (filter 0)." />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource TipLine}"
                                               bhv:InlineCode.Text="Example: `DME` symbols are drawn as `vor`. SAA lines, which have no BCG or filters in the XML, get BCG 1 and show at every filter setting." />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
                <ctl:Option Margin="0,10,0,0"
                            Description="Use the XML's styling; the card fills in what's missing or can't be drawn.">
                    <RadioButton GroupName="EramDefaults" Content="From the XML, filling gaps from the card" IsChecked="{Binding DefaultsFromXmlThenCard, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="460">
                                <StackPanel>
                                    <TextBlock Text="From the XML, filling gaps from the card" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource TipLine}"
                                               Text="The same as From the XML, except the CRC ERAM Defaults card below fills the gaps instead of CRC." />
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="Everything the XML does have is kept." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="Anything it leaves out, or has that CRC can't draw, comes from the card - filters included." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="A panel with Include unticked isn't used; CRC fills that kind's gaps, as in From the XML." />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource TipLine}"
                                               bhv:InlineCode.Text="Example: with the card's symbol style set to `tacan`, `DME` symbols become `tacan` instead of `vor`. SAA lines get the card's BCG and filters." />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
                <ctl:Option Margin="0,10,0,0"
                            Description="Ignore the XML's styling and use the card below for everything.">
                    <RadioButton GroupName="EramDefaults" Content="From the card only" IsChecked="{Binding DefaultsFromCard, Mode=TwoWay}"
                                 ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                        <RadioButton.ToolTip>
                            <ToolTip MaxWidth="460">
                                <StackPanel>
                                    <TextBlock Text="From the card only" Style="{StaticResource Text.Body.Strong}" />
                                    <TextBlock Style="{StaticResource TipLine}"
                                               Text="Ignore the XML's styling and use the CRC ERAM Defaults card below for everything." />
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="Every line gets the card's Line values, every symbol its Symbol values and every label its Text values - BCG and filters included." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="The XML still supplies where things are and what the labels say." />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource TipBullet}">
                                        <TextBlock Text="•" Margin="0,0,8,0" />
                                        <TextBlock TextWrapping="Wrap" Text="A panel with Include unticked leaves that kind to CRC's fallbacks, shown at every filter setting." />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource TipLine}"
                                               bhv:InlineCode.Text="Example: with the Line panel set to BCG 5, filter 3 and `shortDashed`, every line in every map is BCG 5, filter 3, short-dashed. By Filters then puts all the lines in one `Filter_03` folder." />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </ctl:Option>
            </StackPanel>
        </ctl:Card>

        <!-- ============ CRC ERAM defaults (only while the card is a source) ============ -->
        <cards:CrcDefaultsCard LinesTitle="GeoMap — Lines" SymbolsTitle="GeoMap — Symbols" TextTitle="GeoMap — Text" ShowInclude="True"
                               IncludeLines="{Binding IncludeCrcLineDefaults}" IncludeSymbols="{Binding IncludeCrcSymbolDefaults}"
                               IncludeText="{Binding IncludeCrcTextDefaults}"
                               Note="The look the converted files use: each file's isDefaults feature (By Filters, By Attributes), or every feature's own properties (Raw, Raw Plus). Untick Include on a panel to leave its defaults out." />

        <!-- ============ FE-Buddy properties ============ -->
        <cards:FebPropertiesCard />

        <!-- ============ run ============ -->
        <cards:RunCard Blocker="{Binding RunBlocker}"
                       Note="Unsaved settings are saved before the conversion starts. Everything already in ERAM_TO_GEOJSON is deleted first - you are asked before anything goes." />
    </StackPanel>
</UserControl>
