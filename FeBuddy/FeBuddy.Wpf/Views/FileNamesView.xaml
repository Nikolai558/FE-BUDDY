<!--
    FileNamesView  -  the File Names tab inside the AIRAC Service screen, just before Preview
    Settings: every file the selected sub-services will write, by folder, and - when the user
    chooses Yes - a new name for any of them. Save / Undo / Previous / Next / Preview settings come
    from the tab host's shared action bar, and the tab host owns the page's single scroller.

    The list is read from the other tabs each time this tab is shown - see FileNamesViewModel's
    class remarks. Each row is two lines while renaming is on (the file, then its new-name box), so
    it fits the narrowest window.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.FileNamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FileNamesViewModel}"
             d:DesignWidth="900" d:DesignHeight="900">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. -->
    <StackPanel x:Name="Root">

        <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Caption}"
                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"
                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                   Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />

        <!-- ============ rename or not ============ -->
        <ctl:Card Header="Rename Files">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                           Text="Give any of this run's files a name of your own? A renamed file stays in its folder and keeps its extension - only its name changes." />
                <RadioButton GroupName="RenameFiles" Content="No - every file keeps FE-Buddy's name" Margin="0,3"
                             IsChecked="{Binding RenameFiles, Converter={StaticResource InverseBool}}" />
                <RadioButton GroupName="RenameFiles" Content="Yes - rename some files" Margin="0,3"
                             IsChecked="{Binding RenameFiles}" />
            </StackPanel>
        </ctl:Card>

        <!-- ============ the files ============ -->
        <ctl:Card Header="Output Files">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,4,0,8"
                           MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                           Text="Every file this run writes with the other tabs' settings as they are now, by the folder it goes in. Change a setting on another tab and this list follows. A file is only written when it has something in it." />

                <StackPanel Visibility="{Binding RenameFiles, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Tick a file to rename it, and type its new name without the extension: FE-Buddy adds .geojson, .txt, .md or .json itself. Untick a file to keep FE-Buddy's name. Other tabs still call each file by FE-Buddy's name." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Style="{StaticResource Button.Ghost}" Content="Rename all" Margin="0,0,8,0"
                                ToolTip="Tick every file for renaming." Command="{Binding RenameAllCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Rename none"
                                ToolTip="Untick every file, so each keeps FE-Buddy's name until you tick it." Command="{Binding RenameNoneCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                           Text="The selected sub-services' settings write no files yet."
                           Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:FileNameFolder}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Body.Strong}"
                                           FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                <Border Style="{StaticResource Divider}" />

                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:FileNameRow}">
                                            <StackPanel>
                                                <StackPanel Margin="0,6">
                                                    <!-- the file, ticked for renaming while renaming is on -->
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top"
                                                                Visibility="{Binding DataContext.RenameFiles, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                                            <!-- Hidden, not collapsed, for a file that can't be renamed, so every name lines up. -->
                                                            <CheckBox IsChecked="{Binding Rename}" ToolTip="Rename this file" Margin="0,1,0,0">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanRename}" Value="False">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}"
                                                                       FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- its new name: greyed out while unticked -->
                                                    <StackPanel Margin="26,6,0,0" Visibility="{Binding DataContext.RenameFiles, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                                        <!-- The box takes nearly all the width up to 360, then stops; the
                                                             extension sits right after it, lined up under the file name. -->
                                                        <Grid Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="10*" MaxWidth="360" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Tag="New name, without the extension"
                                                                     IsEnabled="{Binding Rename}" bhv:FieldState.Error="{Binding Error}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Extension}" Style="{StaticResource Text.Body}"
                                                                       FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Style="{StaticResource Divider}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ctl:Card>
    </StackPanel>
</UserControl>
