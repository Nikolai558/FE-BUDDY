<!--
    FixesView  -  the Fixes sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.FixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FixesViewModel}"
             d:DesignWidth="900" d:DesignHeight="1900">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ area: an ROI, or everything ============ -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which fixes to include, in every file. The fix uses and charts below still apply."
                            RoiDescription="only fixes inside an ROI"
                            EverythingDescription="every fix" />

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard ShowLines="False"
                                    SymbolsDescription="`*_Symbols.geojson`&#xA;Fix symbols."
                                    TextDescription="`*_Text.geojson`&#xA;Fix ID text." />

            <!-- ============ file layout ============ -->
            <ctl:Card Header="File Layout" Outputs="Geojson">
                <StackPanel>
                    <ctl:Option Margin="0,4,0,0"
                                Description="`Fix_Symbols.geojson`&#xA;`Fix_Text.geojson`">
                        <RadioButton GroupName="FixOutputBy" Content="All-in-One File"
                                     IsChecked="{Binding OutputAll, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="Examples:&#xA;`Fix_WYPNT_Symbols.geojson`&#xA;`Fix_WYPNT_Text.geojson`&#xA;`Fix_RPRTNG-PNT_Symbols.geojson`&#xA;`Fix_RPRTNG-PNT_Text.geojson`">
                        <RadioButton GroupName="FixOutputBy" Content="One File per Fix Use"
                                     IsChecked="{Binding OutputByFixUse, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="Examples:&#xA;`Fix_ENROUTE-LOW_Symbols.geojson`&#xA;`Fix_ENROUTE-LOW_Text.geojson`&#xA;`Fix_ENROUTE-HIGH_Symbols.geojson`&#xA;`Fix_ENROUTE-HIGH_Text.geojson`&#xA;Note: A fix on several charts goes in each of their files, and fixes on no chart go in the `Fix_NO-CHART` files.">
                        <RadioButton GroupName="FixOutputBy" Content="One File per Chart Type"
                                     IsChecked="{Binding OutputByChart, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="Examples:&#xA;`Fix_ENROUTE-LOW-WYPNT_Symbols.geojson`&#xA;`Fix_ENROUTE-LOW-WYPNT_Text.geojson`&#xA;`Fix_ENROUTE-HIGH-RPRTNG-PNT_Symbols.geojson`&#xA;`Fix_ENROUTE-HIGH-RPRTNG-PNT_Text.geojson`">
                        <RadioButton GroupName="FixOutputBy" Content="One File per Fix Use and Chart Type Combination (you set up below)"
                                     IsChecked="{Binding OutputByCombination, Mode=TwoWay}" />
                    </ctl:Option>
                </StackPanel>
            </ctl:Card>

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ fix uses ============ -->
            <ctl:Card Header="Fix Uses" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[FixUses]}" Visibility="{Binding ShowFixUses, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Tick the fix uses you want a file for." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Fix uses appear once the selected cycle's data is loaded."
                               Visibility="{Binding HasFixUses, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding FixUses}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:FixGroupToggle}">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Tick all" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding TickAllFixUsesCommand}"
                            Visibility="{Binding HasFixUses, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ charts ============ -->
            <ctl:Card Header="Charts" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[Charts]}" Visibility="{Binding ShowCharts, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Tick the charts you want a file for." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Charts appear once the selected cycle's data is loaded."
                               Visibility="{Binding HasCharts, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Charts}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:FixGroupToggle}">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Tick all" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding TickAllChartsCommand}"
                            Visibility="{Binding HasCharts, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ combinations ============ -->
            <ctl:Card Header="Combinations" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[Combinations]}" Visibility="{Binding ShowCombinations, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Each combination gets its own files: the fixes on that chart that have that fix use." />

                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                               Text="No combinations yet."
                               Visibility="{Binding HasCombinations, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding Combinations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:FixCombinationItem}">
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EditCombinationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteCombinationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding FileNames}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- editor row -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsEditingCombination, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Chart" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox MinWidth="200" ItemsSource="{Binding ChartOptions}"
                                          SelectedItem="{Binding SelectedChartOption}" />
                            </StackPanel>
                            <TextBlock Text="+" Style="{StaticResource Text.Prose}" VerticalAlignment="Bottom" Margin="10,0,10,8" />
                            <StackPanel>
                                <TextBlock Text="Fix use" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox MinWidth="160" ItemsSource="{Binding FixUseOptions}"
                                          SelectedItem="{Binding SelectedFixUseOption}" />
                            </StackPanel>
                            <Button Content="{Binding ConfirmCombinationText}" Style="{StaticResource Button.Primary}"
                                    Margin="16,0,0,0" VerticalAlignment="Bottom" Command="{Binding ConfirmCombinationCommand}" />
                            <Button Content="Cancel" Style="{StaticResource Button.Ghost}"
                                    Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding CancelCombinationCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CombinationEditorHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Foreground="{StaticResource Brush.Danger}"
                                   Visibility="{Binding CombinationEditorHint, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Button Content="Add combination" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding AddCombinationCommand}"
                            Visibility="{Binding IsEditingCombination, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard SymbolsTitle="Fixes — Symbols" TextTitle="Fixes — Text">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
