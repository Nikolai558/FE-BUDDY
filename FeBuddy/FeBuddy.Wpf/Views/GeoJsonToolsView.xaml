<!--
    GeoJsonToolsView  -  validate a CRC GeoJSON against the ERAM/STARS schema,
    or run a clean-up pass. Findings and sizes are sample data.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.GeoJsonToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GeoJsonToolsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="760">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Text.H1}" Text="GeoJSON Tools" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="Check any CRC GeoJSON before upload, or tidy one up." />

                <!-- mode + file -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Mode" Content="Validate"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Validate}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Mode" Content="Clean up"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Cleanup}" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Choose GeoJSON…"
                                    Command="{Binding ChooseFileCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="FILE" />
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding FileName}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- VALIDATE -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding IsValidate, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ctl:SectionHeader Label="VALIDATE">
                            <ctl:SectionHeader.Aside>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Schema" Content="ERAM"
                                                 IsChecked="{Binding TargetEram}" />
                                    <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Schema" Content="STARS" Margin="0" />
                                </StackPanel>
                            </ctl:SectionHeader.Aside>
                        </ctl:SectionHeader>

                        <Border Style="{StaticResource Chip.Accent}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Chip.Text}" Foreground="{StaticResource Brush.Accent.Text}"
                                       Text="{Binding FindingsSummary}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{StaticResource Brush.Info}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Text.Body}"
                                                   Foreground="{StaticResource Brush.Text.Primary}" Margin="11,0,10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Where}" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warn">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Warn}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" Margin="0,12" />
                        <Button Style="{StaticResource Button.Primary}" Content="Re-validate" HorizontalAlignment="Left"
                                Command="{Binding ValidateCommand}" />
                    </StackPanel>
                </Border>

                <!-- CLEAN UP -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding IsValidate, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <StackPanel>
                        <ctl:SectionHeader Label="CLEAN UP" />
                        <ItemsControl ItemsSource="{Binding CleanupOps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                                      Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding Enabled}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body.Strong}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" Margin="0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Clean up"
                                    Command="{Binding CleanupCommand}" />
                            <TextBlock Text="{Binding SizeBeforeAfter}" Style="{StaticResource Text.Mono}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
