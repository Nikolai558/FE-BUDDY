<!--
    InfoView  -  real resource links only (remediation plan Phase 10), laid out
    as a card grid (theme fixes P8): the old single ~280px card left most of the
    page empty and read as unfinished.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InfoViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="500">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- pinned page header (P4) -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
            <TextBlock Text="Info" Style="{StaticResource Text.Display}" Margin="28,24,28,14" />
            <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,16,28,28">

                <ctl:SectionHeader Label="Resources" />

                <ItemsControl ItemsSource="{Binding Resources}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InfoViewModel+Resource}">
                            <ctl:Card Width="330" Height="176" Margin="0,0,16,16">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                                            Style="{StaticResource Button.Subtle}" Padding="0,4,0,0"
                                            Foreground="{StaticResource Brush.Accent}"
                                            Content="Open →"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Url}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" />
                                        <TextBlock Text="{Binding Blurb}" Style="{StaticResource Text.Prose}"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </ctl:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
