<!--
    InfoView  -  real resource links only (remediation plan Phase 10).
-->
<UserControl x:Class="FeBuddy.Wpf.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InfoViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="500">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="720" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Text.H1}" Text="Info" />

                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="RESOURCES" />
                        <ItemsControl ItemsSource="{Binding Resources}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InfoViewModel+Resource}">
                                    <DockPanel Margin="0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                                                Content="Open"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Url}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body.Strong}" />
                                            <TextBlock Text="{Binding Blurb}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
