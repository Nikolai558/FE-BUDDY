<!--
    InfoView  -  the What's New in v3.0? page and links to the manual, change log and issue
    tracker, laid out as a card grid so the page fills its width. What's New opens in place of
    the cards (WhatsNewView), with a way back.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:views="clr-namespace:FeBuddy.Wpf.Views"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InfoViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="500">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:WhatsNewViewModel}">
            <views:WhatsNewView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg.Base}">

        <!-- the cards, shown while What's New is closed -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WhatsNew}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- pinned page header -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
                <TextBlock Text="Info" Style="{StaticResource Text.Display}" Margin="28,24,28,14" />
                <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,16,28,28">

                    <ctl:SectionHeader Label="Resources" />

                    <ItemsControl ItemsSource="{Binding Resources}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InfoViewModel+Resource}">
                                <ctl:Card Width="330" Height="176" Margin="0,0,16,16">
                                    <!-- What's New is set apart in amber, like Card.Accent -->
                                    <ctl:Card.Style>
                                        <Style TargetType="ctl:Card" BasedOn="{StaticResource {x:Type ctl:Card}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFeatured}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Line}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ctl:Card.Style>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                                                Style="{StaticResource Button.Subtle}" Padding="0,4,0,0"
                                                Foreground="{StaticResource Brush.Accent}"
                                                Content="Open →"
                                                Command="{Binding Open}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" />
                                            <TextBlock Text="{Binding Blurb}" Style="{StaticResource Text.Prose}"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </ctl:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- What's New, in place of the cards while it is open -->
        <ContentControl Content="{Binding WhatsNew}" Focusable="False" />
    </Grid>
</UserControl>
