<!--
    MapView  -  the Map Service page: the shared map workspace, editing the saved default ROI.
    Every map popup hosts the same MapWorkspace, so there is one map screen to maintain.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:views="clr-namespace:FeBuddy.Wpf.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MapViewModel}"
             d:DesignWidth="1200" d:DesignHeight="800">

    <views:MapWorkspace />
</UserControl>
