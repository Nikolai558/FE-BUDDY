<!--
    NavaidsView  -  the NAVAIDs sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.NavaidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NavaidsViewModel}"
             d:DesignWidth="900" d:DesignHeight="1700">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ area: an ROI, or everything ============ -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which NAVAIDs the GeoJSON includes. The NAVAID types below still apply."
                            RoiDescription="only NAVAIDs inside an ROI"
                            EverythingDescription="every operational NAVAID">
                <cards:AreaCard.Footer>
                    <ctl:OutputLine Kind="Alias" Text="Every operational NAVAID, whichever you pick above." Margin="0,14,0,0" />
                </cards:AreaCard.Footer>
            </cards:AreaCard>

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard ShowLines="False"
                                    SymbolsDescription="`*_Symbols.geojson`&#xA;NAVAID symbols."
                                    TextDescription="`*_Text.geojson`&#xA;Each NAVAID's ID, then its name and type on a second line." />

            <!-- ============ file layout ============ -->
            <ctl:Card Header="File Layout" Outputs="Geojson">
                <StackPanel>
                    <ctl:Option Margin="0,4,0,0"
                                Description="`NAVAIDs_Symbols.geojson`&#xA;`NAVAIDs_Text.geojson`">
                        <RadioButton GroupName="NavaidOutputBy" Content="All-in-One File"
                                     IsChecked="{Binding OutputAllInOne, Mode=TwoWay}" />
                    </ctl:Option>
                    <ctl:Option Margin="0,10,0,0"
                                Description="Examples:&#xA;`NAVAIDs_VORTACs_Symbols.geojson`&#xA;`NAVAIDs_VORTACs_Text.geojson`&#xA;`NAVAIDs_TACANs_Symbols.geojson`&#xA;`NAVAIDs_TACANs_Text.geojson`">
                        <RadioButton GroupName="NavaidOutputBy" Content="One File per Type"
                                     IsChecked="{Binding OutputByType, Mode=TwoWay}" />
                    </ctl:Option>
                </StackPanel>
            </ctl:Card>

            <!-- ============ FE-Buddy properties ============ -->
            <cards:FebPropertiesCard />

            <!-- ============ NAVAID types ============ -->
            <ctl:Card Header="NAVAID Types" Outputs="Geojson" bhv:FieldState.Error="{Binding FieldErrors[NavaidTypes]}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Select the NAVAID types you want.&#xA;Note: These types apply to the GeoJSON only. The alias file always has every type." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="NAVAID types appear once the selected cycle's data is loaded."
                               Visibility="{Binding HasTypes, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Types}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:NavaidTypeToggle}">
                                <CheckBox Content="{Binding Type}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Tick all" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding TickAllTypesCommand}"
                            Visibility="{Binding HasTypes, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ symbol style ============ -->
            <ctl:Card Header="NAVAID Symbol Style" Outputs="Geojson" Visibility="{Binding ShowSymbolStyleChoice, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Which CRC symbol each NAVAID is drawn with." />
                    <RadioButton GroupName="NavaidSymbolStyle" Margin="0,3,0,0"
                                 Content="By NAVAID type"
                                 IsChecked="{Binding StyleByNavaidType, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,4"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="VOR, VORTAC, VOR/DME and VOT use vor, TACAN and DME use tacan, and NDBs use ndb. The CRC ERAM Defaults card then skips the Symbols style." />
                    <RadioButton GroupName="NavaidSymbolStyle" Margin="0,3,0,0"
                                 Content="The same symbol for every NAVAID, set on the CRC ERAM Defaults card below"
                                 IsChecked="{Binding StyleForWholeFile, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding ShowFanMarkerStyle, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Fan marker style" Style="{StaticResource Text.FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox MinWidth="160" ItemsSource="{Binding FanMarkerStyleOptions}" SelectedItem="{Binding FanMarkerStyle}"
                                  bhv:FieldState.Error="{Binding FieldErrors[FanMarkerStyle]}"
                                  ToolTip="CRC has no fan marker symbol. Pick the one fan markers are drawn with." />
                    </StackPanel>
                </StackPanel>
            </ctl:Card>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard SymbolsTitle="NAVAIDs — Symbols" TextTitle="NAVAIDs — Text">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
