<!--
    ProceduresView  -  the Procedures sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.

    Unlike the GeoJSON sub-service tabs, this one writes no GeoJSON and has no FE-Buddy
    properties or CRC cards - see ProceduresViewModel's class remarks. Its Outputs card shows its
    three outputs' state (they are turned on and off on the General tab). The selection cards
    pick what the two documents cover, so they grey out while neither document is on, and say
    they don't reach the chart recall alias file while it's on. An amber card at the top says
    when a d-TPP Metafile falls short.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.ProceduresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProceduresViewModel}"
             d:DesignWidth="900" d:DesignHeight="2600">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ the d-TPP Metafiles, only while one falls short ============ -->
            <ctl:Card Style="{StaticResource Card.Warn}"
                      Visibility="{Binding DtppWarning, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding DtppWarning}" Style="{StaticResource Text.Prose}" />
            </ctl:Card>

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ outputs ============ -->
            <ctl:Card Header="Outputs">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="Turn these on or off in the General tab." />
                    <cards:OutputStatusRow Kind="ProcedureChanges" Label="Procedure_Changes.md" IsOn="{Binding GenerateChangesDocument}"
                                           Description="A Discord-post-ready Markdown document of the procedures added, changed, or deleted this cycle at the selected airports. Grouped by facility and airspace class, with links to the FAA's comparison PDFs for most." />
                    <cards:OutputStatusRow Margin="0,12,0,0" Kind="ProceduresJson" Label="Procedures.json" IsOn="{Binding GenerateProceduresJson}"
                                           Description="Ready for your scripts to read, this JSON contains every current chart at the selected airports, with the fields you choose below." />
                    <cards:OutputStatusRow Margin="0,12,0,0" Kind="Alias" Label="Faa_Chart_Recall.txt" IsOn="{Binding GenerateAliasFile}"
                                           Description="Writes an `.openurl` command for most charts in the d-TPP Metafile.&#xA;For example:" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="66,2,0,0"
                               bhv:InlineCode.Text="`.dtwI22Lc` opens the &quot;ILS OR LOC RWY 22L&quot; approach chart for DTW airport." />
                </StackPanel>
            </ctl:Card>

            <!-- ============ area: the facilities, an ROI, everything, or none ============ -->
            <cards:AreaCard Outputs="{Binding AreaOutputs}"
                            Intro="Choose which airports the documents cover."
                            ArtccsLabel="Facilities"
                            ArtccsDescription="charts for airports within the facilities you tick"
                            RoiDescription="charts for airports within an ROI"
                            EverythingDescription="charts for every airport in the d-TPP metafile"
                            NoneDescription="only what you list in the cards below">
                <cards:AreaCard.ArtccsContent>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Text="Facilities appear once the selected cycle's data is loaded."
                                   Visibility="{Binding HasFacilities, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding Facilities}" IsEnabled="{Binding IsCycleReady}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ArtccToggle}">
                                    <CheckBox Content="{Binding Artcc}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </cards:AreaCard.ArtccsContent>
                <cards:AreaCard.Footer>
                    <StackPanel>
                        <TextBlock Text="{Binding AreaNote}" Style="{StaticResource Text.Prose}" Margin="0,14,0,0"
                                   Visibility="{Binding AreaNote, Converter={StaticResource StringToVis}}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                                   bhv:InlineCode.Text="{x:Static vm:ProceduresViewModel.ChartRecallNote}"
                                   Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </cards:AreaCard.Footer>
            </cards:AreaCard>

            <!-- ============ airports ============
                 This card and the next two add to the area, even outside it. With Everything, which
                 already has every airport, they aren't used: they grey out, keeping their lists. -->
            <ctl:Card Header="Airports" Outputs="ProcedureChanges, ProceduresJson" bhv:FieldState.Error="{Binding FieldErrors[DocumentSelection]}"
                      IsEnabled="{Binding AreListsUsed}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding AreListsUsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock Text="{x:Static vm:ProceduresViewModel.ListsUnusedNote}" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding AreListsUsed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0" bhv:InlineCode.Text="{Binding AirportsIntro}" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="{Binding Source={x:Static vm:ProceduresViewModel.MaxAirports}, StringFormat='Type or paste up to {0} FAA/ICAO IDs and press ENTER or ADD.'}" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,10"
                                   Text="You will then get data for that airport and all of its relevant procedures." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Airports}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.DeleteAirportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The box fills the card up to a readable width and wraps a long list; a pasted
                         column of IDs arrives as one line (bhv:PasteOnOneLine). What Add can't take
                         stays in the box, with a line per reason under it. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="460" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewAirportText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" Tag="e.g. KCLE, CAK, DTW" bhv:PasteOnOneLine.IsEnabled="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddAirportCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Add" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                VerticalAlignment="Top" Command="{Binding AddAirportCommand}" />
                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                VerticalAlignment="Top" Command="{Binding ClearAirportTextCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding NewAirportHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Foreground="{StaticResource Brush.Danger}"
                               Visibility="{Binding NewAirportHint, Converter={StaticResource StringToVis}}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                               bhv:InlineCode.Text="{x:Static vm:ProceduresViewModel.ChartRecallNote}"
                               Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ additional airport-specific procedures ============ -->
            <ctl:Card Header="Additional Airport-Specific Procedures to Include" Outputs="ProcedureChanges, ProceduresJson" bhv:FieldState.Error="{Binding FieldErrors[DocumentSelection]}"
                      IsEnabled="{Binding AreListsUsed}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding AreListsUsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock Text="{x:Static vm:ProceduresViewModel.ListsUnusedNote}" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding AreListsUsed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0" bhv:InlineCode.Text="{Binding AirportProceduresIntro}" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="Press ADD PROCEDURE, type an airport first, then pick a departure or arrival for that airport, and press ADD." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="If a procedure serves multiple airports, only the version for the specified airport is included." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,10"
                                   Text="{x:Static vm:ProceduresViewModel.RenumberNote}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Airport-specific procedures need the cycle's d-TPP metafile, which isn't available yet."
                               Visibility="{Binding HasDtppData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                               Text="No airport-specific procedures yet."
                               Visibility="{Binding HasAirportProcedures, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding AirportProcedures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureAirportPickItem}">
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EditPairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeletePairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" />
                                            <!-- What it brings in from the cycle picked, or that it brings in nothing. -->
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource StringToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- editor row -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsEditingPair, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Airport" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <TextBox MinWidth="120" Text="{Binding PairAirportText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Text="+" Style="{StaticResource Text.Prose}" VerticalAlignment="Bottom" Margin="10,0,10,8" />
                            <StackPanel>
                                <TextBlock Text="Procedure" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox MinWidth="220" ItemsSource="{Binding PairProcedureOptions}"
                                          SelectedItem="{Binding SelectedPairProcedure}" />
                            </StackPanel>
                            <Button Content="{Binding ConfirmPairText}" Style="{StaticResource Button.Primary}"
                                    Margin="16,0,0,0" VerticalAlignment="Bottom" Command="{Binding ConfirmPairCommand}" />
                            <Button Content="Cancel" Style="{StaticResource Button.Ghost}"
                                    Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding CancelPairCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PairAirportName}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding PairAirportName, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding PairEditorHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.Danger}"
                                   Visibility="{Binding PairEditorHint, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Button Content="Add procedure" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding AddPairCommand}"
                            Visibility="{Binding IsEditingPair, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                               bhv:InlineCode.Text="{x:Static vm:ProceduresViewModel.ChartRecallNote}"
                               Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ additional procedures ============ -->
            <ctl:Card Header="Additional Procedures to Include" Outputs="ProcedureChanges, ProceduresJson" bhv:FieldState.Error="{Binding FieldErrors[DocumentSelection]}"
                      IsEnabled="{Binding AreListsUsed}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding AreListsUsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock Text="{x:Static vm:ProceduresViewModel.ListsUnusedNote}" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding AreListsUsed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0" bhv:InlineCode.Text="{Binding ProcedureNamesIntro}" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0" Text="Type or pick a departure or arrival, and press ENTER or ADD." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="If a procedure serves multiple airports, all versions of the procedure are included." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,10"
                                   Text="{x:Static vm:ProceduresViewModel.RenumberNote}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Procedure names appear once the cycle's d-TPP metafile is available."
                               Visibility="{Binding HasDtppData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding ProcedureNameRows}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureNameRow}">
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.DeleteProcedureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Name}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                            <!-- What it brings in from the cycle picked, or that it brings in nothing. -->
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource StringToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasDtppData}">
                        <ComboBox MinWidth="240" IsEditable="True" IsTextSearchEnabled="True"
                                  Tag="Type or pick a procedure"
                                  ItemsSource="{Binding ProcedureNameOptions}"
                                  Text="{Binding NewProcedureText, UpdateSourceTrigger=PropertyChanged}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <ComboBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddProcedureCommand}" />
                            </ComboBox.InputBindings>
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <Button Content="Add" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding AddProcedureCommand}" />
                        <Button Content="Cancel" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                Command="{Binding CancelProcedureCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NewProcedureHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Danger}"
                               Visibility="{Binding NewProcedureHint, Converter={StaticResource StringToVis}}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                               bhv:InlineCode.Text="{x:Static vm:ProceduresViewModel.ChartRecallNote}"
                               Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ chart types ============ -->
            <ctl:Card Header="Chart Types" Outputs="ProcedureChanges, ProceduresJson" bhv:FieldState.Error="{Binding FieldErrors[ChartTypes]}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,4,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               bhv:InlineCode.Text="{Binding ChartTypesIntro}" />
                    <ItemsControl ItemsSource="{Binding ChartTypeToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureOptionToggle}">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               bhv:InlineCode.Text="{x:Static vm:ProceduresViewModel.ChartRecallNote}"
                               Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ Procedures.json fields ============ -->
            <ctl:Card Header="Procedures.json Fields" Outputs="ProceduresJson" Visibility="{Binding GenerateProceduresJson, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               bhv:InlineCode.Text="Select the following fields to be included in the `Procedures.json` file.&#xA;&#xA;Note: The FAA airport IDs and procedure names are always included." />
                    <ItemsControl ItemsSource="{Binding JsonFieldToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureOptionToggle}">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:Card>

    </StackPanel>
</UserControl>
