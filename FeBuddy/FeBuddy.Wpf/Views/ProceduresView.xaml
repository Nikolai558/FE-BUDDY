<!--
    ProceduresView  -  the Procedures sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.

    Unlike every other AIRAC sub-service tab, this one writes no GeoJSON and has no FE-Buddy
    properties or CRC cards - see ProceduresViewModel's class remarks. Its Upload to vNAS card
    offers only the alias file, so it shows only while the alias file is on. The selection cards
    pick what the two documents cover, so they grey out while neither document is on.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.ProceduresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProceduresViewModel}"
             d:DesignWidth="900" d:DesignHeight="2600">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"
                       MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />

            <!-- ============ outputs ============ -->
            <ctl:Card Header="Outputs">
                <StackPanel>
                    <CheckBox Content="Procedure_Changes.md" IsChecked="{Binding GenerateChangesDocument}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="24,2,0,10"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="A briefing of every added, changed and deleted procedure at the airports you pick, grouped by facility, busiest airspace first, with links to the FAA's compare PDFs and charts." />
                    <CheckBox Content="Procedures.json" IsChecked="{Binding GenerateProceduresJson}" Margin="0,0,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="24,2,0,10"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Every current chart at the airports you pick, with the fields chosen below." />
                    <CheckBox Content="Alias file (FAA_CHART_RECALL.txt)" IsChecked="{Binding GenerateAliasFile}" Margin="0,0,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="24,2,0,10"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="FAA Chart Recall: a command that opens each page of every chart at every airport in the d-TPP metafile, e.g. .dtwI22Lc for ILS OR LOC RWY 22L at DTW. The choices below pick what the documents cover; they never limit the alias file." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="The documents are written to Publication_Docs\ in the cycle's folder, and the alias file to Aliases\ (or Upload_to_vNAS\, if ticked below)." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="At least one output must stay on. To produce nothing for Procedures, deselect Procedures on the General tab." />
                </StackPanel>
            </ctl:Card>

            <!-- ============ d-TPP data ============ -->
            <ctl:Card Header="d-TPP Data">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,4,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Procedures come from the FAA's d-TPP metafile for the selected cycle, which the FAA posts 15–18 days before the cycle's effective date. FE-Buddy downloads it at launch." />
                    <TextBlock Text="{Binding DtppStatus}" TextWrapping="Wrap" Margin="0,0,0,4"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDtppKnown}" Value="True" />
                                            <Condition Binding="{Binding HasDtppData}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DtppPreviousStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Visibility="{Binding DtppPreviousStatus, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ facilities ============ -->
            <ctl:Card Header="Facilities" IsEnabled="{Binding GeneratesDocument}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Include every airport these ARTCCs are responsible for." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Facilities appear once the selected cycle's data is loaded."
                               Visibility="{Binding HasFacilities, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Facilities}" IsEnabled="{Binding IsCycleReady}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ArtccToggle}">
                                <CheckBox Content="{Binding Artcc}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding PrimaryFacilityCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ airports ============ -->
            <ctl:Card Header="Airports" IsEnabled="{Binding GeneratesDocument}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Include every procedure at these airports." />

                    <ItemsControl ItemsSource="{Binding Airports}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.DeleteAirportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <TextBox MinWidth="140" Text="{Binding NewAirportText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding AddAirportCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NewAirportHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Danger}"
                               Visibility="{Binding NewAirportHint, Converter={StaticResource StringToVis}}" />

                    <CheckBox Content="Also include every airport inside the region of interest (set below)"
                              IsChecked="{Binding IncludeRoiAirports}" Margin="0,12,0,0" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ procedures at any airport ============ -->
            <ctl:Card Header="Procedures at Any Airport" IsEnabled="{Binding GeneratesDocument}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Include a procedure wherever it appears, e.g. a STAR that serves several airports." />

                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Procedure names appear once the cycle's d-TPP metafile is available."
                               Visibility="{Binding HasDtppData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding ProcedureNames}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.DeleteProcedureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasDtppData}">
                        <ComboBox MinWidth="240" IsEditable="True" IsTextSearchEnabled="True"
                                  ItemsSource="{Binding ProcedureNameOptions}"
                                  Text="{Binding NewProcedureText, UpdateSourceTrigger=PropertyChanged}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <Button Content="Add" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding AddProcedureCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NewProcedureHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Danger}"
                               Visibility="{Binding NewProcedureHint, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ airport + procedure ============ -->
            <ctl:Card Header="Airport + Procedure" IsEnabled="{Binding GeneratesDocument}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Include one procedure at one airport." />

                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Airport + procedure pairs need the cycle's d-TPP metafile, which isn't available yet."
                               Visibility="{Binding HasDtppData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                               Text="No pairs yet."
                               Visibility="{Binding HasAirportProcedures, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding AirportProcedures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureAirportPickItem}">
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EditPairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeletePairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- editor row -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsEditingPair, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Airport" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <TextBox MinWidth="120" Text="{Binding PairAirportText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Text="+" Style="{StaticResource Text.Prose}" VerticalAlignment="Bottom" Margin="10,0,10,8" />
                            <StackPanel>
                                <TextBlock Text="Procedure" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox MinWidth="220" ItemsSource="{Binding PairProcedureOptions}"
                                          SelectedItem="{Binding SelectedPairProcedure}" />
                            </StackPanel>
                            <Button Content="{Binding ConfirmPairText}" Style="{StaticResource Button.Primary}"
                                    Margin="16,0,0,0" VerticalAlignment="Bottom" Command="{Binding ConfirmPairCommand}" />
                            <Button Content="Cancel" Style="{StaticResource Button.Ghost}"
                                    Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding CancelPairCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PairAirportName}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding PairAirportName, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding PairEditorHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.Danger}"
                                   Visibility="{Binding PairEditorHint, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Button Content="Add procedure" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding AddPairCommand}"
                            Visibility="{Binding IsEditingPair, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ chart types ============ -->
            <ctl:Card Header="Chart Types" IsEnabled="{Binding GeneratesDocument}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,4,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Which charts to include for whole airports (facilities, airports and the region). Procedures you pick by name are always included." />
                    <ItemsControl ItemsSource="{Binding ChartTypeToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureOptionToggle}">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:Card>

            <!-- ============ Procedures.json fields ============ -->
            <ctl:Card Header="Procedures.json Fields" Visibility="{Binding GenerateProceduresJson, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               Text="Airport ID and procedure name are always included." />
                    <ItemsControl ItemsSource="{Binding JsonFieldToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ProcedureOptionToggle}">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:Card>

            <!-- ============ region of interest ============ -->
            <cards:RoiOverrideCard IsEnabled="{Binding GeneratesDocument}">
                <cards:RoiOverrideCard.AdditionalContent>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,14,0,0" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Used only when 'Also include every airport inside the region of interest' is ticked under Airports." />
                </cards:RoiOverrideCard.AdditionalContent>
            </cards:RoiOverrideCard>

            <!-- ============ upload to vNAS (the alias file only) ============ -->
            <cards:VnasUploadCard Visibility="{Binding GenerateAliasFile, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
