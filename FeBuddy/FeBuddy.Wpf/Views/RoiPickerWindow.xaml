<!--
    RoiPickerWindow  -  a map popup. It hosts the same MapWorkspace as the Map page (same layers,
    same tools), opened in ROI editing mode on the region the caller passed in. Saving or
    cancelling in the ROI card closes it.
-->
<ctl:ChromeWindow x:Class="FeBuddy.Wpf.Views.RoiPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
        xmlns:views="clr-namespace:FeBuddy.Wpf.Views"
        Title="Region of Interest"
        Width="1280" Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="900" MinHeight="600"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Body}"
        Background="{StaticResource Brush.Bg.Base}">

    <views:MapWorkspace x:Name="Workspace" />
</ctl:ChromeWindow>
