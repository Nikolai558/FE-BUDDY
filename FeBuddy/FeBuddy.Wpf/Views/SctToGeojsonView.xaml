<!--
    SctToGeojsonView  -  the SCT2 to GeoJSON page on the File Conversions screen.
    Save / Undo come from the screen's (FileConversionsView) action bar, and the screen
    owns the page's single scroller. The Convert card at the foot of the page starts the
    run, and the outcome appears under that card.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.SctToGeojsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SctToGeojsonViewModel}"
             d:DesignWidth="900" d:DesignHeight="900">

    <!-- No ScrollViewer here: the File Conversions screen owns the one page-level scroller. -->
    <StackPanel>

        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,0,0,14"
                   bhv:InlineCode.Text="Converts VRC sector files (`.sct2` or `.sct`) into CRC-ready GeoJSON.&#xA;&#xA;Each sector file gets a folder, named after it, in the `SCT2 to GeoJSON` folder of your output directory. It holds the file's ARTCC boundaries, airways, GEO, labels, and regions, and a file for each SID and STAR diagram." />

        <cards:AttentionCard />

        <!-- ============ source ============ -->
        <cards:SourceFilesCard />

        <!-- ============ CRC ERAM defaults ============ -->
        <cards:CrcDefaultsCard LinesTitle="Sector File — Lines" TextTitle="Sector File — Labels" ShowInclude="True"
                               IncludeLines="{Binding IncludeCrcLineDefaults}" IncludeText="{Binding IncludeCrcTextDefaults}"
                               Note="The values written as the isDefaults feature at the top of each converted file. Untick Include on a panel to leave its defaults out." />

        <!-- ============ run ============ -->
        <cards:RunCard Blocker="{Binding RunBlocker}"
                       Note="Unsaved settings are saved before the conversion starts. Existing files with the same name are replaced." />
    </StackPanel>
</UserControl>
