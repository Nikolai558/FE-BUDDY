<!--
    ServicePreviewTabView  -  the Preview Settings tab of a tabbed service: a plain rundown
    of every other tab's settings, and the button that runs the service. What happens
    during the run is shown on the Review tab (ServiceRunReviewTabView).
-->
<UserControl x:Class="FeBuddy.Wpf.Views.ServicePreviewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             xmlns:tabm="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:ServicePreviewTabViewModel}"
             d:DesignWidth="820" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- one label / value line -->
        <DataTemplate x:Key="ReviewRow" DataType="{x:Type tabm:ServicePreviewRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body.Strong}"
                           TextWrapping="Wrap"
                           MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left" />
            </Grid>
        </DataTemplate>

        <!-- one tab's section -->
        <DataTemplate x:Key="ReviewSection" DataType="{x:Type tabm:ServicePreviewSection}">
            <ctl:Card Header="{Binding Title}">
                <StackPanel>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Prose}"
                               Margin="0,0,0,6"
                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ReviewRow}" />
                </StackPanel>
            </ctl:Card>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller. -->
    <StackPanel>

        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,0,0,14"
                   Text="Everything this run will do, at a glance. Change anything by going back to its tab." />

        <!-- something is invalid: the run is blocked until it is fixed -->
        <ctl:Card Style="{StaticResource Card.Danger}"
                  Visibility="{Binding HasBlockingIssue, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BlockingIssue}" Style="{StaticResource Text.Prose}" />
        </ctl:Card>

        <!-- something is unsaved: the run saves it first (settings-save contract) -->
        <ctl:Card Style="{StaticResource Card.Warn}"
                  Visibility="{Binding HasUnsavedNotice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding UnsavedNotice}" Style="{StaticResource Text.Prose}" />
        </ctl:Card>

        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource ReviewSection}" />

        <!-- run -->
        <cards:RunCard Note="Unsaved settings are saved before the run starts." />
    </StackPanel>
</UserControl>
