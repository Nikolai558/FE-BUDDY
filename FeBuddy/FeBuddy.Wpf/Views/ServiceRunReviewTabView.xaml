<!--
    ServiceRunReviewTabView  -  the Review tab: everything about what happened when the
    service was run. It appears at the very end of the rail once a run has started, and shows
    how far each sub-service has got, anything that went wrong, the advisories, each
    sub-service's results with its warnings and routine notices (each collapsed behind a toggle,
    in groups that can each be copied), and the way out to the files. The sub-service tabs hold
    settings only. File Conversions has no Review tab: it shows this same content under a
    conversion's Run card.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.ServiceRunReviewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             xmlns:tabs="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs"
             xmlns:tabm="clr-namespace:FeBuddy.Wpf.ViewModels.ServiceTabs.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabs:ServiceRunReviewTabViewModel}"
             d:DesignWidth="820" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- the status word, coloured by where the step has got to; Waiting keeps the default -->
        <Style x:Key="RunStepStatusText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Positive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- one sub-service's line in the feed -->
        <DataTemplate x:Key="RunStepRow" DataType="{x:Type tabm:RunStep}">
            <StackPanel Margin="0,4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                               Style="{StaticResource RunStepStatusText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body.Strong}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock bhv:InlineCode.Text="{Binding Detail, Converter={StaticResource FileNamesAsCode}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                           Margin="0,2,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource StringToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- one error or advisory line. Here and in the message groups, a name or value between
             backticks shows in the code look (bhv:InlineCode), and so does every file name
             (FileNamesAsCode). -->
        <DataTemplate x:Key="ErrorRow">
            <TextBlock bhv:InlineCode.Text="{Binding Converter={StaticResource FileNamesAsCode}}" Style="{StaticResource Text.Prose}" Margin="0,3" />
        </DataTemplate>

        <!-- An expanded message list shows each group as a panel: its heading row (a severity, or
             e.g. an airway ID, with the count and a copy button for every message in the group),
             then its message rows, the last closing the panel. Rows, not nested lists, so the list
             can be virtualized: a run can report thousands of messages, and only those on screen
             are built. -->
        <DataTemplate DataType="{x:Type tabm:SubServiceMessageGroup}">
            <Border Margin="0,4,0,0" Padding="10,10,10,4" CornerRadius="{StaticResource Radius.Chip.Top}"
                    Background="{StaticResource Brush.Bg.Sunken}">
                <DockPanel>
                    <ctl:CopyButton DockPanel.Dock="Right" Style="{StaticResource Copy.Button}" VerticalAlignment="Center"
                                    Margin="6,0,0,0" Value="{Binding CopyText}" ToolTip="{Binding CopyToolTip}"
                                    ToolTipService.InitialShowDelay="200" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0} msg}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body.Strong}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type tabm:SubServiceMessageRow}">
            <Border Background="{StaticResource Brush.Bg.Sunken}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="10,4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                <Setter Property="Padding" Value="10,4,10,10" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip.Bottom}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock bhv:InlineCode.Text="{Binding Text, Converter={StaticResource FileNamesAsCode}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <!-- an expanded message list: bounded, with its own scroll bar, so a long list does not
             stretch the page; the wheel passes to the page once the list reaches either end -->
        <Style x:Key="MessageList" TargetType="ItemsControl">
            <Setter Property="MaxHeight" Value="320" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True" bhv:WheelScroll.BubbleUp="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one sub-service's results: what it produced, then its warnings and its routine
             notices, each behind a toggle, collapsed on every run -->
        <DataTemplate x:Key="SubServiceResultBlock" DataType="{x:Type tabm:SubServiceRunResult}">
            <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body.Strong}" />
                <TextBlock bhv:InlineCode.Text="{Binding Summary, Converter={StaticResource FileNamesAsCode}}" Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />

                <StackPanel Margin="0,6,0,0" Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Foreground="{StaticResource Brush.Warn}"
                            Content="{Binding AttentionToggleLabel}" Command="{Binding ToggleAttentionCommand}" />
                    <ItemsControl ItemsSource="{Binding AttentionRows}" Style="{StaticResource MessageList}"
                                  Visibility="{Binding IsAttentionExpanded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Margin="0,6,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Content="{Binding InfoToggleLabel}" Command="{Binding ToggleInfoCommand}" />
                    <ItemsControl ItemsSource="{Binding InfoRows}" Style="{StaticResource MessageList}"
                                  Visibility="{Binding IsInfoExpanded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No ScrollViewer here: the host (the tab host, or the File Conversions screen) owns the one page-level scroller. -->
    <StackPanel>

        <!-- how far each sub-service has got -->
        <ctl:Card Header="Progress">
            <StackPanel>

                <TextBlock bhv:InlineCode.Text="{Binding Summary, Converter={StaticResource FileNamesAsCode}}" Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding Summary, Converter={StaticResource StringToVis}}" />

                <TextBlock Text="In progress…" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource RunStepRow}" />
            </StackPanel>
        </ctl:Card>

        <!-- something failed, in any sub-service -->
        <ctl:Card Header="Errors"
                  Style="{StaticResource Card.Danger}"
                  Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Errors}" ItemTemplate="{StaticResource ErrorRow}" />
            </StackPanel>
        </ctl:Card>

        <!-- advisories: output the user would expect but won't find, and why -->
        <ctl:Card Header="Advisories"
                  Style="{StaticResource Card.Warn}"
                  Visibility="{Binding HasAdvisories, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Advisories}" ItemTemplate="{StaticResource ErrorRow}" />
            </StackPanel>
        </ctl:Card>

        <!-- the run finished and reported nothing: say so rather than showing an empty review -->
        <ctl:Card>
            <ctl:Card.Style>
                <Style TargetType="ctl:Card" BasedOn="{StaticResource {x:Type ctl:Card}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasRun}" Value="True" />
                                <Condition Binding="{Binding HasErrors}" Value="False" />
                                <Condition Binding="{Binding HasAdvisories}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ctl:Card.Style>
            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                       Text="The run finished with no errors." />
        </ctl:Card>

        <!-- what each sub-service produced, with its warnings and routine notices -->
        <ctl:Card Header="Results" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource SubServiceResultBlock}" />
            </StackPanel>
        </ctl:Card>

        <!-- what the run wrote -->
        <ctl:Card Header="Output" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <!-- The folder, then the count, not a list: a Departures run alone writes thousands
                     of files, and the folder shows them better. -->
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,4"
                           bhv:InlineCode.Text="{Binding OutputDirectory, StringFormat=`{0}`}"
                           Visibility="{Binding OutputDirectory, Converter={StaticResource StringToVis}}" />
                <TextBlock Style="{StaticResource Text.Caption}">
                    <Run Text="{Binding FilesWrittenCount, Mode=OneWay, StringFormat={}{0:N0} file(s) written in }" /><Run Text="{Binding ElapsedText, Mode=OneWay}" />
                </TextBlock>

                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Content="Open output folder" Command="{Binding OpenOutputFolderCommand}" />
            </StackPanel>
        </ctl:Card>
    </StackPanel>
</UserControl>
