<!--
    SettingsView  -  Settings Profile / Facility / Default ROI / GeoJSON Files / Credentials / FE-Buddy's GitHub
    Requests / Updates / Update Channel / Reset / Uninstall (Reset FE-Buddy… with Uninstall FE-Buddy… under it),
    and, in a dev launch only, Developer: Launch Steps.
    Everything persists to the settings profile in use but the credentials, which go to Windows Credential Manager,
    and the Developer card, which goes to DevLaunch.json.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="820">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- pinned page header: title stays put while the body scrolls -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
            <TextBlock Text="Settings" Style="{StaticResource Text.Display}" Margin="28,24,28,14" />
            <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
        </Grid>

        <!-- pinned action bar: subtitle on the left; dirty indicator, Import / Export and Save grouped on the right -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Bg.Base}">
            <DockPanel Margin="28,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Warn}" Text="Unsaved changes" Margin="0,0,12,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Import…" Margin="0,0,8,0"
                            Command="{Binding ImportCommand}"
                            ToolTip="Bring in a settings file someone exported: as a new profile, added to the profile in use, or in place of its settings. Their folders are moved into your own user folders and only used where they work on this PC; your update channel stays as it is." />
                    <Button Style="{StaticResource Button.Ghost}" Content="Export…" Margin="0,0,8,0"
                            Command="{Binding ExportCommand}"
                            ToolTip="Save every setting in the profile in use to a file you can share. Folders under your Desktop, Documents or user folder are written so they work on another PC; settings that only apply to this PC are left out." />
                    <Button Style="{StaticResource Button.Primary}" Content="Save"
                            Command="{Binding SaveCommand}" MinWidth="90" />
                </StackPanel>
                <TextBlock Text="Preferences for this installation, saved to the settings profile in use."
                           Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      bhv:WheelScroll.Amplify="3">
            <StackPanel Margin="28,34,28,8">

                <!-- ================= 0. SETTINGS PROFILE ================= -->
                <!-- Takes effect at once: not part of this page's Save. Choosing another profile switches to it. -->
                <ctl:Card Header="Settings Profile" DataContext="{Binding SettingsProfile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0"
                                   Text="A &quot;Profile&quot; is a set of FE-Buddy settings:" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="16,2,0,0"
                                   Text="Facility&#xA;Output folder&#xA;Every service's choices and preferences&#xA;File Conversions&#xA;Map settings&#xA;etc." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="It is suggested that you keep a profile for each facility you work on and/or a profile for each type of AIRAC cycle data you wish to run.&#xA;For example, some facilities will want Airways, Fixes, and NAVAIDs GeoJSON files only once every couple of months, while they will want the alias commands every AIRAC cycle. This facility would create two different profiles." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="Shared across profiles:" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="16,2,0,12"
                                   Text="Update channel&#xA;News posts you have read&#xA;FE-Buddy's GitHub token&#xA;Your saved credentials" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Ghost}" Content="New…" Margin="8,0,0,0"
                                        ToolTip="Make a profile - from a copy of this one, or every default - and switch to it."
                                        Command="{Binding NewCommand}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Rename…" Margin="8,0,0,0"
                                        ToolTip="Give the profile in use another name."
                                        Command="{Binding RenameCommand}" />
                                <Button Style="{StaticResource Button.Ghost.Danger}" Content="Delete…" Margin="8,0,0,0"
                                        ToolTip="Switch to another profile, then delete this one."
                                        Command="{Binding DeleteCommand}" />
                            </StackPanel>
                            <ComboBox Style="{StaticResource Themed.ComboBox}" Width="300" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      ToolTip="The profile in use. Choose another to switch to it." />
                        </DockPanel>
                        <TextBlock bhv:InlineCode.Text="{Binding FileNote}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 1. FACILITY ================= -->
                <ctl:Card Header="Facility">
                    <StackPanel>

                        <TextBlock Style="{StaticResource Text.Prose}"
                                   Text="{Binding FacilityWaitingMessage}" Margin="0,4,0,0"
                                   Visibility="{Binding FacilitiesReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        <StackPanel Visibility="{Binding FacilitiesReady, Converter={StaticResource BoolToVis}}">
                            <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Facility" Margin="0,4,0,4" />
                            <ComboBox Style="{StaticResource Themed.ComboBox}"
                                      ItemsSource="{Binding Facilities}"
                                      SelectedValuePath="ArtccId" SelectedValue="{Binding SelectedFacility}"
                                      Width="300" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Default Output Directory" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Browse…"
                                    Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding AddFeBuddyOutputFolder}" Margin="0,8,0,0">
                            <TextBlock bhv:InlineCode.Text="Add a `FE-Buddy_Output` folder inside this selected directory" />
                        </CheckBox>
                        <TextBlock bhv:InlineCode.Text="{Binding OutputFolderExample}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 2. DEFAULT REGION OF INTEREST ================= -->
                <ctl:Card Header="Default Region of Interest">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.RoiExplainer}}"
                                   Style="{StaticResource Text.Prose}" Margin="0,4,0,10" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Clear"
                                    Command="{Binding ClearRoiCommand}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Set ROI…"
                                    Command="{Binding EditRoiCommand}" MinWidth="110" />
                            <!-- the corners in the code look, or (in amber) that none is set and how to set one -->
                            <TextBlock Text="{Binding DefaultRoiSummary}" VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDefaultRoi}" Value="False">
                                                <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 3. GEOJSON FILES ================= -->
                <ctl:Card Header="GeoJSON Files">
                    <StackPanel>

                        <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Maximum Coordinate Precision" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.CoordinatePrecisionDescription}}"
                                   Style="{StaticResource Text.Prose}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Precision" Content="5 dp" Margin="0,0,16,0" ToolTip="General object references."
                                         IsChecked="{Binding IsPrecision5, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="5" />
                            <RadioButton GroupName="Precision" Content="6 dp" Margin="0,0,16,0" ToolTip="Airport layout tracing / CAB-like files."
                                         IsChecked="{Binding IsPrecision6, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="6" />
                            <RadioButton GroupName="Precision" Content="7 dp" Margin="0,0,16,0" ToolTip="High-precision navigation and airport tracing."
                                         IsChecked="{Binding IsPrecision7, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="7" />
                            <RadioButton GroupName="Precision" Content="Do not round"
                                         IsChecked="{Binding IsNoRounding, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="0">
                                <RadioButton.ToolTip>
                                    <ToolTip MaxWidth="360">
                                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.NoRoundingToolTip}}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </RadioButton.ToolTip>
                            </RadioButton>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="File Layout" />
                        <ctl:Option Margin="0,6,0,0" Description="Significantly smaller file sizes&#xA;Preferred if a human is not expected to read it">
                            <RadioButton GroupName="FileLayout" Content="Single line"
                                         IsChecked="{Binding PrettyPrintGeojson, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                        </ctl:Option>
                        <ctl:Option Margin="0,8,0,0" Description="Significantly larger file sizes&#xA;Preferred if a human is expected to read it">
                            <RadioButton GroupName="FileLayout" Content="Pretty-print"
                                         IsChecked="{Binding PrettyPrintGeojson, Mode=TwoWay}" />
                        </ctl:Option>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0"
                                   Text="This setting applies to all GeoJSON files output by FE-Buddy." />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.Warn}"
                                   Text="Developer mode is on, so GeoJSON is pretty printed whatever is chosen here."
                                   Visibility="{Binding IsDevModeForcingPrettyPrint, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 4. CREDENTIALS ================= -->
                <!-- Saved at once, in Windows Credential Manager: not part of this page's Save. -->
                <ctl:Card Header="Credentials" DataContext="{Binding Credentials}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0"
                                   Text="You may provide sign-in credentials that FE-Buddy may use to download files from protected websites, such as private GitHub repositories.&#xA;This is helpful for retrieving your custom alias files to merge with FE-Buddy's aliases, in preparation for upload to vNAS Admin." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0">
                            <Run Text="FE-Buddy does " /><Run Text="NOT" FontWeight="SemiBold" /><Run Text=" keep these passwords or credentials, but rather passes them to your Windows Credential Manager (WCM), encrypted with your Windows sign-in." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0">
                            <Run Text="This data is " /><Run Text="NEVER" FontWeight="SemiBold" /><Run Text=":" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="16,2,0,0"
                                   Text="Saved in a settings profile&#xA;Exported in a file&#xA;Sent anywhere but the websites you allow for it" />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,8"
                                   Text="A saved password or token is never shown again after you paste it here. Changes here are saved straight away." />

                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                                   Foreground="{StaticResource Brush.Danger}" Text="{Binding LoadError}"
                                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,8" Text="No credentials yet."
                                   Visibility="{Binding HasCredentials, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel Margin="0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.Ghost}" Content="{Binding CheckLabel}" Margin="8,0,0,0"
                                                        ToolTip="Ask GitHub whether this token still works."
                                                        Visibility="{Binding CanCheck, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Button.Ghost}" Content="Edit…" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Button.Ghost}" Content="Remove" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Details}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Add credential…"
                                    Command="{Binding AddCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Remove all" Margin="8,0,0,0"
                                    ToolTip="Remove every FE-Buddy credential from this PC."
                                    Command="{Binding RemoveAllCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 5. FE-BUDDY'S GITHUB REQUESTS (advanced) ================= -->
                <!-- Part of this page's Save: only the chosen token's id is saved, never the token. -->
                <ctl:Card Header="FE-Buddy's GitHub Requests">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                                   Text="{Binding Source={x:Static vm:SettingsViewModel.GitHubRequestsDescription}}" />

                        <RadioButton GroupName="FeBuddyGitHubToken" Margin="0,3" Content="Don't use a GitHub token"
                                     IsChecked="{Binding DontUseGitHubToken}" />
                        <RadioButton GroupName="FeBuddyGitHubToken" Margin="0,3" Content="Use a GitHub token for update checks, News and update downloads"
                                     IsChecked="{Binding UseGitHubToken}" />

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding UseGitHubToken, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="New GitHub token…" Margin="8,0,0,0"
                                        ToolTip="Add a GitHub token in Credentials and use it here."
                                        Command="{Binding NewGitHubTokenCommand}" />
                                <ComboBox Style="{StaticResource Themed.ComboBox}" ItemsSource="{Binding GitHubTokens}"
                                          SelectedValuePath="Id" SelectedValue="{Binding GitHubCredentialId}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Warn}" Text="{Binding GitHubTokenNotice}"
                                       Visibility="{Binding HasGitHubTokenNotice, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="If a request with the token fails, FE-Buddy tries it once more without it, so an expired token never stops you getting updates. The token only needs read access; FE-Buddy never writes to GitHub." />
                        </StackPanel>
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 6. UPDATES ================= -->
                <!-- Most finished channel first; each one also offers every channel above it. -->
                <ctl:Card Header="Updates / Update Channel">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0"
                                   Text="Choose the earliest stage of releases you want to participate in." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,10">
                            <Run Text="Note:" /><LineBreak />
                            <Run Text="&quot;Beta&quot; and &quot;Alpha&quot; releases should " /><Run Text="NOT" FontWeight="SemiBold" /><Run Text=" be considered methods to gain &quot;Early Access&quot; to features." /><LineBreak />
                            <Run Text="These releases will almost certainly have unknown issues and are meant for development purposes only." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,0,0,8"
                                   Foreground="{StaticResource Brush.Warn}"
                                   Text="{Binding ChannelWarning}"
                                   Visibility="{Binding IsPreReleaseChannel, Converter={StaticResource BoolToVis}}" />
                        <!-- each channel offers the ones above it too; hover one for what its releases are -->
                        <StackPanel>
                            <ctl:Option Margin="0,3" Description="{Binding Source={x:Static vm:SettingsViewModel.StableOffers}}">
                                <RadioButton GroupName="Channel" Content="Stable"
                                             ToolTip="{Binding Source={x:Static vm:SettingsViewModel.StableDescription}}"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Stable}" />
                            </ctl:Option>
                            <ctl:Option Margin="0,3" Description="{Binding Source={x:Static vm:SettingsViewModel.ReleaseCandidateOffers}}">
                                <RadioButton GroupName="Channel" Content="Release Candidate"
                                             ToolTip="{Binding Source={x:Static vm:SettingsViewModel.ReleaseCandidateDescription}}"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=ReleaseCandidate}" />
                            </ctl:Option>
                            <ctl:Option Margin="0,3" Description="{Binding Source={x:Static vm:SettingsViewModel.BetaOffers}}">
                                <RadioButton GroupName="Channel" Content="Beta"
                                             ToolTip="{Binding Source={x:Static vm:SettingsViewModel.BetaDescription}}"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Beta}" />
                            </ctl:Option>
                            <ctl:Option Margin="0,3" Description="{Binding Source={x:Static vm:SettingsViewModel.AlphaOffers}}">
                                <RadioButton GroupName="Channel" Content="Alpha"
                                             ToolTip="{Binding Source={x:Static vm:SettingsViewModel.AlphaDescription}}"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Alpha}" />
                            </ctl:Option>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding CheckNowCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                        <Setter Property="Content" Value="Check for updates now" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingForUpdates}" Value="True">
                                                <Setter Property="Content" Value="Checking…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Content="Open the Releases Page"
                                    Command="{Binding RollbackCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 7. RESET / UNINSTALL ================= -->
                <!-- Last, away from everyday settings. Each window says what goes and asks what to keep.
                     Uninstall works only in the installed copy. -->
                <ctl:Card Header="Reset / Uninstall">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0"
                                   Text="Want to set FE-Buddy up as &quot;New&quot;? Select &quot;Reset FE-Buddy&quot;." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0">
                            <Run Text="Got promoted out of the FE department, or " /><Run Text="somehow" FontWeight="SemiBold" /><Run Text=" found a better resource than FE-Buddy? Select &quot;Uninstall FE-Buddy&quot;." />
                        </TextBlock>
                        <Button Style="{StaticResource Button.Ghost}" Content="Reset FE-Buddy…" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Command="{Binding ResetCommand}" />
                        <!-- Greyed out (UninstallCommand) in a copy the installer didn't install, which says why. -->
                        <Button Style="{StaticResource Button.Ghost.Danger}" Content="Uninstall FE-Buddy…" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Command="{Binding UninstallCommand}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="This copy of FE-Buddy wasn't installed with its installer, so it can't uninstall itself."
                                   Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    </StackPanel>
                </ctl:Card>

                <!-- ================= 8. DEVELOPER (dev launch only) ================= -->
                <!-- Shown only in a dev launch (a Debug build started with dash-dash dev). Saved at once, to
                     DevLaunch.json beside the profiles: not part of this page's Save, a profile or an export. -->
                <ctl:Card Header="Developer: Launch Steps" DataContext="{Binding DevLaunch}"
                          Visibility="{Binding DataContext.IsDevLaunch, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0"
                                   Text="The launch steps a dev launch runs. Unticked, it skips them. A normal launch always runs every step." />
                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,8" FontWeight="SemiBold"
                                   Text="Takes effect the next time FE-Buddy starts with --dev." />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                                   Text="Changes here are saved straight away." />

                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:DevLaunchStepToggle}">
                                    <ctl:Option Margin="0,3" Description="{Binding Description}">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                    </ctl:Option>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Text.Prose}" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.Danger}" Text="{Binding SaveError}"
                                   Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}" />

                        <Button Style="{StaticResource Button.Primary}" Content="Restart in DevMode with these settings"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding RestartCommand}" />
                    </StackPanel>
                </ctl:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
