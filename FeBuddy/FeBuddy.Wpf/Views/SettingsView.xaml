<!--
    SettingsView  -  Updates / Facility Profile / Default ROI / GeoJSON Files
    (remediation plan Phase 9). Everything persists to UserConfig.json.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="820">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="780" HorizontalAlignment="Left">

                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Save" Command="{Binding SaveCommand}" MinWidth="90" />
                    <TextBlock Style="{StaticResource Text.H1}" Text="Settings" />
                </DockPanel>

                <!-- ================= 1. UPDATES ================= -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="UPDATES" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,8" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Warn}"
                                   Text="Do not select anything but Stable unless a developer instructs you to, or you are one." />
                        <StackPanel>
                            <RadioButton GroupName="Channel" Content="Stable" Margin="0,3" Foreground="{StaticResource Brush.Text.Primary}"
                                         ToolTip="Production releases only. The right choice for almost everyone."
                                         IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Stable}" />
                            <RadioButton GroupName="Channel" Content="Beta" Margin="0,3" Foreground="{StaticResource Brush.Text.Primary}"
                                         ToolTip="Stable plus beta pre-releases. Do not select unless instructed by the developers."
                                         IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Beta}" />
                            <RadioButton GroupName="Channel" Content="Alpha" Margin="0,3" Foreground="{StaticResource Brush.Text.Primary}"
                                         ToolTip="Stable plus all pre-releases, including alpha. Do not select unless instructed by the developers, or you are one."
                                         IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Alpha}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Button.Subtle}" Content="Check for updates now"
                                    Command="{Binding CheckNowCommand}" />
                            <Button Style="{StaticResource Button.Subtle}" Content="Get the latest stable installer"
                                    Command="{Binding RollbackCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= 2. FACILITY PROFILE ================= -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="FACILITY PROFILE" />

                        <TextBlock Style="{StaticResource Text.Body}"
                                   Text="{Binding FacilityWaitingMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding FacilitiesReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        <StackPanel Visibility="{Binding FacilitiesReady, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Facility" Style="{StaticResource Text.Label}" Margin="0,4,0,4" />
                            <ComboBox ItemsSource="{Binding Facilities}" DisplayMemberPath="Display"
                                      SelectedValuePath="ArtccId" SelectedValue="{Binding SelectedFacility}"
                                      Width="300" HorizontalAlignment="Left" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <TextBlock Text="Default output directory" Style="{StaticResource Text.Label}" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Browse…"
                                    Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <CheckBox Content="Add a FE-Buddy_Output folder inside that directory"
                                  IsChecked="{Binding AddFeBuddyOutputFolder}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- ================= 3. DEFAULT REGION OF INTEREST ================= -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="DEFAULT REGION OF INTEREST" />
                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.RoiExplainer}}"
                                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Clear"
                                    Command="{Binding ClearRoiCommand}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Set ROI…"
                                    Command="{Binding EditRoiCommand}" MinWidth="110" />
                            <TextBlock Text="{Binding DefaultRoiSummary}" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ================= 4. GEOJSON FILES ================= -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,24">
                    <StackPanel>
                        <ctl:SectionHeader Label="GEOJSON FILES" />

                        <TextBlock Text="FE-Buddy properties" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.FebPropertiesDescription}}"
                                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <TextBlock Text="Maximum Coordinate Precision" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.CoordinatePrecisionDescription}}"
                                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Precision" Content="5 dp" Margin="0,0,16,0" ToolTip="General object references."
                                         IsChecked="{Binding IsPrecision5, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="5" />
                            <RadioButton GroupName="Precision" Content="6 dp" Margin="0,0,16,0" ToolTip="Airport layout tracing / CAB-like files."
                                         IsChecked="{Binding IsPrecision6, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="6" />
                            <RadioButton GroupName="Precision" Content="7 dp" ToolTip="High-precision navigation and airport tracing."
                                         IsChecked="{Binding IsPrecision7, Mode=OneWay}"
                                         Command="{Binding SetPrecisionCommand}" CommandParameter="7" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
