<!--
    SettingsView  -  updates channel + default ROI. Nothing is persisted.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="900" d:DesignHeight="720">

    <Grid Background="{StaticResource Brush.Bg.Base}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" MaxWidth="780" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Text.H1}" Text="Settings" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="Facility profile, region of interest, output preferences and updates. Nothing on this screen is saved in the preview." />

                <!-- facility profile -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="FACILITY PROFILE">
                            <ctl:SectionHeader.Aside>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Subtle}" Content="New"
                                            Command="{Binding NewProfileCommand}" />
                                    <Button Style="{StaticResource Button.Subtle}" Content="Import"
                                            Command="{Binding ImportProfileCommand}" />
                                    <Button Style="{StaticResource Button.Subtle}" Content="Export"
                                            Command="{Binding ExportProfileCommand}" />
                                </StackPanel>
                            </ctl:SectionHeader.Aside>
                        </ctl:SectionHeader>

                        <ListBox Style="{StaticResource Segmented}" Margin="0,0,0,4"
                                 ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

                        <Border Style="{StaticResource Divider}" Margin="0,10,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="FACILITY NAME" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource Field}" Tag="e.g. Cleveland ARTCC"
                                         Text="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Label}" Text="ARTCC ID" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource Field}" Tag="ZOB"
                                         Text="{Binding ArtccId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Label}" Text="OUTPUT DIRECTORY" Margin="0,14,0,5" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Browse…" Margin="10,0,0,0" />
                            <ctl:CopyButton DockPanel.Dock="Right" Style="{StaticResource Copy.Button}" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Value="{Binding OutputDir}" />
                            <TextBox Style="{StaticResource Field}" Tag="pick a folder"
                                     Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                   Text="Replaces v2.x's fixed ARTCC list and Desktop-only output. One profile per facility, exportable to share." />
                    </StackPanel>
                </Border>

                <!-- data source -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="NASR DATA SOURCE" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Src" Content="Download from FAA"
                                         IsChecked="{Binding DataSource, Converter={StaticResource EnumToBool}, ConverterParameter=Faa}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Src" Content="Custom URL"
                                         IsChecked="{Binding DataSource, Converter={StaticResource EnumToBool}, ConverterParameter=CustomUrl}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Src" Content="Local file (offline)"
                                         IsChecked="{Binding DataSource, Converter={StaticResource EnumToBool}, ConverterParameter=LocalFile}" />
                        </StackPanel>

                        <DockPanel Margin="0,14,0,0"
                                   Visibility="{Binding IsCustomUrl, Converter={StaticResource BoolToVis}}">
                            <ctl:CopyButton DockPanel.Dock="Right" Style="{StaticResource Copy.Button}" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Value="{Binding CustomUrl}" />
                            <TextBox Style="{StaticResource Field}" Tag="https://…/28DaySubscription…zip"
                                     Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,14,0,0"
                                   Visibility="{Binding IsLocalFile, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Browse…" Margin="10,0,0,0"
                                    Command="{Binding BrowseNasrCommand}" />
                            <TextBox Style="{StaticResource Field}" Tag="path to a NASR .zip"
                                     Text="{Binding LocalNasrPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Ghost}" Content="Test source"
                                    Command="{Binding TestSourceCommand}" />
                            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Use this when the FAA changes their download URL, or to build a cycle with no internet." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- display scheme -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="DISPLAY SCHEME">
                            <ctl:SectionHeader.Aside>
                                <Button Style="{StaticResource Button.Subtle}" Content="Export legend"
                                        Command="{Binding ExportLegendCommand}" />
                            </ctl:SectionHeader.Aside>
                        </ctl:SectionHeader>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,10"
                                   Text="Name your BCG groups and filters once; every generator uses these, and the legend is exported for the controller ISR." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="+ Add"
                                            Command="{Binding AddBcgCommand}" />
                                    <TextBlock Style="{StaticResource Text.Label}" Text="BCG GROUPS" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding SchemeBcg}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}"
                                                        Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="9" Padding="6,4"
                                                        Command="{Binding DataContext.RemoveSchemeItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Remove" />
                                                <ctl:CopyButton DockPanel.Dock="Right" Style="{StaticResource Copy.Button}"
                                                                Value="{Binding Name}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource Text.Mono}"
                                                           Foreground="{StaticResource Brush.Text.Tertiary}" Width="18"
                                                           VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource Field}" Padding="8,5" Margin="6,0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="+ Add"
                                            Command="{Binding AddFilterCommand}" />
                                    <TextBlock Style="{StaticResource Text.Label}" Text="FILTERS" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding SchemeFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}"
                                                        Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="9" Padding="6,4"
                                                        Command="{Binding DataContext.RemoveSchemeItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Remove" />
                                                <ctl:CopyButton DockPanel.Dock="Right" Style="{StaticResource Copy.Button}"
                                                                Value="{Binding Name}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource Text.Mono}"
                                                           Foreground="{StaticResource Brush.Text.Tertiary}" Width="18"
                                                           VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource Field}" Padding="8,5" Margin="6,0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- updates -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="UPDATES" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="RELEASE CHANNEL" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Channel" Content="Stable"
                                         IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Stable}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Channel" Content="Beta"
                                         IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Beta}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Channel" Content="Alpha"
                                         IsChecked="{Binding Channel, Converter={StaticResource EnumToBool}, ConverterParameter=Alpha}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,16" />

                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top"
                                          IsChecked="{Binding CheckOnLaunch}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Check for updates on launch" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Otherwise you can check manually from here at any time." />
                            </StackPanel>
                        </DockPanel>

                        <Button Style="{StaticResource Button.Ghost}" Content="Check now"
                                HorizontalAlignment="Left" Margin="0,16,0,0"
                                Command="{Binding CheckNowCommand}" />
                    </StackPanel>
                </Border>

                <!-- default ROI -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="DEFAULT REGION OF INTEREST" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Roi" Content="Set up a bounding box"
                                         IsChecked="{Binding RoiMode, Converter={StaticResource EnumToBool}, ConverterParameter=Custom}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Roi" Content="Get all NASR data"
                                         IsChecked="{Binding RoiMode, Converter={StaticResource EnumToBool}, ConverterParameter=AllData}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding UseCustomRoi, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="NE LATITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. 44.512"
                                             Text="{Binding NeLat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="NE LONGITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. -80.104"
                                             Text="{Binding NeLon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="SW LATITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. 38.940"
                                             Text="{Binding SwLat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="SW LONGITUDE" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource Field}" Tag="e.g. -87.900"
                                             Text="{Binding SwLon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       Text="Make the box a little larger than your ARTCC so nearby data still lands in your files." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- output preferences -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <ctl:SectionHeader Label="OUTPUT" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding SingleLineGeoJson}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Single-line GeoJSON" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Write each file on one line to keep CRC uploads small." />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}"
                                          Margin="0,2,14,0" VerticalAlignment="Top" IsChecked="{Binding FebPropsByDefault}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body.Strong}" Text="Include feb.* properties by default" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Per-run toggles on each generator still override this." />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="COORDINATE PRECISION" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Prec" Content="5 dp"
                                         IsChecked="{Binding Precision, Converter={StaticResource EnumToBool}, ConverterParameter=Five}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Prec" Content="6 dp"
                                         IsChecked="{Binding Precision, Converter={StaticResource EnumToBool}, ConverterParameter=Six}" />
                            <RadioButton Style="{StaticResource Pill.Radio}" GroupName="Prec" Content="7 dp"
                                         IsChecked="{Binding Precision, Converter={StaticResource EnumToBool}, ConverterParameter=Seven}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                   Text="6 dp ≈ 0.1 m. Always emitted with a &quot;.&quot; decimal separator regardless of Windows region (v2.x #166)." />
                    </StackPanel>
                </Border>

                <!-- save (confirmation shows as a toast) -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="Save" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
