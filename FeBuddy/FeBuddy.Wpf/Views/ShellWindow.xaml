<!--
    ShellWindow  -  the application frame.
    ===========================================================================
    Custom chrome (via System.Windows.Shell.WindowChrome, no AllowsTransparency
    so we keep aero snap + the system drop shadow + good perf). Layout is three
    rows: caption / body / status bar. The body is a fixed nav rail plus a
    ContentControl whose content is swapped by ShellViewModel; the DataTemplates
    below pick the right view for each section view-model.
-->
<Window x:Class="FeBuddy.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
        xmlns:views="clr-namespace:FeBuddy.Wpf.Views"
        xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
        xmlns:infra="clr-namespace:FeBuddy.Wpf.Infrastructure"
        mc:Ignorable="d"
        Title="FE-Buddy"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource Font.Body}"
        Background="{StaticResource Brush.Bg.Base}"
        d:DataContext="{d:DesignInstance vm:ShellViewModel, IsDesignTimeCreatable=True}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- section view-model  ->  section view -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiracViewModel}">
            <views:AiracView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AirwaysViewModel}">
            <views:AirwaysView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConversionsViewModel}">
            <views:ConversionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GeoJsonToolsViewModel}">
            <views:GeoJsonToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AliasReferenceViewModel}">
            <views:AliasReferenceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InfoViewModel}">
            <views:InfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <!-- one transient notification (Infrastructure/Toast.cs). Colour + glyph
             follow ToastItem.Kind; slides in from the right on load. -->
        <DataTemplate x:Key="ToastCard" DataType="{x:Type infra:ToastItem}">
            <Border Width="336" Margin="0,8,0,0"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Stroke.Strong}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="14,12" SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Slide" X="36" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270"
                                      Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconChip" Grid.Column="0" Width="28" Height="28" CornerRadius="9"
                            VerticalAlignment="Top" Background="{StaticResource Brush.Accent.Soft}">
                        <TextBlock x:Name="Glyph" Text="&#xE946;"
                                   FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                   Foreground="{StaticResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body.Strong}" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Button.Subtle}"
                            Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                            Padding="7,4" VerticalAlignment="Top"
                            Command="{Binding DismissCommand}" ToolTip="Dismiss" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X"
                                             From="36" To="0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter TargetName="IconChip" Property="Background" Value="{StaticResource Brush.Positive.Soft}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Positive}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn">
                    <Setter TargetName="IconChip" Property="Background" Value="{StaticResource Brush.Warn.Soft}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Warn}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="IconChip" Property="Background" Value="{StaticResource Brush.Danger.Soft}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE783;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one nav row: grouped RadioButton with icon + label. The label hides
             when the rail is collapsed; a tooltip carries the name instead. -->
        <DataTemplate x:Key="NavRow" DataType="{x:Type vm:NavItem}">
            <RadioButton Style="{StaticResource Nav.Item}" GroupName="FebNav"
                         IsChecked="{Binding IsActive, Mode=TwoWay}"
                         ToolTip="{Binding Title}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="15"
                               Width="20"
                               TextAlignment="Left"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               Margin="10,0,0,0"
                               FontFamily="{StaticResource Font.Body}"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <!-- Padding is pushed to 8 when maximised so content doesn't slide under the
         screen edge (see ShellWindow.xaml.cs / OnStateChanged). -->
    <Border x:Name="RootBorder" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ============================ CAPTION =========================== -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- brand mark: a tiny radar scope.
                     IsHitTestVisibleInChrome lets this strip receive hover so the
                     tooltips fire (the rest of the caption stays a drag handle). -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.4" />
                        <Ellipse Width="8" Height="8" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.2" Opacity="0.7" />
                        <Path Data="M9,9 L17,4" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.4" />
                    </Grid>

                    <TextBlock Text="FE-BUDDY"
                               Margin="10,0,0,0"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Cursor="Help"
                               ToolTipService.InitialShowDelay="300">
                        <TextBlock.ToolTip>
                            <StackPanel MaxWidth="260">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="FE-Buddy 3.0" Margin="8,0,0,0"
                                               Style="{StaticResource Text.Body.Strong}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                           Text="Sector-file toolkit for VATSIM / VATUSA facility engineers — NASR pulls, video-map conversions, and ERAM-ready GeoJSON." />
                                <Border Style="{StaticResource Divider}" Margin="0,10" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Text="Build 3.0.0-dev  ·  30 Aug 2025  ·  .NET 10" />
                            </StackPanel>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                            Cursor="Help"
                            ToolTipService.InitialShowDelay="300">
                        <TextBlock Style="{StaticResource Chip.Text}"
                                   Foreground="{StaticResource Brush.Accent.Text}"
                                   Text="{Binding VersionLabel}" />
                        <Border.ToolTip>
                            <StackPanel MaxWidth="260">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.Warn}" />
                                    <TextBlock Text="Update available" Margin="8,0,0,0"
                                               Style="{StaticResource Text.Body.Strong}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                           Text="You're on v3.0.0-dev. v3.0.1 is ready on the dev channel." />
                                <Border Style="{StaticResource Divider}" Margin="0,10" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Text="Settings &#8250; Updates to switch channel or roll back." />
                            </StackPanel>
                        </Border.ToolTip>
                    </Border>
                </StackPanel>

                <!-- caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource Caption.Button}"
                            Content="&#xE921;"
                            Click="OnMinimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaxRestoreButton"
                            Style="{StaticResource Caption.Button}"
                            Content="&#xE922;"
                            Click="OnMaxRestore"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource Caption.Close}"
                            Content="&#xE8BB;"
                            Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ============================= BODY ============================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- nav rail: Width animates between 232 and 60 on NavCollapsed -->
                <Border x:Name="NavRail" Grid.Column="0" Width="232" ClipToBounds="True"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.Stroke}"
                        BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavCollapsed}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="232" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- collapse / expand -->
                        <Grid DockPanel.Dock="Top" Margin="10,10,8,0">
                            <Button Style="{StaticResource Caption.Button}" HorizontalAlignment="Right"
                                    Command="{Binding ToggleNavCommand}" ToolTip="Collapse / expand nav">
                                <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE76B;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NavCollapsed}" Value="True">
                                                    <Setter Property="Text" Value="&#xE76C;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <!-- systems-health widget pinned to the bottom (hidden when collapsed) -->
                        <Grid DockPanel.Dock="Bottom" Margin="14"
                              Visibility="{Binding NavCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <ToggleButton x:Name="HealthButton" Style="{StaticResource Card.Toggle}">
                                <DockPanel LastChildFill="False">
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Text.Tertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HealthWorst}" Value="Ok">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Positive}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthWorst}" Value="Warn">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthWorst}" Value="Down">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70E;"
                                               FontFamily="{StaticResource Font.Icon}" FontSize="8"
                                               Foreground="{StaticResource Brush.Text.Tertiary}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Systems" FontFamily="{StaticResource Font.Body}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding HealthSummary}" Style="{StaticResource Text.Caption}"
                                                   FontSize="10.5" />
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=HealthButton}" Placement="Top"
                                   VerticalOffset="-8" HorizontalOffset="0"
                                   IsOpen="{Binding IsChecked, ElementName=HealthButton, Mode=TwoWay}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource Card}" Background="{StaticResource Brush.Panel}"
                                        Padding="12" MinWidth="264" Margin="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="90"
                                                          Opacity="0.5" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <ctl:SectionHeader Label="SYSTEMS" />
                                        <ItemsControl ItemsSource="{Binding SystemHealth}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                                                                 Fill="{StaticResource Brush.Text.Tertiary}" />
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body.Strong}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Positive}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Warn">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Warn}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Down">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource Divider}" Margin="0,8" />
                                        <Button Style="{StaticResource Button.Subtle}" Content="Re-check"
                                                HorizontalAlignment="Left" Margin="-8,0,0,0"
                                                Command="{Binding RecheckCommand}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <StackPanel Margin="10,10,10,0">
                            <ctl:SectionHeader Label="WORKSPACE" Margin="10,4,10,4"
                                               Visibility="{Binding NavCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <ItemsControl ItemsSource="{Binding PrimaryNav}"
                                          ItemTemplate="{StaticResource NavRow}" />

                            <ctl:SectionHeader Label="SYSTEM" Margin="10,18,10,4"
                                               Visibility="{Binding NavCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <ItemsControl ItemsSource="{Binding SystemNav}"
                                          ItemTemplate="{StaticResource NavRow}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- current section -->
                <ContentControl Grid.Column="1" Content="{Binding Current}" />

                <!-- toast host: floats bottom-right over the content area -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{x:Static infra:Toast.Items}"
                              ItemTemplate="{StaticResource ToastCard}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,20,20" Panel.ZIndex="100"
                              Background="Transparent" IsHitTestVisible="True" />
            </Grid>

            <!-- ========================== STATUS BAR ========================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Bg.Sunken}"
                    BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Ready"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AiracLabel}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="  ·  " Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ZuluClock}" Style="{StaticResource Text.Caption}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
