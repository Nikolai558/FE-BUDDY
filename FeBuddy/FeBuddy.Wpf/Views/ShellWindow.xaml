<!--
    ShellWindow  -  the application frame.
    ===========================================================================
    Custom chrome (via System.Windows.Shell.WindowChrome, no AllowsTransparency
    so we keep aero snap + the system drop shadow + good perf). Layout is three
    rows: caption / body / status bar. The body is a fixed nav rail plus a
    ContentControl whose content is swapped by ShellViewModel; the DataTemplates
    below pick the right view for each section view-model.
-->
<Window x:Class="FeBuddy.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
        xmlns:views="clr-namespace:FeBuddy.Wpf.Views"
        xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
        mc:Ignorable="d"
        Title="FE-Buddy"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource Font.Body}"
        Background="{StaticResource Brush.Bg.Base}"
        d:DataContext="{d:DesignInstance vm:ShellViewModel, IsDesignTimeCreatable=True}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- section view-model  ->  section view -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiracViewModel}">
            <views:AiracView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InfoViewModel}">
            <views:InfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <!-- one nav row: grouped RadioButton with icon + label -->
        <DataTemplate x:Key="NavRow" DataType="{x:Type vm:NavItem}">
            <RadioButton Style="{StaticResource Nav.Item}" GroupName="FebNav"
                         IsChecked="{Binding IsActive, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="15"
                               Width="20"
                               TextAlignment="Left"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               Margin="10,0,0,0"
                               FontFamily="{StaticResource Font.Body}"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <!-- Padding is pushed to 8 when maximised so content doesn't slide under the
         screen edge (see ShellWindow.xaml.cs / OnStateChanged). -->
    <Border x:Name="RootBorder" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ============================ CAPTION =========================== -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Bg.Base}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- brand mark: a tiny radar scope -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.4" />
                        <Ellipse Width="8" Height="8" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.2" Opacity="0.7" />
                        <Path Data="M9,9 L17,4" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.4" />
                    </Grid>
                    <TextBlock Text="FE-BUDDY"
                               Margin="10,0,0,0"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource Chip.Text}"
                                   Foreground="{StaticResource Brush.Accent.Text}"
                                   Text="{Binding VersionLabel}" />
                    </Border>
                </StackPanel>

                <!-- caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource Caption.Button}"
                            Content="&#xE921;"
                            Click="OnMinimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaxRestoreButton"
                            Style="{StaticResource Caption.Button}"
                            Content="&#xE922;"
                            Click="OnMaxRestore"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource Caption.Close}"
                            Content="&#xE8BB;"
                            Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ============================= BODY ============================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- nav rail -->
                <Border Grid.Column="0"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.Stroke}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- connection strip pinned to the bottom -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="14" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                                <TextBlock Text="Offline preview" Margin="9,0,0,0" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="10,14,10,0">
                            <ctl:SectionHeader Label="WORKSPACE" Margin="10,0,10,4" />
                            <ItemsControl ItemsSource="{Binding PrimaryNav}"
                                          ItemTemplate="{StaticResource NavRow}" />

                            <ctl:SectionHeader Label="SYSTEM" Margin="10,18,10,4" />
                            <ItemsControl ItemsSource="{Binding SystemNav}"
                                          ItemTemplate="{StaticResource NavRow}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- current section -->
                <ContentControl Grid.Column="1" Content="{Binding Current}" />
            </Grid>

            <!-- ========================== STATUS BAR ========================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Bg.Sunken}"
                    BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Ready"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AiracLabel}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="  ·  " Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="Sample data" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
