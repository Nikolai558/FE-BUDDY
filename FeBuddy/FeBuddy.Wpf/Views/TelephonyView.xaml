<!--
    TelephonyView  -  the Telephony sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.

    Telephony's only output is its alias file, which covers every operator, so there is no
    choice to make about it - only the virtual airlines to add to it: the Virtual Airline
    List (GNG + VATSIM-Radar), ticked or not, and the user's own, listed on the Virtual Airlines card
    the way the Fixes tab lists its combinations - see TelephonyViewModel's class remarks.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.TelephonyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:m="clr-namespace:FeBuddy.Wpf.ViewModels.Models"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             xmlns:bhv="clr-namespace:FeBuddy.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TelephonyViewModel}"
             d:DesignWidth="900" d:DesignHeight="900">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ outputs ============ -->
            <ctl:Card Header="Outputs">
                <StackPanel>
                    <cards:OutputStatusRow Margin="0,4,0,0" Kind="Alias" Label="Telephony.txt" IsOn="{Binding GenerateAliasFile}"
                                           Description="Writes an `.id` alias command for every operator's 3LD and telephony. The company and country are included too.&#xA;&#xA;Virtual airlines are an optional addition to the data.&#xA;&#xA;These two commands return the same ISR card:" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="66,2,0,0"
                               bhv:InlineCode.Text="`.idAVA`&#xA;`.idAVIANCA`" />
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="50,12,0,0"
                               bhv:InlineCode.Text="Overlapping or duplicate 3LD and telephony situations respond with both options to the user.&#xA;For example, one operator has a 3LD of `AVA`, while `AVA` is also the telephony of another operator." />
                </StackPanel>
            </ctl:Card>

            <!-- ============ virtual airlines ============ -->
            <ctl:Card Header="Virtual Airlines" Outputs="Alias" bhv:FieldState.Error="{Binding FieldErrors[VirtualAirlines]}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,8"
                               bhv:InlineCode.Text="Adds virtual airlines to `Telephony.txt`.&#xA;&#xA;VA cards are headed by `--VA--` to clearly show their status as a VA.&#xA;Note: Only one card is written for each 3LD and telephony, so a virtual airline with the same 3LD and telephony as a real operator is left out." />

                    <!-- the virtual airline list: one tick, and what FE-Buddy has of it -->
                    <CheckBox Content="Include the Virtual Airline List (GNG + VATSIM-Radar)" IsChecked="{Binding IncludeVatsimRadarList}" Margin="0,4,0,0" />
                    <StackPanel Margin="42,4,0,0" MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap"
                                   Text="Highly suggested to include this list of virtual airlines, compiled from GNG and VATSIM-Radar.&#xA;You may still add your own virtual airline entries after this has been included." />
                        <StackPanel Visibility="{Binding IncludeVatsimRadarList, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding VatsimRadarListStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            <!-- a part that couldn't be downloaded, in amber so it isn't missed (issue #337) -->
                            <TextBlock Text="{Binding VatsimRadarListWarning}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Warn}" Margin="0,4,0,0"
                                       Visibility="{Binding HasVatsimRadarListWarning, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Download the latest list" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Command="{Binding DownloadVatsimRadarListCommand}"
                                    ToolTip="Runs download each part of the list at most once a day. Download it now, to check your virtual airlines against it." />
                        </StackPanel>
                    </StackPanel>

                    <ctl:SectionHeader Style="{StaticResource SectionHeader.Group}" Label="Your virtual airlines" Margin="0,16,0,8" />

                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                               Text="No virtual airlines yet."
                               Visibility="{Binding HasVirtualAirlines, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding VirtualAirlines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:VirtualAirlineItem}">
                                <Border Margin="0,3" Padding="8,6" CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{StaticResource Brush.Bg.Sunken}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EditVirtualAirlineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteVirtualAirlineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body.Strong}" />
                                            <TextBlock Text="{Binding Organization}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Commands}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}"
                                                       Foreground="{StaticResource Brush.Warn}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- editor row: wraps on a narrow window rather than running off it -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsEditingVirtualAirline, Converter={StaticResource BoolToVis}}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="3LD" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Width="70" MaxLength="3" CharacterCasing="Upper" Tag="DVA"
                                         Text="{Binding EditDesignator, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Telephony" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Width="180" CharacterCasing="Upper" Tag="DELTA"
                                         Text="{Binding EditTelephony, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Virtual organization" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Width="220" Tag="Delta Virtual"
                                         Text="{Binding EditOrganization, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button Content="{Binding ConfirmVirtualAirlineText}" Style="{StaticResource Button.Primary}"
                                        Command="{Binding ConfirmVirtualAirlineCommand}" />
                                <Button Content="Cancel" Style="{StaticResource Button.Ghost}"
                                        Margin="8,0,0,0" Command="{Binding CancelVirtualAirlineCommand}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding VirtualAirlineEditorHint}" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Visibility="{Binding VirtualAirlineEditorHint, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding VirtualAirlineEditorNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                                   Visibility="{Binding VirtualAirlineEditorNote, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Button Content="Add virtual airline" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding AddVirtualAirlineCommand}"
                            Visibility="{Binding IsEditingVirtualAirline, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </StackPanel>
            </ctl:Card>

    </StackPanel>
</UserControl>
