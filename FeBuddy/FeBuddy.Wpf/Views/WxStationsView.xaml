<!--
    WxStationsView  -  the Wx Stations sub-service tab inside the AIRAC Service screen.
    Save / Undo / Previous / Next / Preview settings come from the tab host's shared
    action bar, and the tab host owns the page's single scroller.
-->
<UserControl x:Class="FeBuddy.Wpf.Views.WxStationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FeBuddy.Wpf.ViewModels"
             xmlns:ctl="clr-namespace:FeBuddy.Wpf.Controls"
             xmlns:cards="clr-namespace:FeBuddy.Wpf.Views.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WxStationsViewModel}"
             d:DesignWidth="900" d:DesignHeight="1300">

    <!-- No ScrollViewer here: the tab host owns the one page-level scroller
         that every sub-service tab is laid out inside. A second scroller would
         steal the wheel and hide the lower sections. -->
    <StackPanel>

            <cards:AttentionCard />

            <!-- ============ what the outputs get, every filter in one place ============ -->
            <cards:SummaryCard />

            <!-- ============ which GeoJSON files ============ -->
            <cards:GeojsonFilesCard ShowLines="False"
                                    SymbolsDescription="A symbol at each weather station."
                                    TextDescription="A two-line label at each station: its ICAO ID, then its IATA ID and name. Ex: KDTW, then DTW_Detroit/Metro Wayne Cnty"
                                    Footnote="Files go in `Geojson\` in the cycle's folder." />

            <!-- ============ station data ============ -->
            <ctl:Card Header="Station Data" Outputs="Geojson">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,4,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Weather stations come from aviationweather.gov, not the FAA's AIRAC data. Every run downloads the latest list, for any cycle." />
                    <TextBlock Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,0,0,8"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left"
                               Text="Included: stations with an ICAO ID that report METARs, in the US, Puerto Rico, the US Virgin Islands, Guam, the Northern Mariana Islands, American Samoa and the US Minor Outlying Islands." />
                    <TextBlock Text="{Binding StationDataStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               MaxWidth="{StaticResource Layout.Prose.MaxWidth}" HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:Card>

            <!-- ============ region of interest ============ -->
            <cards:RoiOverrideCard Outputs="Geojson">
                <cards:RoiOverrideCard.AdditionalContent>
                    <TextBlock Style="{StaticResource Text.Prose}" Margin="0,14,0,0"
                               Text="Only stations inside the region are written, in both files." />
                </cards:RoiOverrideCard.AdditionalContent>
            </cards:RoiOverrideCard>

            <!-- ============ CRC ERAM defaults: which files get them, and their values ============ -->
            <cards:CrcDefaultsCard SymbolsTitle="Wx Stations — Symbols" TextTitle="Wx Stations — Text">
                <cards:CrcDefaultsCard.Choice>
                    <cards:CrcFileChoice />
                </cards:CrcDefaultsCard.Choice>
            </cards:CrcDefaultsCard>
    </StackPanel>
</UserControl>
