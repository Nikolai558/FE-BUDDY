<UserControl x:Class="FeBuddyWPF.CustomControls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FeBuddyWPF.CustomControls"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="850">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="15"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="FE-BUDDY - vDEV"
               Foreground="White"
               FontSize="16"
               FontFamily="Montserrat"
               Grid.Column="0"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="0,0,0,0"/>

        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Grid.Column="1">

            <Button x:Name="btnNews"
                Style="{StaticResource topMenuButton}"
                Content="News"
                Tag="15, 0, 0, 15">
            </Button>

            <Button x:Name="btnInformation"
                Content="Information"
                Style="{StaticResource topMenuButton}"
                Tag="0">
            </Button>

            <Button x:Name="btnDiscord" 
                Content="Discord"
                Style="{StaticResource topMenuButton}"
                Tag="0">
            </Button>

            <Button x:Name="btnReportIssues"
                Content="Issues / Requests"
                Style="{StaticResource topMenuButton}"
                Tag="0, 15, 15, 0">
            </Button>

        </StackPanel>

        <Button x:Name="btnSettings"
            Style="{StaticResource btnWindowOptions}"
            Grid.Column="2"
            Click="btnSettings_Click"
            Tag="White">
            <fa:IconImage Icon="Gear" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
        </Button>

        <Button x:Name="btnMinimize"
            Style="{StaticResource btnWindowOptions}"
            Grid.Column="4"
            Click="btnMinimize_Click"
            Tag="White">
            <fa:IconImage Icon="WindowMinimize" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
        </Button>

        <Button x:Name="btnMaximize"
            Style="{StaticResource btnWindowOptions}"
            Grid.Column="6"
            Click="btnMaximize_Click"
            Tag="Green">
            <fa:IconImage Icon="Square" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
        </Button>

        <Button x:Name="btnClose"
            Style="{StaticResource btnWindowOptions}"
            Grid.Column="8"
            Click="btnClose_Click"
            Tag="Red">
            <fa:IconImage Icon="Close" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
        </Button>
    </Grid>
</UserControl>
