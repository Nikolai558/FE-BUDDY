<UserControl x:Class="FeBuddyWPF.View.FaaDatToGeojsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FeBuddyWPF.View" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="578"
             ScrollViewer.CanContentScroll="True">
    
    <!--Main Child View Border-->
    <Border Background="Transparent"
            CornerRadius="15" 
            Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#171717"
                    CornerRadius="15"
                    Opacity=".75">
                <StackPanel Orientation="Vertical">
                    <Border BorderBrush="{x:Null}" Height="50">
                        <TextBlock Text="FAA DAT To Geojson"
                                   FontSize="32"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Montserrat"
                                   FontWeight="Medium"/>
                    </Border>

                    <Border BorderBrush="{x:Null}" Height="100">
                        <TextBlock Text="This process will convert your FAA .DAT RADAR Video Map (RVM) into a .geojson file."
                                   FontSize="16"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Montserrat"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <Border Background="#171717"
                        CornerRadius="15"
                        Opacity=".75"
                        Margin="0,4,0,0"
                        Padding="0,4,0,0">
                    <StackPanel Orientation="Vertical">


                        <Border Height="100">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="55"/>
                                    <RowDefinition Height="5"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="Source File"
                                               FontSize="20"
                                               Foreground="White"
                                               Width="245"
                                               Padding="10,0,0,0"
                                               />
                                    <fa:IconImage Icon="FileAlt" Width="30" Margin="10,2" Foreground="White" Cursor="Hand"/>
                                    <TextBox Width="250" Height="30"
                                             Background="{StaticResource btnBackground2}"
                                             BorderThickness="0"
                                             Foreground="White"
                                             VerticalContentAlignment="Center"
                                             FontSize="16"
                                             Padding="5"
                                             TextWrapping="NoWrap"
                                             Text="C:/username/Desktop/FAA.DAT"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="Select your FAA .DAT file."
                                           FontFamily="Montserrat"
                                           FontSize="16"
                                           Foreground="White"
                                           Padding="10,0,0,0"
                                           VerticalAlignment="Center"/>

                                <Line Grid.Row="2" 
                                      X1="10" Y1="2"
                                      X2="780" Y2="2"
                                      Stroke="Black"
                                      StrokeThickness="2"/>
                            </Grid>
                        </Border>

                        <Border Height="100" Margin="0, 10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="55"/>
                                    <RowDefinition Height="5"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="Output Directory"
                                               FontSize="20"
                                               Foreground="White"
                                               Width="245"
                                               Padding="10,0,0,0"
                                               />
                                    <fa:IconImage Icon="FolderOpen" Width="30" Margin="10,2" Foreground="White" Cursor="Hand"/>
                                    <TextBox Width="250" Height="30"
                                             Background="{StaticResource btnBackground2}"
                                             BorderThickness="0"
                                             Foreground="White"
                                             VerticalContentAlignment="Center"
                                             FontSize="16"
                                             Padding="5"
                                             TextWrapping="NoWrap"
                                             Text="C:/username/Desktop/FE-Buddy-Output"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="Select the destination directory that you would like your .geojson file to be saved in."
                                           FontFamily="Montserrat"
                                           FontSize="16"
                                           Foreground="White"
                                           Padding="10,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <Line Grid.Row="2" 
                                      X1="10" Y1="2"
                                      X2="780" Y2="2"
                                      Stroke="Black"
                                      StrokeThickness="2"/>
                            </Grid>
                        </Border>

                        <Border Height="100">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="55"/>
                                    <RowDefinition Height="5"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="Cropping Distance"
                                               FontSize="20"
                                               Foreground="White"
                                               Width="245"
                                               Padding="10,0,0,0"
                                               />
                                    <fa:IconImage Icon="CropSimple" Width="30" Margin="10,2" Foreground="White" Cursor="Hand"/>
                                    <TextBox Width="250" Height="30"
                                             Background="{StaticResource btnBackground2}"
                                             BorderThickness="0"
                                             Foreground="White"
                                             VerticalContentAlignment="Center"
                                             FontSize="16"
                                             Padding="5"
                                             TextWrapping="NoWrap"
                                             Text="25 NM"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="Type a numeric value here representing a distance from the .DAT file defined Point of Tangency that you want all lines drawn. Leave blank if you want the entire file drawn."
                                           FontFamily="Montserrat"
                                           FontSize="16"
                                           Foreground="White"
                                           Padding="10,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <Line Grid.Row="2" 
                                      X1="10" Y1="2"
                                      X2="780" Y2="2"
                                      Stroke="Black"
                                      StrokeThickness="2"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
