<Page x:Class="FeBuddyWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FeBuddyWPF.Views"
        xmlns:controls="clr-namespace:FeBuddyWPF.CustomControls"
        xmlns:viewModels="clr-namespace:FeBuddyWPF.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="550" Width="850"
        MouseDown="Window_MouseDown">


    <Page.Resources>
        <DataTemplate DataType="{x:Type viewModels:FaaDatToGeojsonViewModel}">
            <local:FaaDatToGeojsonView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AiracDataViewModel}">
            <local:AiracDataView/>
        </DataTemplate>
    </Page.Resources>


    <Border Background="Black"
            Opacity="1"
            CornerRadius="15">
        
        <Border CornerRadius="15">
            <Border.Background>
                    <ImageBrush ImageSource="/Images/FEB_EARTH_SS2_BW.jpg"
                            Stretch="UniformToFill"
                            Opacity=".3"/>
            </Border.Background>
        
            <Border CornerRadius="15"
                    BorderThickness="2"
                    BorderBrush="Black">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource windowBackground1}"
                                     Opacity=".2"/>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <controls:TitleBar 
                        Grid.Row="0"/>

                    <controls:MenuOptions 
                        Grid.Row="1"/>

                </Grid>
            </Border>
        </Border>
    </Border>

</Page>
