<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        
        xmlns:viewModel="clr-namespace:WPF.Windows.MainWindow.ViewModel"
        
        xmlns:mainMenuV="clr-namespace:WPF.Windows.MainMenu.View"
        xmlns:mainMenuVM="clr-namespace:WPF.Windows.MainMenu.ViewModel"
        
        xmlns:programMsgV="clr-namespace:WPF.Windows.ProgramMessages.View"
        xmlns:programMsgVM="clr-namespace:WPF.Windows.ProgramMessages.ViewModel"
        
        xmlns:settingsMenuV="clr-namespace:WPF.Windows.SettingsMenu.View"
        xmlns:settingsMenuVM="clr-namespace:WPF.Windows.SettingsMenu.ViewModel"
        
        xmlns:startingWindowV="clr-namespace:WPF.Windows.StartingWindow.View"
        xmlns:startingWindowVM="clr-namespace:WPF.Windows.StartingWindow.ViewModel"
        
        mc:Ignorable="d"
        Title="FE Buddy" Height="550" Width="850"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewModel:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type mainMenuVM:MainMenuViewModel}">
            <mainMenuV:MainMenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type programMsgVM:ProgramMsgViewModel}">
            <programMsgV:ProgramMsgUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsMenuVM:SettingsMenuViewModel}">
            <settingsMenuV:SettingsUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type startingWindowVM:ProgStartingViewModel}">
            <startingWindowV:ProgStartingUserControl/>
        </DataTemplate>
    </Window.Resources>
    
    <Border Background="Black"
            Opacity="1"
            CornerRadius="15">

        <UserControl x:Name="MainWindowUserControl"
                     Content="{Binding CurrentWindowView, UpdateSourceTrigger=PropertyChanged}"
                     Margin="10"/>
    </Border>
</Window>
