<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        xmlns:viewModel="clr-namespace:WPF.Windows.MainWindow.ViewModel"
        mc:Ignorable="d"
        Title="FE Buddy" Height="550" Width="850"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewModel:MainWindowViewModel/>
    </Window.DataContext>
    
    <Border Background="Black"
            Opacity="1"
            CornerRadius="15">
        
        <!-- TODO - Maybe put window buttons in this display -->

        <ContentControl x:Name="WindowDisplay"
                        Content="{Binding CurrentWindowView}"
                        Margin="10"/>

    </Border>
</Window>
