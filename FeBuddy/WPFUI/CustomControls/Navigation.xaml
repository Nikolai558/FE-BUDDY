<UserControl x:Class="WPFUI.CustomControls.Navigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFUI.CustomControls"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,20,0,0">
            <RadioButton x:Name="btnAiracData"
                 Style="{StaticResource menuButton}"
                 Tag="{StaticResource btnBackground1}"
                 Command="{Binding ShowAiracDataViewCommand}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="ArrowsSpin" Style="{StaticResource menuButtonIcon}"/>
                    <TextBlock Text="AIRAC Data" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnConversions"
                 Style="{StaticResource menuButton}"
                 Tag="{StaticResource btnBackground1}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                    <TextBlock Text="Conversions" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnDatGeoJson"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 Command="{Binding ShowFaaDatToGeojsonViewCommand}"
                 GroupName="subMenuGroup"
                 Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="FAA DAT-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnFaaGeoJson"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 Command="{Binding ShowFaaGeojsonViewCommand}"
                 GroupName="subMenuGroup"
                 Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="FAA GeoMap-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnVstarsVeramGeojson"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 GroupName="subMenuGroup"
                 Command="{Binding ShowVstarsVeramGeojsonViewCommand}"
                 Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="vSTARS/vERAM-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnSctGeojson"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 GroupName="subMenuGroup"
                 Command="{Binding ShowSctGeojsonViewCommand}"
                 Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="SCT2-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>


            <RadioButton x:Name="btnFacilityFiles"
                 Style="{StaticResource menuButton}"
                 Tag="{StaticResource btnBackground1}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="FolderTree" Style="{StaticResource menuButtonIcon}"/>
                    <TextBlock Text="Facility Files" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnAliasMaintenance"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 GroupName="subMenuGroup"
                 Command="{Binding ShowAliasMaintenanceViewCommand}"
                 Visibility="{Binding IsChecked,ElementName=btnFacilityFiles,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="Alias Maintenance" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnFacilityAdminTools"
                 Style="{StaticResource menuButton}"
                 Tag="{StaticResource btnBackground1}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="BuildingFlag" Style="{StaticResource menuButtonIcon}"/>
                    <TextBlock Text="Facility Admin Tools" Style="{StaticResource menuButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnMemberActivityTracking"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 GroupName="subMenuGroup"
                 Command="{Binding ShowMemberActivityTrackingViewCommand}"
                 Visibility="{Binding IsChecked,ElementName=btnFacilityAdminTools,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="Member Activity Tracking" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="btnAirportTrafficLevels"
                 Style="{StaticResource menuSubButton}"
                 Tag="{StaticResource btnBackground1}"
                 Command="{Binding ShowAirportTrafficLevelsViewCommand}"
                 GroupName="subMenuGroup"
                 Visibility="{Binding IsChecked,ElementName=btnFacilityAdminTools,Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--<fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>-->
                    <TextBlock Text="Airport Traffic Levels" Style="{StaticResource menuSubButtonText}"/>
                </StackPanel>
            </RadioButton>


        </StackPanel>

        <!--Show Child Views HERE-->
        <ContentControl Content="{Binding CurrentChildView}"
                Grid.Column="1"
                Margin="10"/>
    </Grid>
</UserControl>
