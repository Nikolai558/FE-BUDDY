<Window x:Class="WPFUI.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFUI.Views"
        xmlns:viewModel="clr-namespace:WPFUI.ViewModels"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Black"
        WindowStyle="None"
        Title="ShellView" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" CanExecute="CommandBinding_CanExecute_Close_Min_Max" Executed="CommandBinding_Executed_Close" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="CommandBinding_CanExecute_Close_Min_Max" Executed="CommandBinding_Executed_Maximized" />
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="CommandBinding_CanExecute_Close_Min_Max" Executed="CommandBinding_Executed_Minimized" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="15"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="FE-BUDDY - vDEV"
       Foreground="White"
       FontSize="16"
       FontFamily="Montserrat"
       Grid.Column="0"
       TextAlignment="Center"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"
       Margin="0,0,0,0"/>

            <StackPanel Orientation="Horizontal"
        HorizontalAlignment="Center"
        Grid.Column="1">

                <Button x:Name="btnNews"
        Style="{StaticResource topMenuButton}"
        Content="News"
        Tag="15, 0, 0, 15">
                </Button>

                <Button x:Name="btnInformation"
        Content="Information"
        Style="{StaticResource topMenuButton}"
        Tag="0">
                </Button>

                <Button x:Name="btnDiscord" 
        Content="Discord"
        Style="{StaticResource topMenuButton}"
        Tag="0">
                </Button>

                <Button x:Name="btnReportIssues"
        Content="Issues / Requests"
        Style="{StaticResource topMenuButton}"
        Tag="0, 15, 15, 0">
                </Button>

            </StackPanel>

            <Button x:Name="btnSettings"
    Style="{StaticResource btnWindowOptions}"
    Grid.Column="2"
    Click="btnSettings_Click"
    Tag="White">
                <fa:IconImage Icon="Gear" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
            </Button>

            <Button x:Name="btnMinimize"
    Style="{StaticResource btnWindowOptions}"
    Grid.Column="4"
    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
    Tag="White">
                <fa:IconImage Icon="WindowMinimize" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
            </Button>

            <Button x:Name="btnMaximize"
    Style="{StaticResource btnWindowOptions}"
    Grid.Column="6"
    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
    Tag="Green">
                <fa:IconImage Icon="Square" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
            </Button>

            <Button x:Name="btnClose"
    Style="{StaticResource btnWindowOptions}"
    Grid.Column="8"
    Command="{x:Static SystemCommands.CloseWindowCommand}"
    Tag="Red">
                <fa:IconImage Icon="Close" Cursor="Hand" Style="{StaticResource btnWindowOptIcon}"/>
            </Button>
        </Grid>



        <Grid Grid.Column="0" Grid.Row="1" Margin="10,5,598,-169">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,20,0,0">

                <Button x:Name="ShowAiracDataViewCommand">Load Airac Page</Button>


                <RadioButton x:Name="btnAiracData"
             Style="{StaticResource menuButton}"
             Tag="{StaticResource btnBackground1}"
             Command="{Binding Path=ShowAiracDataViewCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="ArrowsSpin" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="AIRAC Data" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnConversions"
             Style="{StaticResource menuButton}"
             Tag="{StaticResource btnBackground1}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Conversions" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnDatGeoJson"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             Command="{Binding ShowFaaDatToGeojsonViewCommand}"
             GroupName="subMenuGroup"
             Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="FAA DAT-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnFaaGeoJson"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             Command="{Binding ShowFaaGeojsonViewCommand}"
             GroupName="subMenuGroup"
             Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="FAA GeoMap-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnVstarsVeramGeojson"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             GroupName="subMenuGroup"
             Command="{Binding ShowVstarsVeramGeojsonViewCommand}"
             Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="vSTARS/vERAM-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnSctGeojson"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             GroupName="subMenuGroup"
             Command="{Binding ShowSctGeojsonViewCommand}"
             Visibility="{Binding IsChecked,ElementName=btnConversions,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="SCT2-to-GeoJSON" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>


                <RadioButton x:Name="btnFacilityFiles"
             Style="{StaticResource menuButton}"
             Tag="{StaticResource btnBackground1}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="FolderTree" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Facility Files" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnAliasMaintenance"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             GroupName="subMenuGroup"
             Command="{Binding ShowAliasMaintenanceViewCommand}"
             Visibility="{Binding IsChecked,ElementName=btnFacilityFiles,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Alias Maintenance" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnFacilityAdminTools"
             Style="{StaticResource menuButton}"
             Tag="{StaticResource btnBackground1}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="BuildingFlag" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Facility Admin Tools" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnMemberActivityTracking"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             GroupName="subMenuGroup"
             Command="{Binding ShowMemberActivityTrackingViewCommand}"
             Visibility="{Binding IsChecked,ElementName=btnFacilityAdminTools,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Member Activity Tracking" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="btnAirportTrafficLevels"
             Style="{StaticResource menuSubButton}"
             Tag="{StaticResource btnBackground1}"
             Command="{Binding ShowAirportTrafficLevelsViewCommand}"
             GroupName="subMenuGroup"
             Visibility="{Binding IsChecked,ElementName=btnFacilityAdminTools,Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightLeft" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Airport Traffic Levels" Style="{StaticResource menuSubButtonText}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Grid.Column="1" x:Name="ActiveItem"/>
    </Grid>
</Window>
